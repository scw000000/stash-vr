<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} — stash-vr browse</title>
<style>
:root { color-scheme: dark; }
* { box-sizing: border-box; }
body { margin: 0; font-family: system-ui, sans-serif; background: #111; color: #eee; }
.wrap { max-width: 800px; margin: 0 auto; padding: 16px; }
.back { color: #9cf; text-decoration: none; display: inline-block; margin-bottom: 12px; }
.errbanner { background: #5a1a1a; padding: 8px 12px; border-radius: 4px; margin-bottom: 12px; }
.thumb { width: 100%; max-height: 480px; object-fit: contain; background: #000; border-radius: 6px; margin-bottom: 16px; }
h1 { font-size: 1.4rem; margin: 0 0 8px 0; }
.meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 24px; }
.meta .meta-text { color: #aaa; }
a.chip { color: #ddd; text-decoration: none; }
a.chip:hover { background: #3a3a3a; }
.chip a { color: inherit; text-decoration: none; }
.chip a:hover { color: #fff; }
.section { margin-bottom: 20px; }
.section h2 { font-size: 0.85rem; text-transform: uppercase; color: #888; margin: 0 0 8px 0; letter-spacing: 0.05em; }

.stars { display: inline-flex; gap: 4px; align-items: center; }
.stars-fill { display: inline-flex; flex-direction: row-reverse; gap: 4px; }
.stars button { background: transparent; border: none; font-size: 1.5rem; color: #555; cursor: pointer; padding: 0 2px; }
.stars-fill button:hover,
.stars-fill button:hover ~ button,
.stars-fill button.on,
.stars-fill button.on ~ button { color: #f7b500; }
.stars button.clear { font-size: 1rem; margin-left: 8px; color: #888; }
.stars button.clear:hover { color: #f55; }

.fav button { background: transparent; border: 1px solid #555; color: #ccc; padding: 6px 12px; border-radius: 4px; cursor: pointer; }
.fav button.on { background: #c11; border-color: #c11; color: #fff; }

.tags { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.chip { background: #2a2a2a; padding: 4px 4px 4px 10px; border-radius: 999px; display: inline-flex; align-items: center; gap: 4px; }
.chip-perf { background: #2a2a2a; }
.chip-studio { background: #2a2a3a; }
.chip button { background: transparent; border: none; color: #aaa; cursor: pointer; padding: 2px 6px; }
.chip button:hover { color: #f55; }
.addtag { display: inline-flex; gap: 4px; }
.addtag input { background: #1a1a1a; border: 1px solid #333; color: #eee; padding: 4px 8px; border-radius: 4px; }
.addtag button { background: #2c5282; border: none; color: #fff; padding: 4px 12px; border-radius: 4px; cursor: pointer; }

.ocount { display: inline-flex; align-items: center; gap: 8px; }
.ocount button { background: #2a2a2a; border: none; color: #eee; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 1.1rem; }
.ocount span { font-size: 1.1rem; min-width: 24px; text-align: center; }

.org button { background: transparent; border: 1px solid #555; color: #ccc; padding: 6px 12px; border-radius: 4px; cursor: pointer; }
.org button.on { background: #2c5282; border-color: #2c5282; color: #fff; }

.player { width: 100%; max-height: 70vh; background: #000; border-radius: 6px; margin-bottom: 16px; }
.btn-vr { display: block; width: 100%; padding: 14px; margin-bottom: 24px; background: #2c5282; color: #fff; border: none; border-radius: 6px; font-size: 1.05rem; font-weight: 600; cursor: pointer; }
.btn-vr:hover { background: #3776c2; }
</style>
</head>
<body>
<div class="wrap">
<a class="back" href="{{.BackURL}}">← Back</a>
<div class="errbanner" id="errbanner" hidden></div>
{{if .DirectStreamURL}}
<video id="sceneVideo" class="player" controls playsinline autoplay preload="metadata" src="{{.DirectStreamURL}}"{{if .ThumbnailURL}} poster="{{.ThumbnailURL}}"{{end}}></video>
{{else if .ThumbnailURL}}
<img class="thumb" src="{{.ThumbnailURL}}" alt="">
{{end}}

{{if .DirectStreamURL}}
<button id="enterVR" class="btn-vr" type="button">{{if .Projection.Geometry}}▥ Enter VR{{else}}▥ Watch on virtual screen{{end}}</button>

<a-scene id="vrScene" embedded style="display:none" vr-mode-ui="enabled: true" loading-screen="enabled: false" background="color: #111" data-stereo="{{.Projection.Stereo}}" data-geometry="{{.Projection.Geometry}}" data-fov="{{.Projection.FOV}}">
  <a-entity camera position="0 1.6 0"></a-entity>
  <!--
    All four render entities are always emitted. JS toggles visibility
    based on the active Projection. The initial visibility below
    matches the server-side detected Projection so the page renders
    correctly before any JS runs.
  -->
  <a-entity id="vrSphere180"
            visible="{{if and (eq .Projection.Geometry "equirectangular") (eq .Projection.FOV 180)}}true{{else}}false{{end}}"
            geometry="primitive:sphere;radius:100;phiStart:180;phiLength:180;thetaLength:180;segmentsWidth:64;segmentsHeight:64"></a-entity>
  <a-entity id="vrSphere360"
            visible="{{if and (eq .Projection.Geometry "equirectangular") (eq .Projection.FOV 360)}}true{{else}}false{{end}}"
            geometry="primitive:sphere;radius:100;segmentsWidth:64;segmentsHeight:64"></a-entity>
  <a-entity id="vrFisheye"
            visible="{{if eq .Projection.Geometry "fisheye"}}true{{else}}false{{end}}"
            data-fov="{{if eq .Projection.Geometry "fisheye"}}{{.Projection.FOV}}{{else}}180{{end}}"
            data-cant="{{.Projection.Cant}}"
            geometry="primitive:sphere;radius:100;segmentsWidth:64;segmentsHeight:64"></a-entity>
  <a-entity id="vrFlat"
            visible="{{if not .Projection.Geometry}}true{{else}}false{{end}}"
            geometry="primitive:plane;width:4;height:2.25"
            position="0 1.6 -3"></a-entity>

  <!-- All in-VR control surfaces (playback panel, Format picker, help panel)
       live under this wrapper so M3c can toggle them as a unit. Hidden by
       default; trigger summons. -->
  <a-entity id="vrControlsRoot" visible="false">

  <!-- In-VR playback controls. Positioned below eye-line, tilted toward user. -->
  <a-entity id="vrControls" position="0 0.4 -1.5" rotation="-30 0 0">
    <a-plane width="3.2" height="0.7" color="#000" material="opacity:0.65"></a-plane>

    <!-- Row 1 (top): title left, time right, tiny DBG button at far
         right (toggles the M4c diagnostic overlay; default off). -->
    <a-text id="vrTitle" value="{{.Title}}" align="left" color="#fff" width="3.0"
            position="-1.4 0.30 0.01" wrap-count="36"></a-text>
    <a-text id="vrTime" value="0:00 / 0:00" align="right" color="#fff" width="3.0"
            position="1.30 0.30 0.01"></a-text>
    <a-entity class="vr-btn" data-action="toggle-debug-overlay" position="1.50 0.30 0.01"
              geometry="primitive:plane;width:0.18;height:0.10"
              material="color:#444;opacity:0.85">
      <a-text value="DBG" align="center" color="#ff0" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>

    <!-- Row 2: scrub bar (drag thumb to seek; click bar to seek; click marker dot to jump). -->
    <a-entity id="vrScrubBar" position="0 0.05 0.01">
      <!-- Transparent hit plane: matches thumb height so clicks register
           anywhere within the thumb's vertical span, not only the thin bar. -->
      <a-plane class="vr-scrub-bg vr-btn" data-action="scrub-bg" width="2.8" height="0.10"
               material="opacity:0;transparent:true" position="0 0 0.0001"></a-plane>
      <!-- Visual bar: thin grey line, no slider class so raycast passes through. -->
      <a-plane width="2.8" height="0.04" color="#444" material="opacity:0.95"
               position="0 0 0.0002"></a-plane>
      <a-plane id="vrScrubFill" width="0.001" height="0.04" color="#3776c2"
               material="opacity:0.95" position="-1.4 0 0.001"></a-plane>
      <a-entity id="vrScrubMarkers"></a-entity>
      <a-entity id="vrScrubThumb" class="vr-btn vr-scrub" data-action="scrub"
                geometry="primitive:plane;width:0.05;height:0.10"
                material="color:#fff" position="-1.4 0 0.005"></a-entity>
    </a-entity>

    <!-- Row 3 (bottom): volume widget on the left, then 7 buttons. -->
    <!-- Volume icon (mute toggle) -->
    <a-entity class="vr-btn" data-action="mute" position="-1.40 -0.20 0.01"
              geometry="primitive:plane;width:0.18;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-image id="vrMuteIconOn"  width="0.14" height="0.14" position="0 0 0.005"></a-image>
      <a-image id="vrMuteIconOff" width="0.14" height="0.14" position="0 0 0.005" visible="false"></a-image>
    </a-entity>
    <!-- Volume slider track + fill + thumb -->
    <a-entity id="vrVolumeSlider" position="-0.96 -0.20 0.01">
      <a-plane class="vr-vol-track vr-btn" data-action="vol-track" width="0.40" height="0.04"
               color="#444" material="opacity:0.95"></a-plane>
      <a-plane id="vrVolumeFill" width="0.40" height="0.04" color="#3776c2"
               material="opacity:0.95" position="0 0 0.001"></a-plane>
      <a-entity id="vrVolumeThumb" class="vr-btn vr-vol-thumb" data-action="vol-track"
                geometry="primitive:plane;width:0.04;height:0.10"
                material="color:#fff" position="0.20 0 0.005"></a-entity>
    </a-entity>

    <!-- 8 buttons to the right of the volume widget (Browse added in M4c). -->
    <a-entity class="vr-btn" data-action="cc" id="vrCCBtn" position="-0.55 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95"
              visible="{{if .Captions}}true{{else}}false{{end}}">
      <a-text value="CC" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn" data-action="playpause" position="-0.25 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-image id="vrPlayIcon"  width="0.14" height="0.14" position="0 0 0.005"></a-image>
      <a-image id="vrPauseIcon" width="0.14" height="0.14" position="0 0 0.005" visible="false"></a-image>
    </a-entity>
    <a-entity class="vr-btn" data-action="speed" position="0.05 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-text id="vrSpeedLabel" value="1.0x" align="center" color="#fff" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn" data-action="loop" id="vrLoopBtn" position="0.35 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-image id="vrLoopIcon" width="0.14" height="0.14" position="0 0 0.005"></a-image>
    </a-entity>
    <a-entity class="vr-btn" data-action="browse" position="0.65 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-text value="Browse" align="center" color="#fff" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn" data-action="format" position="0.95 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-image id="vrFormatIcon" width="0.16" height="0.14" position="0 0 0.005"></a-image>
    </a-entity>
    <a-entity class="vr-btn" data-action="help" position="1.25 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-text value="?" align="center" color="#fff" width="3.5" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn" data-action="exit" position="1.55 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#a01010;opacity:0.95">
      <a-image id="vrExitIcon" width="0.14" height="0.14" position="0 0 0.005"></a-image>
    </a-entity>

  </a-entity>

  <!--
    In-VR projection picker. Hidden by default; toggled by the Format
    button on the playback panel. Three rows (Type, Degree, Stereo)
    of mutually-exclusive buttons + an Auto button that re-detects.
    Each preset button has data-pick-row and data-pick-value attrs that
    the JS tap handler reads to update state.
  -->
  <a-entity id="vrFormatPicker" position="0 1.4 -1.5" rotation="-15 0 0" visible="false">
    <a-plane width="2.4" height="1.2" color="#000" material="opacity:0.7"></a-plane>
    <a-text value="Format" align="left" color="#fff" width="3.5" position="-1.1 0.5 0.01"></a-text>

    <!-- Row 1: Type -->
    <a-text value="Type"   align="right" color="#aaa" width="2" position="-0.85 0.28 0.01"></a-text>
    <a-entity class="vr-btn picker-btn" data-pick-row="type" data-pick-value="Normal"  position="-0.55 0.28 0.01"
              geometry="primitive:plane;width:0.45;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="Normal"  align="center" color="#fff" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn" data-pick-row="type" data-pick-value="FishEye" position="0.0 0.28 0.01"
              geometry="primitive:plane;width:0.45;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="FishEye" align="center" color="#fff" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>

    <!-- Row 2: Degree -->
    <a-text value="Degree" align="right" color="#aaa" width="2" position="-0.85 0.04 0.01"></a-text>
    <a-entity class="vr-btn picker-btn" data-pick-row="degree" data-pick-value="Cinema" position="-0.55 0.04 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="Cinema" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn" data-pick-row="degree" data-pick-value="180"    position="-0.18 0.04 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="180" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn" data-pick-row="degree" data-pick-value="200"    position="0.19 0.04 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="200" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn" data-pick-row="degree" data-pick-value="360"    position="0.56 0.04 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="360" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>

    <!-- Row 3: Stereo -->
    <a-text value="Stereo" align="right" color="#aaa" width="2" position="-0.85 -0.20 0.01"></a-text>
    <a-entity class="vr-btn picker-btn" data-pick-row="stereo" data-pick-value="2D"  position="-0.55 -0.20 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="2D" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn" data-pick-row="stereo" data-pick-value="SBS" position="-0.18 -0.20 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="SBS" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn" data-pick-row="stereo" data-pick-value="TB"  position="0.19 -0.20 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="TB" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>

    <!-- Auto -->
    <a-entity class="vr-btn picker-btn" data-pick-row="auto" data-pick-value="auto" position="0.0 -0.46 0.01"
              geometry="primitive:plane;width:0.80;height:0.16" material="color:#3776c2;opacity:0.95">
      <a-text value="Auto (re-detect)" align="center" color="#fff" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>
  </a-entity>

  <!-- M3c help cheatsheet. Hidden by default; toggled by the "?" button. -->
  <a-entity id="vrHelpPanel" position="0 1.4 -1.5" rotation="-15 0 0" visible="false">
    <a-plane width="2.4" height="1.5" color="#000" material="opacity:0.75"></a-plane>
    <a-text value="Controls" align="left" color="#fff" width="3.5" position="-1.1 0.65 0.01"></a-text>

    <a-text value="Trigger (no hit) · single"  align="left" color="#aaa" width="3" position="-1.1  0.42 0.01"></a-text>
    <a-text value="Toggle panel"               align="left" color="#fff" width="3" position=" 0.05 0.42 0.01"></a-text>
    <a-text value="Trigger · double"           align="left" color="#aaa" width="3" position="-1.1  0.30 0.01"></a-text>
    <a-text value="Play / Pause"               align="left" color="#fff" width="3" position=" 0.05 0.30 0.01"></a-text>
    <a-text value="Trigger · hold + move"      align="left" color="#aaa" width="3" position="-1.1  0.18 0.01"></a-text>
    <a-text value="Drag screen"                align="left" color="#fff" width="3" position=" 0.05 0.18 0.01"></a-text>
    <a-text value="A or X · single / double"   align="left" color="#aaa" width="3" position="-1.1  0.06 0.01"></a-text>
    <a-text value="Toggle panel / Play-Pause"  align="left" color="#fff" width="3" position=" 0.05 0.06 0.01"></a-text>
    <a-text value="Thumbstick L / R"           align="left" color="#aaa" width="3" position="-1.1 -0.06 0.01"></a-text>
    <a-text value="-10s / +10s"                align="left" color="#fff" width="3" position=" 0.05 -0.06 0.01"></a-text>
    <a-text value="Thumbstick U / D"           align="left" color="#aaa" width="3" position="-1.1 -0.18 0.01"></a-text>
    <a-text value="Zoom in / out"              align="left" color="#fff" width="3" position=" 0.05 -0.18 0.01"></a-text>
    <a-text value="B or Y · short"             align="left" color="#aaa" width="3" position="-1.1 -0.30 0.01"></a-text>
    <a-text value="Reset screen / Recenter"    align="left" color="#fff" width="3" position=" 0.05 -0.30 0.01"></a-text>
    <a-text value="B or Y · long-press"        align="left" color="#aaa" width="3" position="-1.1 -0.42 0.01"></a-text>
    <a-text value="Full recenter"              align="left" color="#fff" width="3" position=" 0.05 -0.42 0.01"></a-text>

    <a-entity class="vr-btn" data-action="help-close" position="1.05 0.65 0.01"
              geometry="primitive:plane;width:0.18;height:0.18" material="color:#a01010;opacity:0.95">
      <a-text value="X" align="center" color="#fff" width="3.5" position="0 0 0.005"></a-text>
    </a-entity>
  </a-entity>

  <!-- Subtitle language picker. Hidden by default; CC button toggles. JS at
       picker-render time populates the buttons row and resizes the
       background plane to fit. -->
  <a-entity id="vrSubtitlePicker" position="0 1.4 -1.5" rotation="-15 0 0" visible="false">
    <a-plane id="vrSubtitlePickerBg" width="2.0" height="0.4" color="#000" material="opacity:0.7"></a-plane>
    <a-text id="vrSubtitlePickerTitle" value="Subtitles" align="left" color="#fff" width="3" position="-0.85 0.13 0.01"></a-text>
    <a-entity id="vrSubtitlePickerButtons" position="0 0 0.01"></a-entity>
  </a-entity>

  <!-- M4c browse panel. Hidden by default; toggled by the Browse button on
       the playback panel. Top strip is wired in Task 3 (this task);
       tile grid + load-more sentinel are populated by Tasks 4-5. -->
  <a-entity id="vrBrowsePanel" position="0 1.4 -2.5" rotation="-15 0 0" visible="false">
    <!-- Curved bg: partial-arc cylinder. Hub at panel-local z=3.02 (HUB_Z),
         shared with the tile covers (R=3.0) and top-strip buttons (R=2.97).
         BG R=3.02 → bg surface lands at panel-local z=0 (the panel back),
         so tiles (z=0.02) and buttons (z=0.05) sit clearly in front and
         don't z-fight. 85° arc covers the 3.4m chord of tile content
         (~64.93°) plus ~10° margin per side. -->
    <a-cylinder class="vr-grid-bg vr-btn" data-action="grid-bg"
                radius="3.02"
                height="2.4"
                position="0 0 3.02"
                theta-start="137.5"
                theta-length="85"
                open-ended="true"
                material="shader: flat; side: double; color: #000; opacity: 0.95">
    </a-cylinder>

    <!-- Top strip — five curved buttons sharing the panel hub. The wrapper
         is positioned at panel-local (0, 1.0, 3.02) so the cylinder hub for
         the buttons sits at the same hub as bg/tiles. Each button is its
         own a-cylinder primitive at default position (0,0,0) inside this
         wrapper, with its own theta-start / theta-length spanning its arc.
         BTN_R=2.97 → button surface at panel-local z=0.05 (in front of
         tiles at 0.02, in front of bg at 0). Text labels are positioned
         at the surface point of the button's angular center, with a
         matching yaw rotation so the label faces the user along the arc.

         Angular layout (mirroring the original flat x_center positions):
         search:  x=-1.0,  w=1.2  →  arc center at θ=-19.7°, span 23.1°
         filters: x=-0.10, w=0.45 →  arc center at θ= -1.93°, span 8.68°
         clear:   x= 0.40, w=0.45 →  arc center at θ=  7.74°, span 8.68°
         cols:    x= 0.95, w=0.40 →  arc center at θ= 18.65°, span 7.71°
         close:   x= 1.45, w=0.20 →  arc center at θ= 29.32°, span 3.86°
         A-Frame θ = 180 - our_θ. theta-start = aFrameCenter - span/2. -->
    <a-entity id="vrBrowseTopStrip" position="0 1.0 3.02">
      <!-- Search bar bg — also serves as a click target that focuses the
           in-VR search input (data-action="search-focus"). Text label is
           injected per-character on a curve at runtime by curveLabelInto(). -->
      <a-cylinder class="vr-search-bg vr-btn" data-action="search-focus"
                  data-label="Search…" data-label-color="#888" data-label-align="left"
                  radius="2.97" height="0.16" open-ended="true"
                  theta-start="188.15" theta-length="23.10"
                  material="shader: flat; color: #222; opacity: 0.9; side: double">
      </a-cylinder>
      <a-cylinder class="vr-btn" data-action="filters"
                  data-label="Filters ▾" data-label-color="#fff" data-label-align="center"
                  radius="2.97" height="0.16" open-ended="true"
                  theta-start="177.59" theta-length="8.68"
                  material="shader: flat; color: #2c5282; opacity: 0.95; side: double">
      </a-cylinder>
      <a-cylinder class="vr-btn" data-action="filters-clear"
                  data-label="Clear all" data-label-color="#fff" data-label-align="center"
                  radius="2.97" height="0.16" open-ended="true"
                  theta-start="167.92" theta-length="8.68"
                  material="shader: flat; color: #2c5282; opacity: 0.95; side: double">
      </a-cylinder>
      <a-cylinder class="vr-btn" data-action="cols-cycle" id="vrColsBtn"
                  data-label="Cols: 4" data-label-color="#fff" data-label-align="center"
                  radius="2.97" height="0.16" open-ended="true"
                  theta-start="157.49" theta-length="7.71"
                  material="shader: flat; color: #2c5282; opacity: 0.95; side: double">
      </a-cylinder>
      <a-cylinder class="vr-btn" data-action="browse-close"
                  data-label="✕" data-label-color="#fff" data-label-align="center"
                  radius="2.97" height="0.16" open-ended="true"
                  theta-start="148.75" theta-length="3.86"
                  material="shader: flat; color: #a01010; opacity: 0.95; side: double">
      </a-cylinder>
    </a-entity>

    <!-- Tile grid root (Task 4 populates). -->
    <a-entity id="vrBrowseTiles"></a-entity>

    <!-- "Loading more..." sentinel (Task 5 toggles). -->
    <a-text id="vrBrowseLoadMore" value="" align="center" color="#888" width="3"
            position="0 -1.05 0.01" visible="false"></a-text>

  </a-entity>

  </a-entity><!-- /vrControlsRoot -->

  <!-- Generic in-VR debug overlay. Hidden by default; toggled by the
       DBG button on the playback panel. Lives at scene root (not inside
       vrControlsRoot) so it stays visible even after the playback UI
       is hidden, which is the point of a debug surface. World position
       1.5m in front of user, slightly below eye level. Yellow text on a
       black backdrop placed behind (z=-0.01) so semi-transparent
       rendering doesn't occlude the text. Updated each frame from the
       m4c-browse-tick component (gated on visibility). -->
  <a-entity id="vrDebugOverlay" position="0 1.0 -1.5" visible="false">
    <a-plane width="2.0" height="0.30" color="#000" material="shader: flat; opacity: 0.7"
             position="0 0 -0.01"></a-plane>
    <a-text id="vrDebugOverlayText" value="DEBUG OVERLAY READY" align="center" color="#ffff00"
            width="2.5" wrap-count="30" position="0 0 0"></a-text>
  </a-entity>

  <!-- Laser controllers for raycast-clicking the panel buttons. -->
  <!-- Initial visible attribute would be overridden by tracked-controls'
       autoHide=true on every tick once a controller connects, so we don't
       set visible=false here. Hide the LINE via showLine: false and
       neutralize raycast hits via enabled: false; the controller model
       remains visible, matching SKYBOX. setPanelVisible toggles these
       two raycaster props (not the entity's visible). -->
  <a-entity id="vrLaserRight" laser-controls="hand: right" raycaster="objects: .vr-btn; far: 5; enabled: false; showLine: false"></a-entity>
  <a-entity id="vrLaserLeft"  laser-controls="hand: left"  raycaster="objects: .vr-btn; far: 5; enabled: false; showLine: false"></a-entity>

  <!-- M3c controller-mapping component. Hosts the trigger state machine,
       gamepad polling, and B/Y long-press timer. Emits semantic events
       on <a-scene>; the inline IIFE applies them. -->
  <a-entity m3c-controls></a-entity>

  <!-- Subtitle render plane. Starts as a child of <a-scene>; JS reparents
       it to vrFlat (cinema) or scene.camera (immersive) when a cue is
       active. Hidden until a cue activates. -->
  <a-entity id="vrSubtitlePlane" visible="false">
    <a-plane width="1.6" height="0.18" color="#000" material="opacity:0.5"></a-plane>
    <a-text id="vrSubtitleText" value="" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
  </a-entity>
</a-scene>

<script src="/vendor/aframe.min.js"></script>
<script src="/m3c-controls.js"></script>
<script>
  (function() {
    const btn          = document.getElementById('enterVR');
    const scene        = document.getElementById('vrScene');
    const wrap         = document.querySelector('.wrap');
    const video        = document.getElementById('sceneVideo');
    const picker       = document.getElementById('vrFormatPicker');
    if (!btn || !scene || !wrap || !video) return;

    // Three.js's Raycaster does NOT skip invisible objects by default —
    // it only checks layers. So a panel with visible=false (e.g. the
    // format picker) still has its descendant .vr-btn meshes intercept
    // the laser ray, blocking it from reaching the visible browse panel
    // behind. Patch intersectObjects to filter out any hit whose object
    // (or any ancestor) has visible=false. This affects A-Frame's laser
    // line truncation and the `intersections` array all consumers read.
    (function patchRaycasterVisibility() {
      const TR = AFRAME.THREE.Raycaster.prototype;
      if (TR._svPatched) return;
      const orig = TR.intersectObjects;
      function isFullyVisible(obj) {
        for (let n = obj; n; n = n.parent) if (!n.visible) return false;
        return true;
      }
      TR.intersectObjects = function (objects, recursive, target) {
        const hits = orig.call(this, objects, recursive, target);
        // Sorted by distance already; filter in place to preserve order.
        for (let i = hits.length - 1; i >= 0; i--) {
          if (!isFullyVisible(hits[i].object)) hits.splice(i, 1);
        }
        return hits;
      };
      TR._svPatched = true;
    })();

    // In-VR control-panel icons. A-Frame's <a-text> uses an MSDF font that
    // doesn't include emoji codepoints, so 🔊/🔇/🔁 render blank in-headset.
    // Inline SVG-as-data-URI textures on <a-image> planes work because
    // Three.js's TextureLoader uses Image() which loads SVG natively in
    // modern browsers (incl. Meta Browser). Toggle pairs (mute, play/pause)
    // overlap two planes and flip their `visible` attr.
    const ICONS = (function() {
      const svg = (body) => 'data:image/svg+xml;utf8,' + encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">' + body + '</svg>'
      );
      return {
        speakerOn:  svg('<path fill="white" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>'),
        speakerOff: svg('<path fill="white" d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zM3 9v6h4l5 5V4L7 9H3zM21 19.5L4.5 3 3 4.5 19.5 21z"/>'),
        play:       svg('<polygon fill="white" points="6,4 20,12 6,20"/>'),
        pause:      svg('<rect fill="white" x="6" y="4" width="4" height="16"/><rect fill="white" x="14" y="4" width="4" height="16"/>'),
        loop:       svg('<path fill="white" d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>'),
        format:     svg('<rect fill="none" stroke="white" stroke-width="2" x="3" y="5" width="18" height="14" rx="2"/><line stroke="white" stroke-width="2" x1="12" y1="5" x2="12" y2="19"/>'),
        exit:       svg('<line stroke="white" stroke-width="3" stroke-linecap="round" x1="5" y1="5" x2="19" y2="19"/><line stroke="white" stroke-width="3" stroke-linecap="round" x1="19" y1="5" x2="5" y2="19"/>'),
      };
    })();

    function applyIcon(id, src) {
      const el = document.getElementById(id);
      if (el) el.setAttribute('src', src);
    }
    function applyAllIcons() {
      applyIcon('vrMuteIconOn', ICONS.speakerOn);
      applyIcon('vrMuteIconOff', ICONS.speakerOff);
      applyIcon('vrPlayIcon', ICONS.play);
      applyIcon('vrPauseIcon', ICONS.pause);
      applyIcon('vrLoopIcon', ICONS.loop);
      applyIcon('vrFormatIcon', ICONS.format);
      applyIcon('vrExitIcon', ICONS.exit);
    }
    function updatePlayPauseIcon() {
      const play = document.getElementById('vrPlayIcon');
      const pause = document.getElementById('vrPauseIcon');
      if (play) play.setAttribute('visible', video.paused);
      if (pause) pause.setAttribute('visible', !video.paused);
    }
    // Apply after a-scene is ready so the entities exist; also try
    // immediately in case `loaded` already fired during script eval.
    scene.addEventListener('loaded', applyAllIcons);
    scene.addEventListener('loaded', updatePlayPauseIcon);
    applyAllIcons();
    video.addEventListener('play', updatePlayPauseIcon);
    video.addEventListener('pause', updatePlayPauseIcon);

    // Recover from WebGL context loss. Quest 3 drops the context after
    // ~30s sleep; without preventDefault the browser won't restore it,
    // and the video texture stays frozen even after re-entering VR
    // (audio keeps playing because that pipeline is independent).
    function refreshVideoTexture() {
      if (!video || video.readyState < 2) return;
      const wasPaused = video.paused;
      const t = isFinite(video.currentTime) ? video.currentTime : 0;
      try {
        video.pause();
        // Re-assigning currentTime forces the decoder to re-emit a
        // frame, which the next render tick uploads to the GL texture.
        video.currentTime = t;
        if (!wasPaused) {
          const p = video.play();
          if (p && p.catch) p.catch(err => console.warn('stash-vr: video resume failed', err));
        }
      } catch (e) {
        console.warn('stash-vr: video texture refresh failed', e);
      }
    }

    scene.addEventListener('loaded', function() {
      const canvas = scene.canvas;
      if (!canvas) return;
      canvas.addEventListener('webglcontextlost', function(e) {
        console.warn('stash-vr: WebGL context lost — requesting restore');
        e.preventDefault(); // critical: without this the browser doesn't restore
      }, false);
      canvas.addEventListener('webglcontextrestored', function() {
        console.warn('stash-vr: WebGL context restored — refreshing video texture');
        refreshVideoTexture();
      }, false);
    });

    // Page-visibility backstop. Some sleep scenarios don't fully drop the
    // GL context but still stall the decoder pipeline; refreshing on
    // visibility return covers those cases cheaply.
    document.addEventListener('visibilitychange', function() {
      if (!document.hidden) refreshVideoTexture();
    });

    // Entering VR fresh after a stall benefits from the same refresh.
    scene.addEventListener('enter-vr', refreshVideoTexture);

    // Bind material + texture programmatically. aframe-stereo-component@1.4.0
    // doesn't work on A-Frame 1.7 (reads material as raw string at init), so
    // stereo is handled here directly.
    //
    // Single-video architecture: sceneVideo (the on-page <video>) is the
    // sole media element. THREE.VideoTexture reads frames from it; the
    // element also produces audio. One pipeline = no drift between audio
    // and picture, and the texture is non-empty on Enter VR because
    // sceneVideo will already be playing (or about to play, started by the
    // Enter VR click which is a user gesture).
    //
    // Three rendering paths, picked by the server based on tags + filename:
    //   1. Equirectangular sphere (DOME 180°, SPHERE 360°). Standard
    //      MeshBasicMaterial. Per-eye UV swap on tex.offset/repeat handles
    //      SBS/TB/mono via the scene's data-stereo attribute.
    //   2. Fisheye sphere (FISHEYE 180°, MKX200 200°, RF52). Custom
    //      ShaderMaterial: fragment shader maps direction → fisheye (u,v),
    //      eye offsets applied via uniforms set per-eye in onBeforeRender.
    //   3. Flat plane (no VR detected). Plain MeshBasicMaterial, no
    //      stereo, sits in front of the user as a virtual cinema screen.
    //
    // For paths 1 and 2 the half-sphere / full-sphere geometry uses
    // phiStart/phiLength values that face -Z (camera forward). WebXR
    // renders the scene twice per frame (once per eye); Three.js calls
    // mesh.onBeforeRender per render call with the active camera, which
    // is how we know which eye to configure UV/offset uniforms for.
    // Shared VideoTexture instance reused across all bind functions.
    // sphere materials mutate offset/repeat per eye; fisheye shader
    // ignores offset/repeat and applies its own UV math via uniforms,
    // so sharing is safe.
    let sharedTex = null;
    function getSharedTex() {
      if (!sharedTex) {
        sharedTex = new AFRAME.THREE.VideoTexture(video);
        if (AFRAME.THREE.SRGBColorSpace) sharedTex.colorSpace = AFRAME.THREE.SRGBColorSpace;
      }
      return sharedTex;
    }
    function bindSphereMesh(id) {
      const el = document.getElementById(id);
      if (!el || !window.AFRAME || !AFRAME.THREE) return;
      const mesh = el.getObject3D('mesh');
      if (!mesh || mesh.userData.boundVR) return;
      const tex = getSharedTex();
      mesh.material = new AFRAME.THREE.MeshBasicMaterial({
        map: tex,
        side: AFRAME.THREE.BackSide
      });
      mesh.onBeforeRender = function(renderer, sceneObj, cam) {
        const xr = renderer.xr;
        const stereo = scene.dataset.stereo || '';
        // Sphere geometry has phiStart=π, phiLength=π so its UV u=0 is at
        // world +X (user's right) and u=1 at -X (user's left). The standard
        // VR180 convention is the opposite: video left edge = user's left.
        // We compensate here with a horizontal U-flip via negative repeat.x
        // and offset.x = (right-edge-of-eye-half).
        // Out of XR or mono content: still apply the U-flip.
        if (!xr || !xr.isPresenting || !stereo) {
          tex.offset.set(1, 0);
          tex.repeat.set(-1, 1);
          return;
        }
        const xrCam = xr.getCamera();
        if (!xrCam || !xrCam.cameras || xrCam.cameras.length < 2) return;
        const isLeft = cam === xrCam.cameras[0];
        const isRight = cam === xrCam.cameras[1];
        if (!isLeft && !isRight) return;
        if (stereo === 'sbs') {
          // Left eye sees tex u in [0, 0.5] flipped: geom u=0 → tex u=0.5; geom u=1 → tex u=0.
          // Right eye sees tex u in [0.5, 1] flipped: geom u=0 → tex u=1; geom u=1 → tex u=0.5.
          tex.repeat.set(-0.5, 1);
          tex.offset.set(isLeft ? 0.5 : 1, 0);
        } else if (stereo === 'tb') {
          // U-flipped, vertical halves per eye.
          tex.repeat.set(-1, 0.5);
          tex.offset.set(1, isLeft ? 0 : 0.5);
        } else {
          tex.offset.set(1, 0);
          tex.repeat.set(-1, 1);
        }
      };
      mesh.userData.boundVR = true;
    }
    function applySphere() {
      bindSphereMesh('vrSphere180');
      bindSphereMesh('vrSphere360');
    }
    function applyFlat() {
      const el = document.getElementById('vrFlat');
      if (!el || !window.AFRAME || !AFRAME.THREE) return;
      const mesh = el.getObject3D('mesh');
      if (!mesh || mesh.userData.boundVR) return;
      mesh.material = new AFRAME.THREE.MeshBasicMaterial({ map: getSharedTex() });
      mesh.userData.boundVR = true;
    }
    // applyFisheye binds a custom ShaderMaterial that converts each
    // fragment's direction (from sphere center) to a fisheye (u, v)
    // sample, then applies SBS/TB/mono eye offsets via uniforms set per
    // eye in onBeforeRender. uFOV in degrees comes from the entity's
    // data-fov attribute (180 / 190 / 200). Beyond the fisheye coverage,
    // fragments are discarded so the back of the sphere shows the
    // <a-scene> background color.
    function applyFisheye() {
      const el = document.getElementById('vrFisheye');
      if (!el || !window.AFRAME || !AFRAME.THREE) return;
      const mesh = el.getObject3D('mesh');
      if (!mesh || mesh.userData.boundVR) return;
      const tex = getSharedTex();
      const fov = parseFloat(el.dataset.fov || '180');
      const material = new AFRAME.THREE.ShaderMaterial({
        side: AFRAME.THREE.BackSide,
        uniforms: {
          uMap:       { value: tex },
          uFOV:       { value: fov },
          uCant:      { value: 0.0 },
          uEyeOffset: { value: new AFRAME.THREE.Vector2(0, 0) },
          uEyeRepeat: { value: new AFRAME.THREE.Vector2(1, 1) }
        },
        vertexShader: [
          'varying vec3 vDir;',
          'void main() {',
          '  vDir = normalize(position);',
          '  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);',
          '}'
        ].join('\n'),
        fragmentShader: [
          'precision highp float;',
          'varying vec3 vDir;',
          'uniform sampler2D uMap;',
          'uniform float uFOV;',
          'uniform float uCant;',
          'uniform vec2 uEyeOffset;',
          'uniform vec2 uEyeRepeat;',
          'void main() {',
          '  vec3 d = normalize(vDir);',
          '  float c = cos(uCant);',
          '  float s = sin(uCant);',
          '  vec3 dr = vec3(c * d.x + s * d.z, d.y, -s * d.x + c * d.z);',
          '  float theta = acos(-dr.z);',
          '  float maxTheta = radians(uFOV * 0.5);',
          '  if (theta > maxTheta) discard;',
          '  float r = (theta / maxTheta) * 0.5;',
          '  float phi = atan(dr.y, dr.x);',
          '  vec2 uv = vec2(0.5 + r * cos(phi), 0.5 + r * sin(phi));',
          '  uv = uv * uEyeRepeat + uEyeOffset;',
          '  gl_FragColor = texture2D(uMap, uv);',
          '}'
        ].join('\n')
      });
      mesh.material = material;
      mesh.onBeforeRender = function(renderer, sceneObj, cam) {
        const xr = renderer.xr;
        const stereo = scene.dataset.stereo || '';
        const u = material.uniforms;
        if (!xr || !xr.isPresenting || !stereo) {
          u.uEyeOffset.value.set(0, 0);
          u.uEyeRepeat.value.set(1, 1);
          u.uCant.value = 0;
          return;
        }
        const xrCam = xr.getCamera();
        if (!xrCam || !xrCam.cameras || xrCam.cameras.length < 2) return;
        const isLeft = cam === xrCam.cameras[0];
        const isRight = cam === xrCam.cameras[1];
        if (!isLeft && !isRight) return;
        const cantDeg = parseFloat(el.dataset.cant || '0');
        const cantRad = cantDeg * Math.PI / 180;
        u.uCant.value = isLeft ? -cantRad : cantRad;
        if (stereo === 'sbs') {
          u.uEyeRepeat.value.set(0.5, 1);
          u.uEyeOffset.value.set(isLeft ? 0 : 0.5, 0);
        } else if (stereo === 'tb') {
          u.uEyeRepeat.value.set(1, 0.5);
          u.uEyeOffset.value.set(0, isLeft ? 0 : 0.5);
        } else {
          u.uEyeOffset.value.set(0, 0);
          u.uEyeRepeat.value.set(1, 1);
          u.uCant.value = 0;
        }
      };
      mesh.userData.boundVR = true;
    }
    function applyAll() {
      applySphere();
      applyFlat();
      applyFisheye();
    }
    scene.addEventListener('loaded', applyAll);
    ['vrSphere180', 'vrSphere360', 'vrFlat', 'vrFisheye'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('object3dset', applyAll);
    });

    // Resolve the currently-rendering geometry entity. M3b ensures
    // exactly one of the four has visible=true at any time. Read the
    // Three.js object3D.visible property directly (unambiguous boolean)
    // instead of getAttribute (which returned strings before A-Frame
    // parsed and booleans after, leading to flaky resolution at handler
    // time).
    function activeGeometry() {
      const ids = ['vrSphere180', 'vrSphere360', 'vrFisheye', 'vrFlat'];
      for (let i = 0; i < ids.length; i++) {
        const el = document.getElementById(ids[i]);
        if (!el || !el.object3D) continue;
        if (el.object3D.visible) return el;
      }
      return null;
    }

    // M3c drag — translate the active geometry by per-tick controller
    // delta. The cinema plane is at finite distance (~3m) so 1:1 hand
    // motion looks right. Spheres are at radius 100 so a 30cm hand motion
    // shifts the center by 0.3% of the sphere — invisible. Scale up for
    // the spheres so motion is perceptible.
    scene.addEventListener('m3c:drag-move', function(e) {
      const el = activeGeometry();
      if (!el || !el.object3D) return;
      const isImmersive = el.id !== 'vrFlat';
      const k = isImmersive ? 50 : 1;
      el.object3D.position.x += e.detail.dx * k;
      el.object3D.position.y += e.detail.dy * k;
      el.object3D.position.z += e.detail.dz * k;
      if (el.id === 'vrFlat') {
        const cam = scene.camera;
        if (cam) el.object3D.lookAt(cam.position);
      }
    });
    scene.addEventListener('m3c:panel-toggle', function() {
      setPanelVisible(!isPanelVisible());
    });
    scene.addEventListener('m3c:play-pause', function() {
      if (video.paused) {
        const p = video.play();
        if (p && p.catch) p.catch(err => console.warn('stash-vr: video play failed', err));
      } else {
        video.pause();
      }
    });

    // Reset the active geometry to its template-default position+scale.
    // Defaults are static per the HTML: vrFlat at (0,1.6,-3) scale 1,
    // all others at (0,0,0) scale 1.
    function resetGeometry() {
      const el = activeGeometry();
      if (!el || !el.object3D) return;
      if (el.id === 'vrFlat') {
        el.object3D.position.set(0, 1.6, -3);
      } else {
        el.object3D.position.set(0, 0, 0);
      }
      el.object3D.scale.set(1, 1, 1);
      const cam = scene.camera;
      if (el.id === 'vrFlat' && cam) el.object3D.lookAt(cam.position);
    }

    // WebXR yaw recenter: capture current camera yaw, build inverse-yaw
    // offset, swap reference space. Pitch/roll left to the headset (it
    // reports them correctly).
    function recenterYaw() {
      const r = scene.renderer;
      if (!r || !r.xr || !r.xr.isPresenting) return;
      const cam = r.xr.getCamera();
      if (!cam) return;
      // Extract user's yaw from camera matrixWorld.
      // Cols 8,9,10 are camera's local +Z (= -forward). yaw measured from
      // canonical -Z forward = atan2(forward.x, -forward.z) = atan2(-e[8], e[10]).
      const e = cam.matrixWorld.elements;
      const yaw = Math.atan2(-e[8], e[10]);
      const el = activeGeometry();
      if (!el || !el.object3D) return;
      if (el.id === 'vrFlat') {
        // Cinema: yaw recenter is a no-op; resetGeometry's lookAt(camera)
        // handles plane orientation. Skipping here keeps the cinema reset
        // path simple.
        return;
      }
      // Immersive: rotate the active geometry by -yaw about Y so its local
      // -Z direction (where texture center is for spheres / fisheye) aligns
      // with the user's current gaze direction. We do NOT change the WebXR
      // reference space — that desyncs A-Frame's tracked-controls (which
      // samples controller poses against the original ref space) from the
      // camera (which follows setReferenceSpace). Rotating the geometry
      // achieves the visual recenter without touching the ref space, so
      // controllers remain in their real-world positions.
      el.object3D.rotation.y = -yaw;
    }

    scene.addEventListener('m3c:reset-short', function(e) {
      if (e.detail.mode === 'cinema') {
        resetGeometry();
      } else {
        recenterYaw();
      }
    });

    scene.addEventListener('m3c:reset-long', function() {
      // Full recenter: yaw recenter + geometry reset, both modes.
      recenterYaw();
      resetGeometry();
    });

    scene.addEventListener('m3c:seek', function(e) {
      if (isNaN(video.currentTime)) return;
      const delta = e.detail.sign * e.detail.seconds;
      if (delta < 0) {
        video.currentTime = Math.max(0, video.currentTime + delta);
      } else if (!isNaN(video.duration) && video.duration > 0) {
        video.currentTime = Math.min(video.duration - 0.1, video.currentTime + delta);
      }
      // If duration is unknown (live stream / early load), silently
      // skip forward seek — matches the seek logic above.
    });

    scene.addEventListener('m3c:scale', function(e) {
      // Suppress geometry scale while the browse panel is grabbing thumbstick
      // Y for grid scrolling — otherwise the user scrolls the grid AND
      // simultaneously rescales the cinema/immersive geometry.
      if (m4cConsumeThumbY) return;
      const el = activeGeometry();
      if (!el || !el.object3D) return;
      const newScale = el.object3D.scale.x * e.detail.factor;
      const clamped = Math.max(0.3, Math.min(5.0, newScale));
      el.object3D.scale.setScalar(clamped);
    });

    // Panel + lasers visibility is shared. tracked-controls' autoHide=true
    // would force el.object3D.visible = !!controller every tick, fighting
    // any visible attribute we set. We disable autoHide on each laser
    // entity once the controller connects, then own visibility ourselves.
    // We toggle BOTH the entity's visible (which hides the controller
    // model) AND the raycaster's showLine + enabled (which hide the
    // laser line and stop phantom raycast clicks).
    function setLaserActive(el, active) {
      if (!el) return;
      el.setAttribute('visible', active ? 'true' : 'false');
      el.setAttribute('raycaster', 'enabled', !!active);
      el.setAttribute('raycaster', 'showLine', !!active);
    }
    function setPanelVisible(visible) {
      const root = document.getElementById('vrControlsRoot');
      if (root) root.setAttribute('visible', visible ? 'true' : 'false');
      setLaserActive(document.getElementById('vrLaserRight'), visible);
      setLaserActive(document.getElementById('vrLaserLeft'),  visible);
    }
    function isPanelVisible() {
      const root = document.getElementById('vrControlsRoot');
      if (!root) return false;
      const v = root.getAttribute('visible');
      // A-Frame returns boolean true/false after parse; before parse it's a string.
      return v === true || v === 'true';
    }
    // laser-controls re-applies its raycaster config (including showLine: true)
    // whenever a controller (re)connects, and tracked-controls' autoHide
    // re-asserts entity visibility every tick. Disable autoHide and then
    // re-apply our hidden-state on each (re)connect.
    ['vrLaserRight', 'vrLaserLeft'].forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      const reapply = () => {
        // Defer: tracked-controls' init may not have populated this.data yet.
        // setAttribute pushes the override through A-Frame's component update
        // flow even if the component data isn't fully initialized.
        el.setAttribute('tracked-controls', 'autoHide', false);
        setLaserActive(el, isPanelVisible());
      };
      el.addEventListener('controllerconnected', reapply);
      el.addEventListener('controllermodelready', reapply);
    });

    // In-VR control panel: raycast clicks fire on .vr-btn entities (via
    // A-Frame's laser-controls + cursor pipeline). Each button has a
    // data-action attribute that maps to a sceneVideo playback verb.
    const SPEEDS = [0.5, 1.0, 1.25, 1.5, 2.0];
    let speedIdx = 1; // start at 1.0x

    function updateMuteIcon() {
      const on = document.getElementById('vrMuteIconOn');
      const off = document.getElementById('vrMuteIconOff');
      if (on) on.setAttribute('visible', !video.muted);
      if (off) off.setAttribute('visible', video.muted);
    }
    function updateLoopBtn() {
      const el = document.getElementById('vrLoopBtn');
      if (!el) return;
      el.setAttribute('material', 'color: ' + (video.loop ? '#3776c2' : '#2c5282') + '; opacity: 0.95');
    }
    function updateSpeedLabel() {
      const el = document.getElementById('vrSpeedLabel');
      if (!el) return;
      const v = SPEEDS[speedIdx];
      // Show "1.0x" not "1x"; show "1.25x" not "1.2500x".
      el.setAttribute('text', 'value', (Number.isInteger(v) ? v.toFixed(1) : v.toString()) + 'x');
    }

    function closeAllSubpanels(except) {
      ['vrFormatPicker', 'vrHelpPanel', 'vrSubtitlePicker', 'vrBrowsePanel'].forEach(id => {
        if (id === except) return;
        const el = document.getElementById(id);
        if (el) el.setAttribute('visible', false);
      });
    }

    // M4c: persisted column-count for the browse grid. Cycles 3→4→5→6→3.
    let m4cCols = parseInt(localStorage.getItem('m4c.cols') || '4', 10);
    if (m4cCols < 3 || m4cCols > 6) m4cCols = 4;

    // Place a string as a row of single-character a-text entities laid
    // along an arc, so the whole label visually follows a cylinder curve.
    // - parentEl: where the per-char a-text children are appended.
    // - text: the full string.
    // - opts: { R, thetaStartDeg, thetaLengthDeg, color, y, hubLocal }.
    //   hubLocal=true (default) means the char xz are computed relative to
    //   the parent's local origin sitting on the cylinder hub axis (works
    //   for top-strip cylinder primitives where local 0,0,0 is the hub).
    //   When parentEl's origin is OFFSET from the hub (e.g. tile titles
    //   where the tile entity sits at the hub but the title baseline is
    //   below the cover center), pass `y` as the y-coord for char meshes
    //   and `hubLocal: true` still — z is `R*cos(θ)` from the hub axis.
    // - tagClass: class assigned to each child (used for idempotent wipe).
    function placeCurvedString(parentEl, text, opts, tagClass) {
      if (!text) return;
      const R           = opts.R;
      const thetaStart  = opts.thetaStartDeg;
      const thetaLength = opts.thetaLengthDeg;
      const color       = opts.color || '#fff';
      const y           = (typeof opts.y === 'number') ? opts.y : 0;
      if (!isFinite(R) || !isFinite(thetaStart) || !isFinite(thetaLength)) return;

      // Wipe any prior curved-label children of this class so this is idempotent.
      const old = parentEl.querySelectorAll(':scope > .' + tagClass);
      old.forEach(n => n.parentNode.removeChild(n));

      // Fixed per-char arc span (0.95° at R≈3 ≈ 0.05m). Truncate with an
      // ellipsis if the full string wouldn't fit in the arc, so all
      // labels render at the SAME readable glyph size — instead of
      // shrinking long titles into illegible micro-text.
      const charDeg = 0.95;
      const maxChars = Math.max(1, Math.floor((thetaLength * 0.95) / charDeg));
      if (text.length > maxChars) {
        text = (maxChars > 1) ? (text.slice(0, maxChars - 1) + '…') : text.slice(0, 1);
      }
      const totalArcDeg = text.length * charDeg;
      const centerDeg   = thetaStart + thetaLength / 2;
      const startDeg    = centerDeg - totalArcDeg / 2;
      // Glyph size: font scale = aTextWidth / wrap-count. With width =
      // 3.6× charArcLen and wrap-count = 4, font scale ≈ 0.9× the slot
      // width — wide chars (M, W, K) fit comfortably without overlapping
      // their neighbour, narrow chars (i, l, .) leave a small gap.
      // (Earlier 6× / 4 made wide-char glyphs 50% wider than the slot.)
      const charArcLen  = R * (charDeg * Math.PI / 180);
      const aTextWidth  = (charArcLen * 3.6).toFixed(3);
      const aTextWrap   = '4';

      for (let i = 0; i < text.length; i++) {
        // char[0] at the LARGEST theta (left side from user view), char[N-1]
        // at smallest theta (right side). +theta in A-Frame's convention
        // moves the surface point in -X panel-local.
        const charDegHere = startDeg + (text.length - i - 0.5) * charDeg;
        const charRad     = charDegHere * Math.PI / 180;
        // Pull text ~5mm toward hub (closer to user) so it doesn't z-fight
        // with whatever cylinder shell shares this arc.
        const Rtxt = R - 0.005;
        const x = Rtxt * Math.sin(charRad);
        const z = Rtxt * Math.cos(charRad);
        const yawDeg = charDegHere - 180;
        const t = document.createElement('a-text');
        t.classList.add(tagClass);
        t.setAttribute('value', text[i]);
        t.setAttribute('align', 'center');
        t.setAttribute('color', color);
        t.setAttribute('width', aTextWidth);
        t.setAttribute('wrap-count', aTextWrap);
        t.setAttribute('position', x.toFixed(3) + ' ' + y.toFixed(3) + ' ' + z.toFixed(3));
        t.setAttribute('rotation', '0 ' + yawDeg.toFixed(2) + ' 0');
        parentEl.appendChild(t);
      }
    }

    // Convenience wrapper: read R + theta-* + data-label from a top-strip
    // cylinder and call placeCurvedString.
    function curveLabelInto(parentCylEl) {
      placeCurvedString(parentCylEl,
        parentCylEl.getAttribute('data-label') || '',
        {
          R:               parseFloat(parentCylEl.getAttribute('radius')),
          thetaStartDeg:   parseFloat(parentCylEl.getAttribute('theta-start')),
          thetaLengthDeg:  parseFloat(parentCylEl.getAttribute('theta-length')),
          color:           parentCylEl.getAttribute('data-label-color') || '#fff',
          y: 0,
        },
        'curved-label-char');
    }

    function applyAllCurvedLabels() {
      document.querySelectorAll('#vrBrowseTopStrip > a-cylinder').forEach(curveLabelInto);
    }
    // Apply once after scene is ready (so a-cylinder primitives have parsed
    // their attributes and we can read radius / theta-* from them).
    if (scene.hasLoaded) {
      applyAllCurvedLabels();
    } else {
      scene.addEventListener('loaded', applyAllCurvedLabels);
    }

    function updateColsLabel() {
      const el = document.getElementById('vrColsBtn');
      if (!el) return;
      el.setAttribute('data-label', 'Cols: ' + m4cCols);
      curveLabelInto(el);
    }
    updateColsLabel();

    // M4c Task 4: in-VR browse grid state + tile rendering on a cylinder curve.
    const m4cState = {
      q: '',
      filters: { performer: '', studio: '', tag: '', favorite: '', stars: 0, ocount: 0 },
      cursor: '1',
      tiles: [],   // accumulated GridTile[]
      hasMore: true,
      loading: false
    };

    function buildGridParams() {
      const p = new URLSearchParams();
      if (m4cState.q) p.set('q', m4cState.q);
      if (m4cState.filters.performer) p.set('performer', m4cState.filters.performer);
      if (m4cState.filters.studio)    p.set('studio',    m4cState.filters.studio);
      if (m4cState.filters.tag)       p.set('tag',       m4cState.filters.tag);
      if (m4cState.filters.favorite)  p.set('favorite',  m4cState.filters.favorite);
      if (m4cState.filters.stars > 0) p.set('stars',     String(m4cState.filters.stars));
      if (m4cState.filters.ocount > 0) p.set('ocount',   String(m4cState.filters.ocount));
      if (m4cState.cursor !== '1')    p.set('cursor',    m4cState.cursor);
      return p;
    }

    function fetchGrid(reset) {
      if (m4cState.loading) return;
      if (reset) {
        m4cState.cursor = '1';
        m4cState.tiles = [];
        m4cState.hasMore = true;
      }
      if (!m4cState.hasMore) return;
      m4cState.loading = true;
      const sentinel = document.getElementById('vrBrowseLoadMore');
      if (sentinel) {
        sentinel.setAttribute('value', 'Loading…');
        sentinel.setAttribute('visible', 'true');
      }
      fetch('/browse/grid?' + buildGridParams().toString(), {
        headers: { 'Accept': 'application/json' }
      })
        .then(r => r.json())
        .then(json => {
          m4cState.tiles = m4cState.tiles.concat(json.tiles || []);
          m4cState.hasMore = !!json.hasMore;
          m4cState.cursor = json.nextCursor || '1';
          m4cState.loading = false;
          relayoutTiles();
          if (sentinel) {
            sentinel.setAttribute('value', m4cState.hasMore ? '' : (m4cState.tiles.length ? 'No more scenes' : 'No scenes found'));
            sentinel.setAttribute('visible', !!sentinel.getAttribute('value'));
          }
        })
        .catch(err => {
          m4cState.loading = false;
          if (sentinel) {
            sentinel.setAttribute('value', 'fetch failed');
            sentinel.setAttribute('visible', 'true');
          }
          console.warn('stash-vr: grid fetch failed', err);
        });
    }

    // Tile rendering geometry. Computed at relayout time from m4cCols
    // and the panel's usable area. Constants here are the layout *parameters*;
    // derived per-tile dimensions live inside relayoutTiles().
    const PANEL_USABLE_W = 3.4;     // panel width (3.6) minus 0.1m padding each side
    const TILE_GAP_X = 0.06;        // horizontal gap between tiles
    const TILE_GAP_Y = 0.06;        // vertical gap between rows
    const TITLE_GAP = 0.04;         // gap between cover bottom and title strip top
    const TITLE_STRIP_H = 0.08;     // height of the title text strip
    const TILE_AREA_TOP_Y    = 0.85;   // top edge of first row (panel-local y); fixed regardless of cols
    const TILE_AREA_BOTTOM_Y = -1.05;  // bottom of visible tile area; tiles clipped below
    // Concentric cylinder radii — bg, tiles, and top-strip buttons share the
    // same hub at panel-local z = HUB_Z, but use different radii so their
    // surfaces don't z-fight. Smaller radius = surface farther from hub =
    // closer to user (since hub is on user's side, concave-toward-user).
    const HUB_Z              = 3.02;   // shared cylinder hub (panel-local +z)
    const BG_R               = 3.02;   // bg surface lands at panel-local z=0
    const ARC_R              = 3.00;   // tile cover surface at z=0.02 (in front of bg)
    const BTN_R              = 2.97;   // top-strip button surface at z=0.05 (in front of tiles)
    const TILE_Z = HUB_Z - ARC_R;     // 0.02 — for back-compat reads only
    let scrollY = 0;                // updated by thumbstick scroll
    let m4cMaxScroll = 0;           // computed in relayoutTiles each pass
    // Set true (in tickBrowseScroll) when the laser is hovering on the
    // browse panel AND the panel is visible. Read by the m3c:scale handler
    // to suppress geometry-scale binding while the user is scrolling
    // the grid with the thumbstick.
    let m4cConsumeThumbY = false;

    // ─── Tile cover: clip planes + UV-mirror helper ──────────────────────
    // The tile covers are partial cylinders viewed from the inside (hub on
    // user's side). The inside face is the *back* face of the geometry, so
    // the texture's U coordinate appears mirrored. We compensate by flipping
    // texture.repeat.x = -1 / offset.x = 1 each time we set/replace a
    // texture on a cover material.
    //
    // Clipping: tiles must not render outside the panel's visible band.
    // We use two THREE.Plane clip planes in panel-local coords (top + bottom
    // of TILE_AREA), transformed to world coords once the panel is in the
    // scene. The same plane *array* is shared across all tile covers so we
    // can mutate-in-place without re-assigning per material.
    const m4cClipPlanes = [
      new AFRAME.THREE.Plane(new AFRAME.THREE.Vector3(0,  1, 0), -TILE_AREA_BOTTOM_Y),
      new AFRAME.THREE.Plane(new AFRAME.THREE.Vector3(0, -1, 0),  TILE_AREA_TOP_Y),
    ];
    let m4cClipPlanesReady = false;
    function setupBrowseClipping() {
      // Idempotent: enable local clipping on the renderer and recompute
      // clip planes in world coords from the panel's worldMatrix. Called
      // every time the panel becomes visible (cheap; one matrix multiply).
      const panelEl = document.getElementById('vrBrowsePanel');
      if (!scene.renderer || !panelEl || !panelEl.object3D) return;
      scene.renderer.localClippingEnabled = true;
      panelEl.object3D.updateWorldMatrix(true, false);
      const mat = panelEl.object3D.matrixWorld;
      // Reset planes to panel-local, then transform to world in-place. THREE.Plane
      // doesn't have a "set local" method, so we re-init from the original normals
      // each time before applying the matrix.
      m4cClipPlanes[0].set(new AFRAME.THREE.Vector3(0,  1, 0), -TILE_AREA_BOTTOM_Y);
      m4cClipPlanes[1].set(new AFRAME.THREE.Vector3(0, -1, 0),  TILE_AREA_TOP_Y);
      m4cClipPlanes[0].applyMatrix4(mat);
      m4cClipPlanes[1].applyMatrix4(mat);
      m4cClipPlanesReady = true;
    }

    // Apply the standard cover-material settings (UV mirror + clipping +
    // double-sided + flat shader) to a Three.js material that's about to be
    // shown on a tile cover cylinder. `texture` is the map being applied.
    // For sprite mode (3x3 grid), pass {sprite: true} so we negate within
    // the per-frame repeat.x = 1/SCOLS and offset.x = c/SCOLS dance.
    function applyCoverMaterial(material, texture, opts) {
      if (texture) {
        texture.wrapS = AFRAME.THREE.RepeatWrapping;
        if (!opts || !opts.sprite) {
          texture.repeat.x = -1;
          texture.offset.x =  1;
        }
        texture.needsUpdate = true;
      }
      material.side = AFRAME.THREE.DoubleSide;
      if (m4cClipPlanesReady) {
        material.clippingPlanes = m4cClipPlanes;
        material.clipShadows = false;
      }
      material.needsUpdate = true;
    }

    // Returns per-tile placement on a curved cylinder. Each tile's cover is
    // a partial cylinder segment (a-cylinder with theta-start/theta-length)
    // rather than a flat tangent plane — so adjacent tiles share the same
    // cylinder surface and their edges meet exactly with no cross-cut.
    //
    // All tiles in a row share the same tile-entity position (the cylinder
    // hub for the row). Per-tile theta-start positions the visible segment
    // around the hub. The badge / title use the surface-point math derived
    // from the segment center.
    //
    // A-Frame cylinder convention: theta-start = 0 is +X axis, increasing
    // CCW. Our convention (theta=0 facing the user, +Z) maps to A-Frame
    // theta-start = 90°.
    //
    // Vertical anchor: row 0's *cover top edge* sits at TILE_AREA_TOP_Y
    // regardless of cols, so changing column count never pushes the first
    // row up into the top button strip.
    function tileCellPositions(tileW, tileH, tileCoverH, count) {
      const cols = m4cCols;
      const halfCols = (cols - 1) / 2;
      const thetaPerTile = tileW / ARC_R;              // arc length / radius (radians)
      const thetaPerGap  = TILE_GAP_X / ARC_R;
      const thetaSpacing = thetaPerTile + thetaPerGap;
      // Concave-toward-user: cylinder hub sits on the user's side of the
      // panel; the curved surface at A-Frame theta=180° (i.e., -Z from hub)
      // is what the user sees. hubZ + (-R) = TILE_Z → hubZ = TILE_Z + R.
      // Edge tiles are CLOSER to user than the center tile (the curve wraps
      // around the user like an IMAX screen).
      const hubZ = TILE_Z + ARC_R;

      // Top-edge anchor: row 0's cover top at TILE_AREA_TOP_Y → row 0 center
      // is one half-cover-height below.
      const yRow0Center = TILE_AREA_TOP_Y - tileCoverH / 2;

      const positions = [];
      const rows = Math.ceil(count / cols);
      for (let row = 0; row < rows; row++) {
        // scrollY increases as the user scrolls forward (stick up). For
        // forward scrolling, all tiles must shift UP (their y INCREASES)
        // so row 0 exits the top of the band and row N+1 enters from
        // below. Hence: y = base + scrollY (NOT - scrollY).
        const y = yRow0Center - row * (tileH + TILE_GAP_Y) + scrollY;
        for (let col = 0; col < cols; col++) {
          const i = row * cols + col;
          if (i >= count) break;
          const ourThetaCenter = (col - halfCols) * thetaSpacing;       // radians
          // Three.js CylinderGeometry uses vertex.x=sin(θ)*R, vertex.z=cos(θ)*R.
          // theta=0 is +Z (the side AWAY from user, since hub is on user's
          // side). theta=180° is -Z (the side facing user). Our convention's
          // +ourTheta = user's right = +X = sin(π - ourTheta) > 0 for
          // ourTheta<π/2, so the mapping is aFrameTheta = π - ourTheta.
          const aFrameThetaCenterDeg = 180 - ourThetaCenter * 180 / Math.PI;
          const aFrameThetaLengthDeg = thetaPerTile * 180 / Math.PI;
          const aFrameThetaStartDeg  = aFrameThetaCenterDeg - aFrameThetaLengthDeg / 2;
          // All tiles in a row share x=0, z=hubZ (the cylinder hub). The
          // cylinder's theta-start handles the per-column placement on the
          // curve. tileW/tileCoverH are also passed to the caller for layout
          // of the badge/title relative to the surface point.
          positions.push({
            x: 0,
            y: y,
            z: hubZ,
            thetaStartDeg:  aFrameThetaStartDeg,
            thetaLengthDeg: aFrameThetaLengthDeg,
            ourThetaCenter: ourThetaCenter,
            thetaPerTile:   thetaPerTile
          });
        }
      }
      return positions;
    }

    const tileTextures = {}; // cache: thumbnailURL → THREE.Texture

    function getTileTexture(url) {
      if (!url) return null;
      if (tileTextures[url]) return tileTextures[url];
      const loader = new AFRAME.THREE.TextureLoader();
      const tex = loader.load(url);
      tileTextures[url] = tex;
      return tex;
    }

    // Hover preview: swap a tile's cover texture for its WebM preview clip
    // while the laser pointer is on it. One decoded video at a time (whichever
    // tile is hovered). The <video> element is allocated lazily on first hover
    // and cached on the tile entity as el._previewVideo.
    function attachPreviewHandlers(tileEl) {
      const plane = tileEl.querySelector('.vr-tile-cover');
      if (!plane) return;

      function ensureVideo() {
        if (tileEl._previewVideo) return tileEl._previewVideo;
        const v = document.createElement('video');
        v.src = tileEl.dataset.previewUrl;
        v.muted = true;
        v.loop = true;
        v.playsInline = true;
        v.crossOrigin = 'anonymous';
        v.preload = 'metadata';
        tileEl._previewVideo = v;
        return v;
      }

      plane.addEventListener('mouseenter', function() {
        // Hover affordance: pop the whole tile entity forward by 0.04m in
        // panel-local +z (toward the user, since the cylinder hub is on
        // the user's side of the concave surface). Avoids the prior 1.05×
        // scale, which expanded the cylinder radius from 3.0 to 3.15 and
        // pushed the cover surface behind the bg plane (clip-through).
        if (tileEl.object3D && !tileEl._hoverPopped) {
          tileEl.object3D.position.z += 0.04;
          tileEl._hoverPopped = true;
        }
        const v = ensureVideo();
        v.currentTime = 0;
        // Track this hover so that a stale (slow) play() resolution after
        // the user has already moved off doesn't replace the cover.
        const hoverToken = (tileEl._hoverToken = (tileEl._hoverToken || 0) + 1);
        const playPromise = v.play();
        if (!playPromise || !playPromise.then) return;
        playPromise.then(function() {
          // Only swap to VideoTexture once the video is actually playing
          // (avoids the "pitch black" frame on no-preview scenes that
          // 404 — play() rejects, cover stays). Also bail if the user
          // already moved off this tile.
          if (tileEl._hoverToken !== hoverToken) return;
          const mesh = plane.getObject3D('mesh');
          if (!mesh) return;
          const tex = new AFRAME.THREE.VideoTexture(v);
          tex.minFilter = AFRAME.THREE.LinearFilter;
          tex.magFilter = AFRAME.THREE.LinearFilter;
          mesh.material = new AFRAME.THREE.MeshBasicMaterial({ map: tex });
          applyCoverMaterial(mesh.material, tex);
        }).catch(function(err) {
          if (tileEl._hoverToken !== hoverToken) return;
          // WebM unavailable (common: Stash hasn't generated a preview).
          // Fall back to cycling through the sprite sheet.
          console.debug('stash-vr: preview play() failed; trying sprite', err);
          startSpriteCycle(tileEl, plane);
        });
      });

      plane.addEventListener('mouseleave', function() {
        // Reverse the hover pop (+0.04m in panel-local z) regardless of
        // which fallback path (video / sprite / nothing) was active.
        if (tileEl.object3D && tileEl._hoverPopped) {
          tileEl.object3D.position.z -= 0.04;
          tileEl._hoverPopped = false;
        }
        // Invalidate any in-flight play() resolution from the previous
        // mouseenter so it can't replace the cover after we restore it.
        tileEl._hoverToken = (tileEl._hoverToken || 0) + 1;
        const v = tileEl._previewVideo;
        if (v) {
          v.pause();
          v.currentTime = 0;
        }
        stopSpriteCycle(tileEl);
        const coverURL = tileEl.dataset.thumbnailUrl;
        const coverTex = coverURL ? tileTextures[coverURL] : null;
        const mesh = plane.getObject3D('mesh');
        if (mesh && coverTex) {
          mesh.material = new AFRAME.THREE.MeshBasicMaterial({ map: coverTex });
          applyCoverMaterial(mesh.material, coverTex);
        }
      });
    }

    // Sprite-sheet fallback when WebM preview is missing. Stash convention:
    // a 3x3 grid of 9 frames at /browse/scene/{id}/sprite. Cycle frames by
    // updating the texture's UV offset every 250ms (~4 fps cinema feel).
    function startSpriteCycle(tileEl, plane) {
      if (tileEl._spriteIntervalId) return;
      const spriteUrl = '/browse/scene/' + encodeURIComponent(tileEl.dataset.sceneId) + '/sprite';
      const loader = new AFRAME.THREE.TextureLoader();
      loader.load(spriteUrl, function(spriteTex) {
        spriteTex.minFilter = AFRAME.THREE.LinearFilter;
        spriteTex.magFilter = AFRAME.THREE.LinearFilter;
        const SCOLS = 3, SROWS = 3;
        // Mirror via negative repeat.x (cylinder-inside view); offset.x then
        // shifts the negated cell into place per-frame in showFrame().
        spriteTex.repeat.set(-1 / SCOLS, 1 / SROWS);
        const mesh = plane.getObject3D('mesh');
        if (!mesh) return;
        mesh.material = new AFRAME.THREE.MeshBasicMaterial({ map: spriteTex });
        applyCoverMaterial(mesh.material, spriteTex, { sprite: true });
        let frame = 0;
        function showFrame() {
          const c = frame % SCOLS;
          const r = Math.floor(frame / SCOLS) % SROWS;
          // U: with repeat.x = -1/SCOLS, range is from offset.x (at u=0) to
          // offset.x - 1/SCOLS (at u=1). For cell c, we want the texture
          // U range [c/SCOLS, (c+1)/SCOLS] to land on geometry u in [0,1],
          // mirrored, so offset.x = (c+1)/SCOLS.
          // V: (0,0) is bottom-left; sprite rows are top-to-bottom, so y=1-(r+1)/SROWS.
          spriteTex.offset.set((c + 1) / SCOLS, 1 - (r + 1) / SROWS);
          spriteTex.needsUpdate = true;
        }
        showFrame();
        tileEl._spriteIntervalId = setInterval(function() {
          frame = (frame + 1) % (SCOLS * SROWS);
          showFrame();
        }, 250);
      }, undefined, function(err) {
        // Sprite also unavailable — silently keep cover.
        console.debug('stash-vr: sprite unavailable', err);
      });
    }

    function stopSpriteCycle(tileEl) {
      if (tileEl._spriteIntervalId) {
        clearInterval(tileEl._spriteIntervalId);
        tileEl._spriteIntervalId = null;
      }
    }

    function relayoutTiles() {
      const root = document.getElementById('vrBrowseTiles');
      if (!root) return;

      const cols = m4cCols;
      const tileW = (PANEL_USABLE_W - (cols - 1) * TILE_GAP_X) / cols;
      const tileCoverH = tileW * 9 / 16;
      const tileH = tileCoverH + TITLE_GAP + TITLE_STRIP_H;
      const badgeR = Math.min(0.04, tileW * 0.07);

      // Remove tile entities for tiles no longer in state.tiles.
      const expected = new Set(m4cState.tiles.map(t => t.id));
      Array.from(root.children).forEach(child => {
        if (!expected.has(child.dataset.sceneId)) {
          root.removeChild(child);
        }
      });

      const positions = tileCellPositions(tileW, tileH, tileCoverH, m4cState.tiles.length);

      // Max scroll: total content height minus visible band. When content
      // fits in band, max=0 (no scroll). Used by tickBrowseScroll to clamp.
      const totalRows = Math.ceil(m4cState.tiles.length / cols);
      const totalContentH = totalRows > 0 ? totalRows * (tileH + TILE_GAP_Y) - TILE_GAP_Y : 0;
      const visibleH = TILE_AREA_TOP_Y - TILE_AREA_BOTTOM_Y;
      m4cMaxScroll = Math.max(0, totalContentH - visibleH);

      m4cState.tiles.forEach((tile, i) => {
        const pos = positions[i];
        // Surface points in tile-entity local coords. The tile entity is at
        // the cylinder hub. With concave-toward-user (aFrameTheta = π-ourθ),
        // a surface point at our_theta is at:
        //   (sin(π-ourθ)·R, *, cos(π-ourθ)·R) = (sin(ourθ)·R, *, -cos(ourθ)·R)
        // i.e., x uses sin (sign-preserved), z uses -cos (negated vs. convex).
        const thetaRightEdge   = pos.ourThetaCenter + pos.thetaPerTile / 2;
        const titleSurfaceX    =  ARC_R * Math.sin(pos.ourThetaCenter);
        const titleSurfaceZ    = -ARC_R * Math.cos(pos.ourThetaCenter);
        const badgeSurfaceX    =  ARC_R * Math.sin(thetaRightEdge);
        const badgeSurfaceZ    = -ARC_R * Math.cos(thetaRightEdge);
        const badgeLocalX      = badgeSurfaceX - badgeR - 0.005;
        const badgeLocalY      = (tileCoverH / 2) - badgeR - 0.005;
        // +0.005 along surface→hub direction (toward user, since hub is on
        // user's side of the curved surface). For concave the surface z is
        // negative, hub at 0; moving toward hub = adding small positive z.
        const badgeLocalZ      = badgeSurfaceZ + 0.005;
        const badgeYawDeg      = -thetaRightEdge * 180 / Math.PI;
        const titleY           = -(tileCoverH / 2 + TITLE_GAP + TITLE_STRIP_H / 2);
        const titleZ           = titleSurfaceZ + 0.005;
        const titleYawDeg      = -pos.ourThetaCenter * 180 / Math.PI;

        let el = root.querySelector('a-entity[data-scene-id="' + CSS.escape(tile.id) + '"]');
        if (!el) {
          // Build a new tile entity from scratch.
          el = document.createElement('a-entity');
          el.classList.add('vr-tile');
          el.dataset.sceneId = tile.id;
          el.dataset.projection = JSON.stringify(tile.projection);
          el.dataset.streamUrl = '/browse/scene/' + encodeURIComponent(tile.id) + '/stream';
          el.dataset.previewUrl = '/browse/scene/' + encodeURIComponent(tile.id) + '/preview';
          el.dataset.thumbnailUrl = tile.thumbnailURL;

          // Cover: a curved cylinder segment. theta-start/theta-length
          // position the visible portion of the cylinder around the row's
          // shared hub axis, so adjacent tiles share one continuous surface
          // and meet exactly at their edges with no cross-cut.
          const plane = document.createElement('a-cylinder');
          plane.classList.add('vr-btn', 'vr-tile-cover');
          plane.setAttribute('radius', ARC_R);
          plane.setAttribute('height', tileCoverH);
          plane.setAttribute('open-ended', 'true');     // no top/bottom caps
          // Material: shader-flat + side:double (so partial-cylinder winding
          // is irrelevant — both faces render). src:<url> binds the cover
          // texture via A-Frame's material lifecycle, which handles UV
          // mapping on partial-arc geometry correctly.
          plane.setAttribute('material',
            'shader: flat; side: double; color: #fff; src: url(' + tile.thumbnailURL + ')');
          plane.setAttribute('theta-start',  pos.thetaStartDeg);
          plane.setAttribute('theta-length', pos.thetaLengthDeg);
          // Once A-Frame has loaded the texture, run our cover-material
          // settings: mirror UV on the inside-of-cylinder view, attach the
          // panel-band clipping planes, force needsUpdate. Fires again if
          // the material src is later changed (e.g. retry after error).
          plane.addEventListener('materialtextureloaded', function() {
            const mesh = plane.getObject3D('mesh');
            if (!mesh || !mesh.material) return;
            applyCoverMaterial(mesh.material, mesh.material.map || null);
          });
          // No position offset — cylinder local origin is on the hub axis,
          // and the tile entity is positioned at the hub itself.
          el.appendChild(plane);

          // ⓘ detail badge — top-right corner of the cover, on the curve.
          // The badge is a flat circle, so rotate it to face roughly the
          // cylinder surface tangent at theta = right-edge.
          const detailBadge = document.createElement('a-entity');
          detailBadge.classList.add('vr-btn', 'vr-tile-detail');
          detailBadge.setAttribute('geometry', 'primitive:circle;radius:' + badgeR.toFixed(3));
          detailBadge.setAttribute('material', 'color:#000;opacity:0.85;shader:flat');
          detailBadge.setAttribute('position',
            badgeLocalX.toFixed(3) + ' ' + badgeLocalY.toFixed(3) + ' ' + badgeLocalZ.toFixed(3));
          detailBadge.setAttribute('rotation', '0 ' + badgeYawDeg.toFixed(3) + ' 0');
          const badgeText = document.createElement('a-text');
          badgeText.setAttribute('value', 'ⓘ');
          badgeText.setAttribute('align', 'center');
          badgeText.setAttribute('color', '#fff');
          badgeText.setAttribute('width', (badgeR * 8).toFixed(3));
          badgeText.setAttribute('position', '0 0 0.005');
          detailBadge.appendChild(badgeText);
          el.appendChild(detailBadge);

          // Title strip — per-character curved layout. The chars sit on
          // the same arc as the cover (radius ARC_R, theta-start /
          // theta-length from pos) but at a y below the cover center, so
          // the whole title follows the cylinder curve and never extends
          // past the bg arc edges. Wrapped in an <a-entity> so we can
          // toggle its visibility as a unit when the row scrolls out of
          // the band.
          const titleWrap = document.createElement('a-entity');
          titleWrap.classList.add('vr-tile-title');
          el.appendChild(titleWrap);
          placeCurvedString(titleWrap, tile.title, {
            R: ARC_R,
            thetaStartDeg:  pos.thetaStartDeg,
            thetaLengthDeg: pos.thetaLengthDeg,
            color: '#fff',
            y: titleY,
          }, 'curved-title-char');

          // Cover texture is bound via the material src attribute above;
          // A-Frame's material component handles loading + lifecycle. We
          // still pre-warm the tileTextures cache so mouseleave can restore
          // the cover via THREE.Texture (used by hover/sprite-cycle paths).
          getTileTexture(tile.thumbnailURL);

          attachPreviewHandlers(el);
          root.appendChild(el);
          // Stamp the geom signature so the first existing-tile relayout
          // doesn't see a mismatch and rebuild from scratch.
          el.dataset.geomSig = pos.thetaStartDeg.toFixed(2) + '|' +
                               pos.thetaLengthDeg.toFixed(2) + '|' +
                               tileCoverH.toFixed(3);
        } else {
          // Existing tile: cols may have changed → resize cover, badge, title.
          // Track whether per-tile geometry actually changed since the
          // last relayout. If only the row's y has shifted (pure scroll),
          // we don't need to rebuild any of the cylinder geometry or the
          // per-character title chars — the children all live in
          // tile-local coords and inherit the y-shift from the tile entity.
          const geomSig = pos.thetaStartDeg.toFixed(2) + '|' +
                          pos.thetaLengthDeg.toFixed(2) + '|' +
                          tileCoverH.toFixed(3);
          const geomChanged = (el.dataset.geomSig !== geomSig);
          const cyl = el.querySelector('a-cylinder.vr-tile-cover');
          if (cyl && geomChanged) {
            cyl.setAttribute('radius', ARC_R);
            cyl.setAttribute('height', tileCoverH);
            cyl.setAttribute('theta-start',  pos.thetaStartDeg);
            cyl.setAttribute('theta-length', pos.thetaLengthDeg);
          }
          const badge = el.querySelector('.vr-tile-detail');
          if (badge && geomChanged) {
            badge.setAttribute('geometry', 'primitive:circle;radius:' + badgeR.toFixed(3));
            badge.setAttribute('position',
              badgeLocalX.toFixed(3) + ' ' + badgeLocalY.toFixed(3) + ' ' + badgeLocalZ.toFixed(3));
            badge.setAttribute('rotation', '0 ' + badgeYawDeg.toFixed(3) + ' 0');
          }
          // Only rebuild the per-character title chars if the cover arc
          // has actually changed (cols cycle), NOT on every scroll frame.
          // Without this gate, scrolling wipes + recreates ~20 a-text
          // entities per visible tile every frame, causing titles to
          // flicker / vanish during scroll.
          const titleWrap = el.querySelector(':scope > .vr-tile-title');
          if (titleWrap && geomChanged) {
            placeCurvedString(titleWrap, tile.title, {
              R: ARC_R,
              thetaStartDeg:  pos.thetaStartDeg,
              thetaLengthDeg: pos.thetaLengthDeg,
              color: '#fff',
              y: titleY,
            }, 'curved-title-char');
          }
          el.dataset.geomSig = geomSig;
        }
        // Tile entity sits at the cylinder hub for the row. The cover
        // cylinder's theta-start handles the per-column placement on the
        // curve, so no per-tile yaw rotation is needed on the entity itself.
        // Preserve the +0.04m hover pop so a relayout (e.g. cols cycle,
        // load-more) doesn't snap a currently-hovered tile back.
        const popOffset = el._hoverPopped ? 0.04 : 0;
        el.setAttribute('position', { x: pos.x, y: pos.y, z: pos.z + popOffset });
        el.setAttribute('rotation', { x: 0, y: 0, z: 0 });
        // Tile entity stays visible whenever its cover bbox overlaps the
        // panel band — the cover material's clippingPlanes do the partial
        // render at the top/bottom edges. We hide the entire tile only when
        // the cover is fully outside the band (saves draw calls and avoids
        // text/badge bleed past the edge).
        const coverTop = pos.y + tileCoverH / 2;
        const coverBot = pos.y - tileCoverH / 2;
        if (el.object3D) {
          el.object3D.visible = (coverTop > TILE_AREA_BOTTOM_Y && coverBot < TILE_AREA_TOP_Y);
        }
        // Title/badge use independent bool visibility (their text/circle
        // materials don't carry clippingPlanes — MSDF text shader doesn't
        // support them, and we don't bother for the small badge circle).
        // Hide them once their *center* leaves the band; the cover's clip
        // planes still render the cover correctly behind them.
        const titleAbsY = pos.y + titleY;
        const badgeAbsY = pos.y + badgeLocalY;
        const titleNode = el.querySelector(':scope > .vr-tile-title');
        if (titleNode && titleNode.object3D) {
          titleNode.object3D.visible = (titleAbsY > TILE_AREA_BOTTOM_Y && titleAbsY < TILE_AREA_TOP_Y);
        }
        const badgeNode = el.querySelector(':scope > .vr-tile-detail');
        if (badgeNode && badgeNode.object3D) {
          badgeNode.object3D.visible = (badgeAbsY > TILE_AREA_BOTTOM_Y && badgeAbsY < TILE_AREA_TOP_Y);
        }
      });
    }

    function onBrowsePanelOpen() {
      // First open: enable renderer local clipping + compute the band's
      // world-space planes from the panel's transform. Cheap to call again
      // on every open (the panel's transform doesn't change, but this lets
      // us recover if the user resized/relocated the panel later).
      setupBrowseClipping();
      // Re-apply clip planes to existing tile cover materials (those whose
      // texture loaded *before* setupBrowseClipping ran on first open).
      document.querySelectorAll('#vrBrowseTiles .vr-tile-cover').forEach(function(c) {
        const mesh = c.getObject3D && c.getObject3D('mesh');
        if (mesh && mesh.material) {
          mesh.material.clippingPlanes = m4cClipPlanes;
          mesh.material.clipShadows = false;
          mesh.material.needsUpdate = true;
        }
      });
      fetchGrid(true);
    }

    function vrAction(action) {
      if (action === 'playpause') {
        if (video.paused) {
          const p = video.play();
          if (p && p.catch) p.catch(err => console.warn('stash-vr: video play failed', err));
        } else {
          video.pause();
        }
      } else if (action === 'mute') {
        video.muted = !video.muted;
        updateMuteIcon();
        refreshVolumeUI();
      } else if (action === 'speed') {
        speedIdx = (speedIdx + 1) % SPEEDS.length;
        video.playbackRate = SPEEDS[speedIdx];
        if ('preservesPitch' in video) video.preservesPitch = true;
        updateSpeedLabel();
      } else if (action === 'loop') {
        video.loop = !video.loop;
        updateLoopBtn();
      } else if (action === 'exit') {
        try { scene.exitVR(); } catch (e) { console.warn('stash-vr: exitVR failed', e); }
      } else if (action === 'format') {
        if (picker) {
          const visible = picker.getAttribute('visible');
          const willShow = !(visible === true || visible === 'true');
          if (willShow) closeAllSubpanels('vrFormatPicker');
          picker.setAttribute('visible', willShow);
        }
      } else if (action === 'help') {
        const help = document.getElementById('vrHelpPanel');
        if (help) {
          const visible = help.getAttribute('visible');
          const willShow = !(visible === true || visible === 'true');
          if (willShow) closeAllSubpanels('vrHelpPanel');
          help.setAttribute('visible', willShow);
        }
      } else if (action === 'help-close') {
        const help = document.getElementById('vrHelpPanel');
        if (help) help.setAttribute('visible', false);
      } else if (action === 'browse') {
        const bp = document.getElementById('vrBrowsePanel');
        if (bp) {
          const visible = bp.getAttribute('visible');
          const willShow = !(visible === true || visible === 'true');
          if (willShow) closeAllSubpanels('vrBrowsePanel');
          bp.setAttribute('visible', willShow);
          if (willShow) onBrowsePanelOpen();
        }
      } else if (action === 'browse-close') {
        const bp = document.getElementById('vrBrowsePanel');
        if (bp) bp.setAttribute('visible', false);
      } else if (action === 'toggle-debug-overlay') {
        const dbg = document.getElementById('vrDebugOverlay');
        if (dbg) {
          const v = dbg.getAttribute('visible');
          dbg.setAttribute('visible', !(v === true || v === 'true'));
        }
      } else if (action === 'cols-cycle') {
        m4cCols = (m4cCols >= 6) ? 3 : (m4cCols + 1);
        localStorage.setItem('m4c.cols', String(m4cCols));
        updateColsLabel();
        if (typeof relayoutTiles === 'function') relayoutTiles(); // Task 4 defines
      } else if (action === 'cc') {
        const sub = document.getElementById('vrSubtitlePicker');
        if (sub) {
          const visible = sub.getAttribute('visible');
          if (visible === true || visible === 'true') {
            sub.setAttribute('visible', false);
          } else {
            closeAllSubpanels('vrSubtitlePicker');
            sub.setAttribute('visible', true);
          }
        }
      } else if (action === 'scrub' || action === 'scrub-bg') {
        // No-op here; the scrub-bar drag handles seeking via mousedown.
      }
      // 'vol-track' is a no-op (the slider drag uses mousedown).
    }
    document.querySelectorAll('.vr-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const action = btn.dataset.action || btn.getAttribute('data-action');
        if (action) {
          vrAction(action);
          return;
        }
        const row = btn.dataset.pickRow;
        const value = btn.dataset.pickValue;
        if (row) handlePickerTap(row, value);
      });
    });

    // Volume slider drag — write video.volume in [0, 1] from cursor X across
    // the slider track. Local-X math: slider element is at panel-local
    // (-0.96, -0.20, 0.01); track center is the slider's origin and spans
    // -0.20 .. +0.20 (width 0.40). worldToLocal converts the raycaster's
    // world-space hit into the slider's local frame.
    const VOL_BAR_W = 0.40;
    const VOL_BAR_LEFT = -0.20;
    let volActive = false;

    function cursorToVol(intersection) {
      const slider = document.getElementById('vrVolumeSlider');
      if (!slider || !slider.object3D || !intersection || !intersection.point) return null;
      const local = slider.object3D.worldToLocal(intersection.point.clone());
      return Math.max(0, Math.min(1, (local.x - VOL_BAR_LEFT) / VOL_BAR_W));
    }

    // Pick whichever laser currently has a non-empty intersection list.
    // raycaster-intersection only fires on list change, so for per-frame
    // sampling during a drag we poll the raycaster component directly.
    function activeLaserIntersection() {
      const ids = ['vrLaserRight', 'vrLaserLeft'];
      for (let i = 0; i < ids.length; i++) {
        const el = document.getElementById(ids[i]);
        if (!el) continue;
        const rc = el.components && el.components.raycaster;
        if (!rc) continue;
        const its = rc.intersections || [];
        if (its.length) return its[0];
      }
      return null;
    }

    function tickSliders() {
      if (!volActive && !scrubActive) return;
      const hit = activeLaserIntersection();
      if (!hit) return;
      if (volActive) {
        const v = cursorToVol(hit);
        if (v !== null) setVideoVolume(v);
      }
      if (scrubActive) {
        const t = cursorToScrubT(hit);
        if (t !== null) setVideoTime(t, true);
      }
    }

    // Browse-panel thumbstick scroll. Polls the same axis source M3c uses
    // (controller.gamepad.axes / tracked-controls.axis), so we never have
    // to subscribe to thumbstickmoved events that may not fire on every
    // platform. Active only while the browse panel is visible AND a laser
    // is intersecting one of its surfaces — that's also the gate that tells
    // m3c:scale to skip (so the user doesn't simultaneously scale the
    // cinema/immersive geometry while scrolling the grid). M4c spec §4.4:
    // stick-up (positive normalized y) → scroll up (decrease scrollY).
    function _readThumbstickAxes(laserEl) {
      if (!laserEl) return null;
      const tc = laserEl.components && laserEl.components['tracked-controls'];
      const ctrl = tc && tc.controller;
      const axes = (ctrl && ctrl.gamepad && ctrl.gamepad.axes) || (tc && tc.axis) || null;
      if (!axes || axes.length < 2) return null;
      const safe = (n) => (typeof n === 'number' && !isNaN(n)) ? n : 0;
      // Same dual-slot probe as m3c-controls._getThumbstick.
      const x2 = axes.length >= 3 ? safe(axes[2]) : 0;
      const y2 = axes.length >= 4 ? safe(axes[3]) : 0;
      const x0 = safe(axes[0]);
      const y0 = safe(axes[1]);
      const x = Math.abs(x2) > 0.001 ? x2 : x0;
      const y = Math.abs(y2) > 0.001 ? y2 : y0;
      return { x: x, y: y };
    }
    function _laserIsOnBrowsePanel(laserEl) {
      if (!laserEl) return false;
      const rc = laserEl.components && laserEl.components.raycaster;
      if (!rc) return false;
      const its = rc.intersections || [];
      if (!its.length) return false;
      let target = its[0].el || (its[0].object && its[0].object.el);
      if (!target) return false;
      // Walk up the DOM tree; if we hit #vrBrowsePanel, the laser is on
      // some descendant (tile cover, badge, top-strip button, bg). Any of
      // those should let the thumbstick scroll the grid — otherwise users
      // had to keep the laser on a tile cover, which is fiddly.
      while (target) {
        if (target.id === 'vrBrowsePanel') return true;
        target = target.parentElement;
      }
      return false;
    }
    // Diagnostics — writes what each laser's first intersection is hitting
    // into the in-VR debug overlay AND into window.svDebugLasers().
    function _summarizeIntersection(its) {
      if (!its || !its.length) return '(none)';
      return its.slice(0, 3).map(i => {
        const el = i.el || (i.object && i.object.el);
        if (!el) return '?';
        const id  = el.id ? '#' + el.id : '';
        const cls = el.className ? '.' + String(el.className).split(' ').filter(Boolean).join('.') : '';
        const tag = el.tagName ? el.tagName.toLowerCase() : '?';
        const dist = (typeof i.distance === 'number') ? i.distance.toFixed(2) : '?';
        return tag + id + cls + '@' + dist;
      }).join(' | ');
    }
    function _laserHits(laserId) {
      const el = document.getElementById(laserId);
      if (!el) return '(no laser)';
      const rc = el.components && el.components.raycaster;
      return _summarizeIntersection(rc && rc.intersections);
    }
    window.svDebugLasers = function () {
      return { right: _laserHits('vrLaserRight'), left: _laserHits('vrLaserLeft') };
    };

    let m4cLastScrollTickMs = 0;
    function _setDbg(line1, line2) {
      const dbg = document.getElementById('vrDebugOverlayText');
      if (!dbg) return;
      // Use the text component's value prop directly — setAttribute('value', ...)
      // on an a-text triggers a full schema reparse and can be flaky.
      dbg.setAttribute('text', 'value', (line1 || '') + (line2 ? '\n' + line2 : ''));
    }
    function tickBrowseScroll() {
      const bp = document.getElementById('vrBrowsePanel');
      const bpVis = bp && (bp.getAttribute('visible') === true || bp.getAttribute('visible') === 'true');

      // Pick whichever laser is currently on a browse-panel surface.
      const lasers = ['vrLaserRight', 'vrLaserLeft'].map(id => document.getElementById(id));
      let activeLaser = null;
      for (let i = 0; i < lasers.length; i++) {
        if (_laserIsOnBrowsePanel(lasers[i])) { activeLaser = lasers[i]; break; }
      }

      // Update diagnostic overlay only if it's currently visible (toggled
      // on by the DBG button on the playback panel). Saves the per-frame
      // a-text reflow when the user isn't looking at the diagnostics.
      const dbgRoot = document.getElementById('vrDebugOverlay');
      const dbgVis = dbgRoot && (dbgRoot.getAttribute('visible') === true ||
                                 dbgRoot.getAttribute('visible') === 'true');
      if (dbgVis) {
        const tsR = _readThumbstickAxes(document.getElementById('vrLaserRight')) || { x: 0, y: 0 };
        const tsL = _readThumbstickAxes(document.getElementById('vrLaserLeft'))  || { x: 0, y: 0 };
        const dbgLine1 = 'R hits: ' + _laserHits('vrLaserRight');
        const dbgLine2 = 'sy R=' + tsR.y.toFixed(2) + ' L=' + tsL.y.toFixed(2) +
                         ' scroll=' + scrollY.toFixed(2) +
                         '/' + m4cMaxScroll.toFixed(2) +
                         ' onPanel=' + (activeLaser ? activeLaser.id.replace('vrLaser','') : 'no') +
                         ' bp=' + (bpVis ? '1' : '0');
        _setDbg(dbgLine1, dbgLine2);
      }

      if (!bpVis) {
        m4cConsumeThumbY = false;
        m4cLastScrollTickMs = 0;
        return;
      }
      if (!activeLaser) {
        m4cConsumeThumbY = false;
        m4cLastScrollTickMs = 0;
        return;
      }
      m4cConsumeThumbY = true;  // suppress m3c:scale while we own thumbstick

      const ts = _readThumbstickAxes(activeLaser);
      if (!ts) { m4cLastScrollTickMs = 0; return; }
      // xr-standard: stick-up reads as ts.y = -1, stick-down as +1.
      // Deadzone matches M3c's scale gate (0.3) so light drift doesn't scroll.
      if (Math.abs(ts.y) < 0.3) { m4cLastScrollTickMs = 0; return; }

      const now = performance.now();
      const dt = m4cLastScrollTickMs ? Math.min(0.1, (now - m4cLastScrollTickMs) / 1000) : 1 / 60;
      m4cLastScrollTickMs = now;
      // 0.6 m/s at full deflection. Stick DOWN (ts.y = +1) → scroll
      // forward (scrollY INCREASES → tiles shift up → next rows revealed
      // below). Stick UP reverses; scrollY clamps at 0 (top). Matches the
      // mobile "drag down to scroll down" convention requested by the user.
      const rate = 0.6;
      const target = scrollY + ts.y * rate * dt;
      const clamped = Math.max(0, Math.min(target, m4cMaxScroll));
      if (Math.abs(clamped - scrollY) < 0.0001) return;
      scrollY = clamped;
      relayoutTiles();
      // Lazy-load when nearing the bottom of currently-loaded content. The
      // 0.5m buffer gives time for the fetch round-trip before the user
      // scrolls past the end.
      if (m4cState.hasMore && !m4cState.loading && scrollY > m4cMaxScroll - 0.5) {
        fetchGrid(false);
      }
    }

    function refreshVolumeUI() {
      const displayed = video.muted ? 0 : video.volume;
      const fill = document.getElementById('vrVolumeFill');
      const thumb = document.getElementById('vrVolumeThumb');
      const w = displayed * VOL_BAR_W;
      if (fill) {
        // A-Frame plane width must be > 0; use a hairline minimum.
        fill.setAttribute('width', Math.max(0.001, w));
        fill.setAttribute('position', { x: VOL_BAR_LEFT + w / 2, y: 0, z: 0.001 });
      }
      if (thumb) {
        thumb.setAttribute('position', { x: VOL_BAR_LEFT + w, y: 0, z: 0.005 });
      }
    }

    function setVideoVolume(v) {
      video.volume = Math.max(0, Math.min(1, v));
      // Dragging the slider unmutes — matches HTML5 video element semantics
      // and avoids the user wondering why volume changes don't take effect.
      if (video.muted && video.volume > 0) {
        video.muted = false;
        updateMuteIcon();
      }
      refreshVolumeUI();
    }

    document.querySelectorAll('.vr-vol-track, .vr-vol-thumb').forEach(el => {
      el.addEventListener('mousedown', function(evt) {
        volActive = true;
        const intersection = evt.detail && evt.detail.intersection;
        if (intersection) {
          const v = cursorToVol(intersection);
          if (v !== null) setVideoVolume(v);
        }
      });
      el.addEventListener('mouseup', function() { volActive = false; });
    });

    // Drag sampling itself happens in tickSliders() inside rafLoop.
    // The cleared listener stays as a backstop: if the laser leaves all
    // targets mid-drag, the matching mouseup fires on whatever the laser
    // landed on (often nothing), so we end the drag here instead.
    ['vrLaserRight', 'vrLaserLeft'].forEach(id => {
      const laser = document.getElementById(id);
      if (!laser) return;
      laser.addEventListener('raycaster-intersection-cleared', function() {
        volActive = false;
      });
    });

    // Backstop: any mouseup anywhere ends the drag. Cheap; runs only on click.
    scene.addEventListener('mouseup', function() { volActive = false; });

    // Slider drag — driven by controller-level triggerdown/up events on the
    // lasers themselves. The cursor synthetic mousedown/mouseup events
    // proved unreliable for sustained drags (cursor emits mouseup as soon
    // as the laser leaves the hit entity, killing the active flag). Use
    // the same event source M3c uses for its trigger state machine.
    function _laserHitTarget(intersection) {
      if (!intersection) return null;
      return intersection.el || (intersection.object && intersection.object.el) || null;
    }

    ['vrLaserRight', 'vrLaserLeft'].forEach(id => {
      const laser = document.getElementById(id);
      if (!laser) return;
      laser.addEventListener('triggerdown', function() {
        const rc = laser.components && laser.components.raycaster;
        if (!rc) return;
        const its = rc.intersections || [];
        if (!its.length) return;
        const intersection = its[0];
        const target = _laserHitTarget(intersection);
        if (!target || !target.classList) return;
        const cl = target.classList;
        if (cl.contains('vr-vol-track') || cl.contains('vr-vol-thumb')) {
          volActive = true;
          const v = cursorToVol(intersection);
          if (v !== null) setVideoVolume(v);
        } else if (cl.contains('vr-scrub-marker')) {
          // Marker click: jump to its seconds (no drag).
          const secs = parseFloat(target.dataset.markerSeconds);
          if (!isNaN(secs)) setVideoTime(secs, false);
        } else if (cl.contains('vr-scrub') || cl.contains('vr-scrub-bg')) {
          scrubActive = true;
          const t = cursorToScrubT(intersection);
          if (t !== null) setVideoTime(t, false);
        }
      });
      laser.addEventListener('triggerup', function() {
        volActive = false;
        scrubActive = false;
      });
    });

    // Initialize volume to 1.0; this also positions the fill + thumb at the right edge.
    setVideoVolume(1.0);

    function formatTime(s) {
      if (!isFinite(s) || s < 0) s = 0;
      const total = Math.floor(s);
      const h = Math.floor(total / 3600);
      const m = Math.floor((total % 3600) / 60);
      const sec = total % 60;
      if (h > 0) return h + ':' + String(m).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
      return m + ':' + String(sec).padStart(2, '0');
    }

    let lastTimeUpdateMs = 0;
    function tickTimeDisplay(nowMs) {
      // Throttle to ~1 Hz: <a-text> re-renders are expensive enough that
      // running them per-frame burns frame budget for no visible benefit.
      if (nowMs - lastTimeUpdateMs < 1000) return;
      lastTimeUpdateMs = nowMs;
      const el = document.getElementById('vrTime');
      if (!el) return;
      const cur = formatTime(video.currentTime || 0);
      const dur = formatTime(video.duration || 0);
      el.setAttribute('text', 'value', cur + ' / ' + dur);
    }

    const captionsData = {{ marshal .Captions }} || [];

    // Picker layout — buttons in a wrapping flex of up to 4 per row.
    function renderSubtitlePicker() {
      const buttonsRoot = document.getElementById('vrSubtitlePickerButtons');
      const bg = document.getElementById('vrSubtitlePickerBg');
      const title = document.getElementById('vrSubtitlePickerTitle');
      if (!buttonsRoot) return;
      while (buttonsRoot.firstChild) buttonsRoot.removeChild(buttonsRoot.firstChild);

      const items = [{ lang: '', type: '', label: 'Off' }].concat(
        captionsData.map(c => ({ lang: c.languageCode, type: c.captionType, label: c.languageCode }))
      );
      const PER_ROW = 4;
      const BTN_W = 0.40;
      const BTN_H = 0.16;
      const GAP_X = 0.06;
      const ROW_H = 0.20;
      const rowCount = Math.max(1, Math.ceil(items.length / PER_ROW));

      const bgHeight = 0.18 + rowCount * ROW_H;
      if (bg) bg.setAttribute('height', bgHeight.toFixed(2));
      if (title) title.setAttribute('position', '-0.85 ' + ((bgHeight / 2) - 0.07).toFixed(2) + ' 0.01');

      items.forEach((it, i) => {
        const row = Math.floor(i / PER_ROW);
        const col = i % PER_ROW;
        const xCenter = -((PER_ROW - 1) / 2) * (BTN_W + GAP_X) + col * (BTN_W + GAP_X);
        const yCenter = ((rowCount - 1) / 2) * ROW_H - row * ROW_H - 0.02;

        const btn = document.createElement('a-entity');
        btn.classList.add('vr-btn', 'vr-cc-pick');
        btn.dataset.ccLang = it.lang;
        btn.dataset.ccType = it.type;
        btn.setAttribute('geometry', 'primitive:plane;width:' + BTN_W + ';height:' + BTN_H);
        btn.setAttribute('material', 'color:#2c5282;opacity:0.95');
        btn.setAttribute('position', xCenter.toFixed(3) + ' ' + yCenter.toFixed(3) + ' 0.005');

        const text = document.createElement('a-text');
        text.setAttribute('value', it.label);
        text.setAttribute('align', 'center');
        text.setAttribute('color', '#fff');
        text.setAttribute('width', '2.5');
        text.setAttribute('position', '0 0 0.005');
        btn.appendChild(text);
        buttonsRoot.appendChild(btn);
        // Direct click handler — the global .vr-btn click router only fires
        // vrAction(data-action) or handlePickerTap(data-pick-row); these
        // language buttons have neither, so no double-fire.
        btn.addEventListener('click', () => handleCCPick(it.lang, it.type));
      });
    }
    scene.addEventListener('loaded', renderSubtitlePicker);

    // Parses VTT and SRT. Both share the cue-timing line shape
    //   HH:MM:SS.mmm --> HH:MM:SS.mmm   (VTT uses '.', SRT uses ',')
    // The regex matches [\.,] so a single regex covers both. SRT's bare
    // cue-number lines don't match and are skipped naturally. ASS / SSA
    // / other formats produce zero matches and the picker silently
    // stays at "no cues."
    function parseSubtitles(text) {
      const cues = [];
      const lines = text.split(/\r?\n/);
      for (let i = 0; i < lines.length; i++) {
        const m = lines[i].match(/(\d{2}):(\d{2}):(\d{2})[\.,](\d{3})\s+-->\s+(\d{2}):(\d{2}):(\d{2})[\.,](\d{3})/);
        if (!m) continue;
        const start = (+m[1]) * 3600 + (+m[2]) * 60 + (+m[3]) + (+m[4]) / 1000;
        const end   = (+m[5]) * 3600 + (+m[6]) * 60 + (+m[7]) + (+m[8]) / 1000;
        const payload = [];
        i++;
        while (i < lines.length && lines[i].trim() !== '') {
          payload.push(lines[i].replace(/<[^>]+>/g, ''));
          i++;
        }
        cues.push({ start: start, end: end, text: payload.join('\n') });
      }
      return cues;
    }

    let currentCues = [];
    let currentLang = '';

    function handleCCPick(lang, type) {
      const picker = document.getElementById('vrSubtitlePicker');
      if (picker) picker.setAttribute('visible', false);
      if (!lang) {
        currentCues = [];
        currentLang = '';
        return;
      }
      fetch('/browse/scene/' + encodeURIComponent(sceneId) + '/caption?lang=' + encodeURIComponent(lang) + '&type=' + encodeURIComponent(type))
        .then(r => r.text())
        .then(text => {
          currentCues = parseSubtitles(text);
          currentLang = lang;
        })
        .catch(err => console.warn('stash-vr: caption fetch failed', err));
    }

    // Reparent the subtitle plane based on the active geometry. Cinema mode
    // (vrFlat is the active entity) → child of vrFlat at its bottom edge.
    // Immersive (sphere/fisheye) → child of the camera, in front-low. Use
    // the Three.js object3D parent/add path so we don't fight A-Frame's
    // scene-graph component lifecycle.
    function reparentSubtitlePlane() {
      const subEl = document.getElementById('vrSubtitlePlane');
      if (!subEl || !subEl.object3D) return;
      const active = activeGeometry();
      let targetObj = null;
      if (active && active.id === 'vrFlat' && active.object3D) {
        targetObj = active.object3D;
        subEl.object3D.position.set(0, -1.0, 0.01);
      } else {
        const cam = scene.camera;
        if (!cam) return;
        targetObj = cam;
        subEl.object3D.position.set(0, -0.5, -1.5);
      }
      if (subEl.object3D.parent !== targetObj) {
        if (subEl.object3D.parent) subEl.object3D.parent.remove(subEl.object3D);
        targetObj.add(subEl.object3D);
      }
    }

    function tickSubtitles() {
      const plane = document.getElementById('vrSubtitlePlane');
      if (!plane) return;
      if (!currentCues.length) {
        plane.setAttribute('visible', 'false');
        return;
      }
      reparentSubtitlePlane();
      const t = video.currentTime || 0;
      let active = null;
      for (let i = 0; i < currentCues.length; i++) {
        if (t >= currentCues[i].start && t <= currentCues[i].end) {
          active = currentCues[i];
          break;
        }
      }
      if (active) {
        const txt = document.getElementById('vrSubtitleText');
        if (txt) txt.setAttribute('text', 'value', active.text);
        plane.setAttribute('visible', 'true');
      } else {
        plane.setAttribute('visible', 'false');
      }
    }

    // Single rAF loop drives all per-frame work (Tasks 4 + 5 hook in here).
    // Each tick wrapped in try/catch so one ticker's error doesn't kill the
    // loop and freeze every per-frame UI update.
    function rafLoop() {
      const now = performance.now();
      try { tickTimeDisplay(now); } catch (e) { console.warn('stash-vr: tickTimeDisplay', e); }
      try { tickSliders(); }       catch (e) { console.warn('stash-vr: tickSliders', e); }
      try { tickScrubBar(); }      catch (e) { console.warn('stash-vr: tickScrubBar', e); }
      try { tickSubtitles(); }     catch (e) { console.warn('stash-vr: tickSubtitles', e); }
      requestAnimationFrame(rafLoop);
    }
    requestAnimationFrame(rafLoop);

    // tickBrowseScroll reads laser raycaster intersections — those are
    // updated by A-Frame's raycaster component during the scene tick,
    // which runs AFTER our window.requestAnimationFrame callback. So we
    // can't read them from rafLoop or we'll see stale/empty data. Run
    // the browse-scroll tick from an A-Frame component instead, whose
    // tick() fires inside the scene tick — i.e. after the raycaster has
    // updated its intersections array for this frame.
    AFRAME.registerComponent('m4c-browse-tick', {
      tick: function () {
        try { tickBrowseScroll(); } catch (e) { console.warn('stash-vr: tickBrowseScroll', e); }
      },
    });
    scene.setAttribute('m4c-browse-tick', '');

    // ============================================================
    // Scrub bar: per-frame fill/thumb advance, drag-to-seek, scene
    // marker dots with jump-on-click + tooltip-on-hover.
    // ============================================================

    // Bar geometry: centered at x=0 inside vrScrubBar; left/right map to
    // -1.4..+1.4 in panel-local space.
    const SCRUB_BAR_W = 2.8;
    const SCRUB_BAR_LEFT = -1.4;

    // null when the scene has no markers (server emits JSON null). Coerce to
    // [] so .length / forEach are always safe.
    const sceneMarkers = {{ marshal .SceneMarkers }} || [];
    const sceneDurationSec = {{ printf "%f" .DurationSec }};

    function tForMarkerX(secs) {
      if (!sceneDurationSec) return SCRUB_BAR_LEFT;
      return SCRUB_BAR_LEFT + (secs / sceneDurationSec) * SCRUB_BAR_W;
    }

    function tickScrubBar() {
      const dur = isFinite(video.duration) && video.duration > 0
        ? video.duration
        : sceneDurationSec;
      if (!dur) return;
      const t = Math.max(0, Math.min(dur, video.currentTime || 0));
      const fillW = Math.max(0.001, (t / dur) * SCRUB_BAR_W);
      const fill = document.getElementById('vrScrubFill');
      const thumb = document.getElementById('vrScrubThumb');
      if (fill) {
        fill.setAttribute('width', fillW);
        // Plane is centered on its position; shift x so the left edge stays at SCRUB_BAR_LEFT.
        fill.setAttribute('position', { x: SCRUB_BAR_LEFT + fillW / 2, y: 0, z: 0.001 });
      }
      if (thumb) {
        thumb.setAttribute('position', { x: SCRUB_BAR_LEFT + (t / dur) * SCRUB_BAR_W, y: 0, z: 0.005 });
      }
    }

    let scrubActive = false;
    let scrubLastWriteMs = 0;
    const SCRUB_THROTTLE_MS = 80;

    function cursorToScrubT(intersection) {
      const bar = document.getElementById('vrScrubBar');
      if (!bar || !bar.object3D || !intersection || !intersection.point) return null;
      const local = bar.object3D.worldToLocal(intersection.point.clone());
      const ratio = Math.max(0, Math.min(1, (local.x - SCRUB_BAR_LEFT) / SCRUB_BAR_W));
      const dur = isFinite(video.duration) && video.duration > 0
        ? video.duration
        : sceneDurationSec;
      if (!dur) return null;
      return ratio * dur;
    }

    function setVideoTime(t, throttle) {
      const now = performance.now();
      if (throttle && now - scrubLastWriteMs < SCRUB_THROTTLE_MS) return;
      scrubLastWriteMs = now;
      video.currentTime = t;
    }

    // Marker tooltip: a single floating <a-text> reused across all markers.
    // Built lazily inside an IIFE so the bar element exists at attach time.
    const markerTip = (function() {
      const t = document.createElement('a-text');
      t.setAttribute('id', 'vrScrubMarkerTip');
      t.setAttribute('color', '#fff');
      t.setAttribute('width', '3');
      t.setAttribute('align', 'center');
      t.setAttribute('value', '');
      t.setAttribute('visible', 'false');
      t.setAttribute('position', '0 0.10 0.01');
      const bar = document.getElementById('vrScrubBar');
      if (bar) bar.appendChild(t);
      return t;
    })();

    function bindScrubElement(el) {
      el.addEventListener('mousedown', function(evt) {
        const intersection = evt.detail && evt.detail.intersection;
        // Marker click: jump to the marker's seconds and finish (no drag).
        if (el.classList.contains('vr-scrub-marker')) {
          const secs = parseFloat(el.dataset.markerSeconds);
          if (!isNaN(secs)) setVideoTime(secs, false);
          scrubActive = false;
          return;
        }
        scrubActive = true;
        if (intersection) {
          const t = cursorToScrubT(intersection);
          if (t !== null) setVideoTime(t, false);
        }
      });
      el.addEventListener('mouseup', function() { scrubActive = false; });
    }

    function bindMarkerTooltip(el) {
      el.addEventListener('raycaster-intersected', function() {
        markerTip.setAttribute('text', 'value', el.dataset.markerTitle || '');
        const pos = el.getAttribute('position');
        const x = (pos && typeof pos === 'object') ? pos.x : 0;
        markerTip.setAttribute('position', x.toFixed(3) + ' 0.10 0.01');
        markerTip.setAttribute('visible', 'true');
      });
      el.addEventListener('raycaster-intersected-cleared', function() {
        markerTip.setAttribute('visible', 'false');
      });
    }

    // Bind bar+thumb at script-start (they exist in the static markup).
    document.querySelectorAll('.vr-scrub, .vr-scrub-bg').forEach(bindScrubElement);

    function buildSceneMarkerDots() {
      const root = document.getElementById('vrScrubMarkers');
      if (!root) return;
      while (root.firstChild) root.removeChild(root.firstChild);
      if (!sceneDurationSec || !sceneMarkers || !sceneMarkers.length) return;
      sceneMarkers.forEach(m => {
        const x = tForMarkerX(m.seconds);
        const dot = document.createElement('a-entity');
        dot.classList.add('vr-btn', 'vr-scrub-marker');
        dot.setAttribute('data-marker-seconds', m.seconds);
        dot.setAttribute('data-marker-title', m.title || '');
        dot.setAttribute('geometry', 'primitive:circle;radius:0.03');
        dot.setAttribute('material', 'color:#f7b500;opacity:0.95');
        dot.setAttribute('position', x.toFixed(3) + ' 0 0.003');
        root.appendChild(dot);
        bindScrubElement(dot);
        bindMarkerTooltip(dot);
      });
    }
    scene.addEventListener('loaded', buildSceneMarkerDots);

    // Drag sampling happens in tickSliders() inside rafLoop. Keep the
    // cleared listener so a laser that leaves all targets mid-drag ends
    // the scrub cleanly (mouseup may fire on nothing).
    ['vrLaserRight', 'vrLaserLeft'].forEach(id => {
      const laser = document.getElementById(id);
      if (!laser) return;
      laser.addEventListener('raycaster-intersection-cleared', function() {
        scrubActive = false;
      });
    });

    // Backstop: any mouseup ends the scrub drag.
    scene.addEventListener('mouseup', function() { scrubActive = false; });

    // ============================================================
    // Picker state + handlers.
    //
    // Initial state derived from the server-rendered Projection
    // (read off <a-scene>'s data-stereo, vrFisheye's data-fov, and
    // the visibility of the four render entities). The user picks
    // one button per row; on every tap we (a) re-bind the renderer
    // locally, (b) POST the new selection so Stash tags update,
    // (c) update the active-highlight per row.
    // ============================================================

    const sceneId = (function() {
      const m = location.pathname.match(/\/browse\/scene\/([^\/]+)/);
      return m ? m[1] : '';
    })();
    const pickerState = computeInitialPickerState();

    // computeInitialPickerState reads the server-rendered Projection
    // straight off <a-scene>'s data-* attrs. Reading entity `visible`
    // here would be wrong: at script-execution time A-Frame hasn't
    // parsed it yet, so getAttribute returns the raw HTML string
    // ("true"/"false") — both truthy in JS — which makes every
    // condition fire on the first branch.
    function computeInitialPickerState() {
      const stereoAttr = scene.dataset.stereo || '';
      const geom       = scene.dataset.geometry || '';
      const fov        = parseFloat(scene.dataset.fov || '0');
      let type = 'Normal', degree = '180', stereo = 'SBS';
      if (geom === '') {
        type = 'Normal'; degree = 'Cinema'; stereo = '2D';
      } else if (geom === 'fisheye') {
        type = 'FishEye';
        degree = (fov >= 200 ? '200' : '180');
      } else if (geom === 'equirectangular' && fov === 360) {
        type = 'Normal'; degree = '360';
      } else if (geom === 'equirectangular') {
        type = 'Normal'; degree = '180';
      }
      if (degree === 'Cinema') {
        stereo = '2D';
      } else if (stereoAttr === 'sbs') {
        stereo = 'SBS';
      } else if (stereoAttr === 'tb') {
        stereo = 'TB';
      } else {
        stereo = '2D';
      }
      return { type, degree, stereo, initial: null };
    }
    pickerState.initial = { type: pickerState.type, degree: pickerState.degree, stereo: pickerState.stereo };

    // Apply current pickerState: update data attrs, toggle entity
    // visibility, reset boundVR flags so applyAll rebinds, then
    // recompute the per-row highlights and disabled state.
    function applyPickerState() {
      const isFishEye = pickerState.type === 'FishEye';
      const isCinema  = pickerState.degree === 'Cinema';
      const isNormal  = pickerState.type === 'Normal';

      // Cinema forces stereo=2D regardless of the user's Stereo pick.
      const effectiveStereo = isCinema ? '2D' : pickerState.stereo;
      const stereoData = effectiveStereo === 'SBS' ? 'sbs' :
                         effectiveStereo === 'TB'  ? 'tb'  : '';
      scene.dataset.stereo = stereoData;

      // Decide which render entity is active.
      let activeId = 'vrFlat';
      if (!isCinema) {
        if (isFishEye) {
          activeId = 'vrFisheye';
          const fovEl = document.getElementById('vrFisheye');
          if (fovEl) fovEl.dataset.fov = (pickerState.degree === '200' ? '200' : '180');
          if (fovEl) fovEl.dataset.cant = '0'; // user-picked fisheye is plain fisheye
        } else if (isNormal && pickerState.degree === '360') {
          activeId = 'vrSphere360';
        } else if (isNormal && pickerState.degree === '180') {
          activeId = 'vrSphere180';
        }
      }
      ['vrSphere180', 'vrSphere360', 'vrFisheye', 'vrFlat'].forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        el.setAttribute('visible', id === activeId);
        // Reset bind flag so applyAll re-creates the material with
        // the right offsets (sphere) or re-creates the shader
        // (fisheye) for the new geometry/fov.
        const mesh = el.getObject3D('mesh');
        if (mesh) mesh.userData.boundVR = false;
      });
      applyAll();

      updatePickerHighlights();
      updatePickerDisabled();
    }

    function updatePickerHighlights() {
      document.querySelectorAll('.picker-btn').forEach(b => {
        const row = b.dataset.pickRow;
        const value = b.dataset.pickValue;
        const isActive = (row !== 'auto' && pickerState[row] === value);
        b.setAttribute('material', 'color: ' + (isActive ? '#3776c2' : '#2c5282') + '; opacity: 0.95');
      });
    }

    function isInvalidCombo(row, value) {
      // Cinema is only valid with Type=Normal.
      if (row === 'degree' && value === 'Cinema' && pickerState.type === 'FishEye') return true;
      // 200 is only valid with Type=FishEye.
      if (row === 'degree' && value === '200' && pickerState.type === 'Normal') return true;
      // 360 is only valid with Type=Normal.
      if (row === 'degree' && value === '360' && pickerState.type === 'FishEye') return true;
      // When degree is Cinema, all stereo other than 2D is moot but not "invalid" per se
      // — leave them tappable; tapping a Stereo button while Cinema doesn't change render
      // (Cinema forces 2D in applyPickerState). No styling change for these.
      return false;
    }

    function updatePickerDisabled() {
      document.querySelectorAll('.picker-btn').forEach(b => {
        const row = b.dataset.pickRow;
        const value = b.dataset.pickValue;
        if (row === 'auto') return;
        const disabled = isInvalidCombo(row, value);
        if (disabled) {
          b.setAttribute('material', 'color: #444; opacity: 0.4');
          b.dataset.disabled = '1';
        } else {
          delete b.dataset.disabled;
          // Active-highlight setter in updatePickerHighlights will
          // set the right color; this branch only ensures non-disabled
          // buttons aren't stuck at the disabled color.
        }
      });
    }

    // Single in-flight lock for POST. Rapid taps coalesce — the latest
    // pickerState wins; intermediate POSTs that haven't started yet
    // are skipped.
    let postInFlight = false;
    let postPending  = null;
    function postProjection(body) {
      postPending = body;
      if (postInFlight) return;
      const send = () => {
        const next = postPending;
        if (!next) { postInFlight = false; return; }
        postPending = null;
        postInFlight = true;
        fetch('/browse/scene/' + encodeURIComponent(sceneId) + '/projection', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(next)
        }).then(resp => {
          if (!resp.ok) console.warn('stash-vr: projection POST returned', resp.status);
        }).catch(err => {
          console.warn('stash-vr: projection POST failed', err);
        }).finally(() => {
          postInFlight = false;
          if (postPending) send();
        });
      };
      send();
    }

    function handlePickerTap(row, value) {
      // Auto: revert pickerState to initial, re-apply, POST {auto:true}.
      if (row === 'auto') {
        pickerState.type   = pickerState.initial.type;
        pickerState.degree = pickerState.initial.degree;
        pickerState.stereo = pickerState.initial.stereo;
        applyPickerState();
        postProjection({ auto: true });
        return;
      }
      // Disabled buttons no-op.
      const btnEl = document.querySelector('.picker-btn[data-pick-row="' + row + '"][data-pick-value="' + value + '"]');
      if (btnEl && btnEl.dataset.disabled === '1') return;
      // Update state.
      pickerState[row] = value;
      // Picking Type may invalidate current Degree — auto-correct to a
      // valid neighbor so the resulting Projection is renderable.
      if (row === 'type') {
        if (value === 'FishEye' && (pickerState.degree === 'Cinema' || pickerState.degree === '360')) {
          pickerState.degree = '180';
        }
        if (value === 'Normal' && pickerState.degree === '200') {
          pickerState.degree = '180';
        }
      }
      applyPickerState();
      postProjection({
        type:   pickerState.type,
        degree: pickerState.degree,
        stereo: pickerState.stereo
      });
    }

    // Initial highlight + disabled-state pass once A-Frame is ready.
    scene.addEventListener('loaded', function() {
      updatePickerHighlights();
      updatePickerDisabled();
    });

    function show2D() {
      scene.style.display = 'none';
      [...wrap.children].forEach(el => {
        if (el !== scene) el.style.display = '';
      });
    }
    function hide2D() {
      applyAll();
      [...wrap.children].forEach(el => {
        if (el !== scene && el !== video) el.style.display = 'none';
      });
      scene.style.display = '';
    }

    btn.addEventListener('click', () => {
      hide2D();
      // The click is a user gesture, so unmuted-with-sound playback is
      // permitted from here. play() is a no-op if already playing.
      const playPromise = video.play();
      if (playPromise && playPromise.catch) {
        playPromise.catch(err => console.warn('stash-vr: video play failed', err));
      }
      if (typeof scene.enterVR !== 'function') {
        console.warn('stash-vr: a-scene not ready');
        show2D();
        return;
      }
      scene.enterVR().catch(err => {
        console.warn('stash-vr: enterVR failed', err);
        show2D();
      });
    });
    scene.addEventListener('exit-vr', show2D);
  })();
</script>
{{end}}
<h1>{{.Title}}</h1>
<div class="meta">
{{range .Performers}}<a class="chip chip-perf" href="/browse/perf/{{.ID}}">{{.Name}}</a>{{end}}
{{with .Studio}}<a class="chip chip-studio" href="/browse/studio/{{.ID}}">{{.Name}}</a>{{end}}
{{if .Date}}<span class="meta-text">{{.Date}}</span>{{end}}
{{if .Duration}}<span class="meta-text">{{.Duration}}</span>{{end}}
</div>

<div class="section">
<h2>Rating</h2>
<form method="post" action="/browse/scene/{{.ID}}/rating" class="js-mut stars">
<span class="stars-fill">
{{range $i, $_ := .StarSlice}}
{{- $star := sub 5 $i -}}
<button name="value" value="{{$star}}"{{if eq $star $.Rating1to5}} class="on"{{end}}>★</button>
{{end}}
</span>
{{if .Rating1to5}}<button name="value" value="0" class="clear" title="Clear rating">✕</button>{{end}}
</form>
</div>

<div class="section">
<h2>Favorite</h2>
<form method="post" action="/browse/scene/{{.ID}}/favorite" class="js-mut fav" style="display:inline-flex">
<button class="{{if .IsFavorite}}on{{end}}">♥ {{if .IsFavorite}}Favorited{{else}}Favorite{{end}}</button>
</form>
</div>

<div class="section">
<h2>Tags</h2>
<template id="tag-chip-tpl">
<span class="chip"><a></a><form method="post" class="js-mut" style="display:inline"><button name="tag">✕</button></form></span>
</template>
<div class="tags">
{{range .Tags}}
<span class="chip"><a href="/browse/tag/{{.ID}}">{{.Name}}</a><form method="post" action="/browse/scene/{{$.ID}}/tags/remove" class="js-mut" style="display:inline"><button name="tag" value="{{.Name}}">✕</button></form></span>
{{end}}
<form method="post" action="/browse/scene/{{.ID}}/tags/add" class="js-mut addtag">
<input list="all-tags" name="tag" placeholder="Add tag…" autocomplete="off">
<datalist id="all-tags">
{{range .AllTagNames}}<option value="{{.}}">{{end}}
</datalist>
<button>Add</button>
</form>
</div>
</div>

<div class="section">
<h2>O-Counter</h2>
<form method="post" action="/browse/scene/{{.ID}}/o/decrement" style="display:inline-flex" class="js-mut ocount">
<button>−</button>
</form>
<span id="ocount-value" style="display:inline-flex;align-items:center;padding:0 12px">{{.OCounter}}</span>
<form method="post" action="/browse/scene/{{.ID}}/o/increment" style="display:inline-flex" class="js-mut ocount">
<button>+</button>
</form>
</div>

<div class="section">
<h2>Organized</h2>
<form method="post" action="/browse/scene/{{.ID}}/organized" class="js-mut org" style="display:inline-flex">
<button class="{{if .Organized}}on{{end}}">{{if .Organized}}✓ Organized{{else}}Mark organized{{end}}</button>
</form>
</div>

</div>
<script>
(function() {
  const sceneId = (function() {
    const m = location.pathname.match(/\/browse\/scene\/([^\/]+)/);
    return m ? m[1] : '';
  })();
  if (!sceneId) return;

  const errBanner = document.getElementById('errbanner');
  let errTimer = null;
  function showErr(msg) {
    if (!errBanner) return;
    errBanner.textContent = msg;
    errBanner.hidden = false;
    if (errTimer) clearTimeout(errTimer);
    errTimer = setTimeout(() => { errBanner.hidden = true; errBanner.textContent = ''; }, 5000);
  }
  function clearErr() {
    if (!errBanner) return;
    errBanner.hidden = true;
    errBanner.textContent = '';
    if (errTimer) { clearTimeout(errTimer); errTimer = null; }
  }

  // Rebuild the chip list from state.tags. Preserves the add-tag form,
  // which sits as a sibling to the chip spans inside .tags.
  function renderTags(state) {
    const tagsRoot = document.querySelector('.tags');
    if (!tagsRoot) return;
    const tpl = document.getElementById('tag-chip-tpl');
    // Remove existing chip spans only (keep the addtag <form>).
    tagsRoot.querySelectorAll('span.chip').forEach(el => el.remove());
    const addForm = tagsRoot.querySelector('form.addtag');
    (state.tags || []).forEach(t => {
      const node = tpl.content.firstElementChild.cloneNode(true);
      const a = node.querySelector('a');
      a.href = '/browse/tag/' + encodeURIComponent(t.id);
      a.textContent = t.name;
      const form = node.querySelector('form');
      form.action = '/browse/scene/' + encodeURIComponent(sceneId) + '/tags/remove';
      const btn = form.querySelector('button[name="tag"]');
      btn.value = t.name;
      bindForm(form);
      tagsRoot.insertBefore(node, addForm);
    });
  }

  // Rating: clear all .on, set .on on the button matching state.rating1to5;
  // show/hide the ✕ clear button.
  function renderRating(state) {
    const form = document.querySelector('form.stars');
    if (!form) return;
    form.querySelectorAll('.stars-fill button').forEach(b => {
      b.classList.toggle('on', parseInt(b.value, 10) === state.rating1to5);
    });
    let clearBtn = form.querySelector('button.clear');
    if (state.rating1to5 > 0) {
      if (!clearBtn) {
        clearBtn = document.createElement('button');
        clearBtn.name = 'value';
        clearBtn.value = '0';
        clearBtn.className = 'clear';
        clearBtn.title = 'Clear rating';
        clearBtn.textContent = '✕';
        form.appendChild(clearBtn);
      }
    } else if (clearBtn) {
      clearBtn.remove();
    }
  }

  function renderFavorite(state) {
    const form = document.querySelector('form.fav');
    if (!form) return;
    const btn = form.querySelector('button');
    if (!btn) return;
    btn.classList.toggle('on', !!state.isFavorite);
    btn.textContent = state.isFavorite ? '♥ Favorited' : '♥ Favorite';
  }

  function renderOCounter(state) {
    const span = document.getElementById('ocount-value');
    if (span) span.textContent = state.oCounter;
  }

  function renderOrganized(state) {
    const form = document.querySelector('form.org');
    if (!form) return;
    const btn = form.querySelector('button');
    if (!btn) return;
    btn.classList.toggle('on', !!state.organized);
    btn.textContent = state.organized ? '✓ Organized' : 'Mark organized';
  }

  function applyState(state) {
    clearErr();
    if (state.err) { showErr(state.err); return; }
    renderRating(state);
    renderFavorite(state);
    renderTags(state);
    renderOCounter(state);
    renderOrganized(state);
  }

  function bindForm(form) {
    if (form._mutBound) return;
    form._mutBound = true;
    form.addEventListener('submit', function(ev) {
      ev.preventDefault();
      const submitBtn = ev.submitter;
      const fd = new FormData(form);
      // <button name="value" value="N"> in the rating form is not picked up
      // by FormData unless it's the submitter — guard for that:
      if (submitBtn && submitBtn.name && !fd.has(submitBtn.name)) {
        fd.set(submitBtn.name, submitBtn.value);
      }
      fetch(form.action, {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: fd
      }).then(r => r.json().then(j => ({ ok: r.ok, body: j })))
        .then(({ ok, body }) => {
          if (!ok) { showErr(body.err || 'request failed'); return; }
          applyState(body);
          // Clear the add-tag input on success.
          if (form.classList.contains('addtag')) {
            const input = form.querySelector('input[name="tag"]');
            if (input) input.value = '';
          }
        })
        .catch(err => showErr('network error: ' + err.message));
    });
  }

  document.querySelectorAll('form.js-mut').forEach(bindForm);
})();
</script>
</body>
</html>
