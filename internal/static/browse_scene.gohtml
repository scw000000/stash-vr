<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} — stash-vr browse</title>
<style>
:root { color-scheme: dark; }
* { box-sizing: border-box; }
body { margin: 0; font-family: system-ui, sans-serif; background: #111; color: #eee; }
.wrap { max-width: 800px; margin: 0 auto; padding: 16px; }
.back { color: #9cf; text-decoration: none; display: inline-block; margin-bottom: 12px; }
.errbanner { background: #5a1a1a; padding: 8px 12px; border-radius: 4px; margin-bottom: 12px; }
.thumb { width: 100%; max-height: 480px; object-fit: contain; background: #000; border-radius: 6px; margin-bottom: 16px; }
h1 { font-size: 1.4rem; margin: 0 0 8px 0; }
.meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 24px; }
.meta .meta-text { color: #aaa; }
a.chip { color: #ddd; text-decoration: none; }
a.chip:hover { background: #3a3a3a; }
.chip a { color: inherit; text-decoration: none; }
.chip a:hover { color: #fff; }
.section { margin-bottom: 20px; }
.section h2 { font-size: 0.85rem; text-transform: uppercase; color: #888; margin: 0 0 8px 0; letter-spacing: 0.05em; }

.stars { display: inline-flex; gap: 4px; align-items: center; }
.stars-fill { display: inline-flex; flex-direction: row-reverse; gap: 4px; }
.stars button { background: transparent; border: none; font-size: 1.5rem; color: #555; cursor: pointer; padding: 0 2px; }
.stars-fill button:hover,
.stars-fill button:hover ~ button,
.stars-fill button.on,
.stars-fill button.on ~ button { color: #f7b500; }
.stars button.clear { font-size: 1rem; margin-left: 8px; color: #888; }
.stars button.clear:hover { color: #f55; }

.fav button { background: transparent; border: 1px solid #555; color: #ccc; padding: 6px 12px; border-radius: 4px; cursor: pointer; }
.fav button.on { background: #c11; border-color: #c11; color: #fff; }

.tags { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.chip { background: #2a2a2a; padding: 4px 4px 4px 10px; border-radius: 999px; display: inline-flex; align-items: center; gap: 4px; }
.chip-perf { background: #2a2a2a; }
.chip-studio { background: #2a2a3a; }
.chip button { background: transparent; border: none; color: #aaa; cursor: pointer; padding: 2px 6px; }
.chip button:hover { color: #f55; }
.addtag { display: inline-flex; gap: 4px; }
.addtag input { background: #1a1a1a; border: 1px solid #333; color: #eee; padding: 4px 8px; border-radius: 4px; }
.addtag button { background: #2c5282; border: none; color: #fff; padding: 4px 12px; border-radius: 4px; cursor: pointer; }

.ocount { display: inline-flex; align-items: center; gap: 8px; }
.ocount button { background: #2a2a2a; border: none; color: #eee; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 1.1rem; }
.ocount span { font-size: 1.1rem; min-width: 24px; text-align: center; }

.org button { background: transparent; border: 1px solid #555; color: #ccc; padding: 6px 12px; border-radius: 4px; cursor: pointer; }
.org button.on { background: #2c5282; border-color: #2c5282; color: #fff; }

.player { width: 100%; max-height: 70vh; background: #000; border-radius: 6px; margin-bottom: 16px; }
.btn-vr { display: block; width: 100%; padding: 14px; margin-bottom: 24px; background: #2c5282; color: #fff; border: none; border-radius: 6px; font-size: 1.05rem; font-weight: 600; cursor: pointer; }
.btn-vr:hover { background: #3776c2; }
</style>
</head>
<body>
<div class="wrap">
<a class="back" href="{{.BackURL}}">← Back</a>
<div class="errbanner" id="errbanner" hidden></div>
{{if .DirectStreamURL}}
<video id="sceneVideo" class="player" controls playsinline autoplay preload="metadata" src="{{.DirectStreamURL}}"{{if .ThumbnailURL}} poster="{{.ThumbnailURL}}"{{end}}></video>
{{else if .ThumbnailURL}}
<img class="thumb" src="{{.ThumbnailURL}}" alt="">
{{end}}

{{if .DirectStreamURL}}
<button id="enterVR" class="btn-vr" type="button">{{if .Projection.Geometry}}▥ Enter VR{{else}}▥ Watch on virtual screen{{end}}</button>

<!-- Hidden text-input buffer for in-VR search. Quest's Meta Browser
     refuses the WebXR DOM Overlay Module so we can't show an HTML
     <input> on top of the XR content; however focusing this input
     from JS still pops the system VR keyboard, and `input` events
     still deliver the typed value. We mirror it onto the curved
     search-bar label inside the scene. Sibling of <a-scene>, not a
     child — A-Frame doesn't care for unknown DOM children. -->
<input id="vrSearchInput" type="text" autocomplete="off" inputmode="search"
       style="position:fixed; top:-1000px; left:-1000px; opacity:0; width:1px; height:1px; pointer-events:none;" />

<a-scene id="vrScene" embedded style="display:none" vr-mode-ui="enabled: true" loading-screen="enabled: false" renderer="alpha: true" webxr="optionalFeatures: layers" data-stereo="{{.Projection.Stereo}}" data-geometry="{{.Projection.Geometry}}" data-fov="{{.Projection.FOV}}">
  <a-entity camera position="0 1.6 0"></a-entity>
  <!--
    All four render entities are always emitted. JS toggles visibility
    based on the active Projection. The initial visibility below
    matches the server-side detected Projection so the page renders
    correctly before any JS runs.
  -->
  <a-entity id="vrSphere180"
            visible="{{if and (eq .Projection.Geometry "equirectangular") (eq .Projection.FOV 180)}}true{{else}}false{{end}}"
            geometry="primitive:sphere;radius:100;phiStart:180;phiLength:180;thetaLength:180;segmentsWidth:64;segmentsHeight:64"></a-entity>
  <a-entity id="vrSphere360"
            visible="{{if and (eq .Projection.Geometry "equirectangular") (eq .Projection.FOV 360)}}true{{else}}false{{end}}"
            geometry="primitive:sphere;radius:100;segmentsWidth:64;segmentsHeight:64"></a-entity>
  <a-entity id="vrFisheye"
            visible="{{if eq .Projection.Geometry "fisheye"}}true{{else}}false{{end}}"
            data-fov="{{if eq .Projection.Geometry "fisheye"}}{{.Projection.FOV}}{{else}}180{{end}}"
            data-cant="{{.Projection.Cant}}"
            geometry="primitive:sphere;radius:100;segmentsWidth:64;segmentsHeight:64"></a-entity>
  <a-entity id="vrFlat"
            visible="{{if not .Projection.Geometry}}true{{else}}false{{end}}"
            geometry="primitive:plane;width:4;height:2.25"
            position="0 1.6 -3"></a-entity>

  <!-- All in-VR control surfaces (playback panel, Format picker, help panel)
       live under this wrapper so M3c can toggle them as a unit. Hidden by
       default; trigger summons. -->
  <a-entity id="vrControlsRoot" visible="false">

  <!-- In-VR playback controls. Shares the browse panel's cylinder sweep so
       the playback shell visually continues from the grid with no hard seam. -->
  <a-entity id="vrControls" position="0 -0.107 -2.096" rotation="-15 0 0">
    <a-cylinder class="vr-panel-bg"
                radius="3.02"
                height="0.72"
                position="0 0 3.02"
                theta-start="137.5"
                theta-length="85"
                open-ended="true"
                material="shader: flat; side: double; color: #000; opacity: 0.95">
    </a-cylinder>

    <!-- Row 1 (top): title left, time right, tiny DBG button at far
         right (toggles the M4c diagnostic overlay; default off). -->
    <a-entity id="vrTitle" position="0 0.28 3.02" data-full-value="{{.Title}}" data-display-value=""></a-entity>
    <a-entity id="vrTime" position="0 0.28 3.02" data-display-value="0:00 / 0:00"></a-entity>
    <a-entity class="vr-btn" id="vrDebugBtn" data-action="toggle-debug-overlay" position="1.50 0.28 0.01"
              geometry="primitive:plane;width:0.18;height:0.10"
              material="color:#444;opacity:0.85">
      <a-text value="DBG" align="center" color="#ff0" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>

    <!-- Row 2: scrub bar (drag thumb to seek; click bar to seek; click marker dot to jump).
         All four cylinders share the panel hub axis so they form concentric arcs
         lying on the panel surface; projectPlaybackPanel rewrites their positions
         from the shared constants at scene load. -->
    <a-entity id="vrScrubBar" position="0 0.04 0.01">
      <a-cylinder id="vrScrubTint" radius="3.02" height="0.10" position="0 0 3.011"
                  theta-start="152.39" theta-length="55.22" open-ended="true"
                  material="shader: flat; side: front; color: #fff; opacity: 0.18; transparent: true; depthWrite: false"></a-cylinder>
      <a-cylinder id="vrScrubRail" radius="3.02" height="0.04" position="0 0 3.012"
                  theta-start="152.39" theta-length="55.22" open-ended="true"
                  material="shader: flat; side: double; color: #444; opacity: 0.95"></a-cylinder>
      <a-cylinder id="vrScrubFill" radius="3.02" height="0.04" position="0 0 3.013"
                  theta-start="207.46" theta-length="0.15" open-ended="true"
                  material="shader: flat; side: front; color: #3776c2; opacity: 0.55; transparent: true; depthWrite: false"></a-cylinder>
      <!-- Curved hit cylinder follows the rail's arc so the laser intersects it
           wherever the user aims at the visible rail. A flat plane would tilt
           up off the rail in world Y because of vrControls' -15° X rotation. -->
      <a-cylinder class="vr-scrub-bg vr-btn" data-action="scrub-bg" radius="3.02" height="0.10"
                  position="0 0 3.014" theta-start="152.39" theta-length="55.22" open-ended="true"
                  material="opacity:0;transparent:true;shader:flat;depthWrite:false;side:double"></a-cylinder>
      <a-entity id="vrScrubMarkers"></a-entity>
      <a-entity id="vrScrubThumb" class="vr-btn vr-scrub" data-action="scrub"
                geometry="primitive:plane;width:0.05;height:0.10"
                material="color:#fff" position="-1.4 0 0.38"></a-entity>
    </a-entity>

    <!-- Row 3 (bottom): volume widget on the left, then 7 buttons. -->
    <!-- Volume icon (mute toggle) -->
    <a-entity class="vr-btn" id="vrMuteBtn" data-action="mute" position="-1.40 -0.20 0.01"
              geometry="primitive:plane;width:0.18;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-image id="vrMuteIconOn"  width="0.14" height="0.14" position="0 0 0.005"></a-image>
      <a-image id="vrMuteIconOff" width="0.14" height="0.14" position="0 0 0.005" visible="false"></a-image>
    </a-entity>
    <!-- Volume slider track + fill + thumb -->
    <a-entity id="vrVolumeSlider" position="-0.96 -0.20 0.01">
      <a-plane class="vr-vol-track vr-btn" data-action="vol-track" width="0.40" height="0.04"
               color="#444" material="opacity:0.95"></a-plane>
      <a-plane id="vrVolumeFill" width="0.40" height="0.04" color="#3776c2"
               material="opacity:0.95" position="0 0 0.001"></a-plane>
      <a-entity id="vrVolumeThumb" class="vr-btn vr-vol-thumb" data-action="vol-track"
                geometry="primitive:plane;width:0.04;height:0.10"
                material="color:#fff" position="0.20 0 0.005"></a-entity>
    </a-entity>

    <!-- 8 buttons to the right of the volume widget (Browse added in M4c). -->
    <a-entity class="vr-btn" data-action="cc" id="vrCCBtn" position="-0.55 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95"
              visible="{{if .Captions}}true{{else}}false{{end}}">
      <a-text value="CC" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn" id="vrPlayPauseBtn" data-action="playpause" position="-0.25 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-image id="vrPlayIcon"  width="0.14" height="0.14" position="0 0 0.005"></a-image>
      <a-image id="vrPauseIcon" width="0.14" height="0.14" position="0 0 0.005" visible="false"></a-image>
    </a-entity>
    <a-entity class="vr-btn" id="vrSpeedBtn" data-action="speed" position="0.05 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-text id="vrSpeedLabel" value="1.0x" align="center" color="#fff" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn" data-action="loop" id="vrLoopBtn" position="0.35 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-image id="vrLoopIcon" width="0.14" height="0.14" position="0 0 0.005"></a-image>
    </a-entity>
    <a-entity class="vr-btn" id="vrBrowseBtn" data-action="browse" position="0.65 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-text value="Browse" align="center" color="#fff" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn" id="vrFormatBtn" data-action="format" position="0.95 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-image id="vrFormatIcon" width="0.16" height="0.14" position="0 0 0.005"></a-image>
    </a-entity>
    <a-entity class="vr-btn" id="vrHelpBtn" data-action="help" position="1.25 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#2c5282;opacity:0.95">
      <a-text value="?" align="center" color="#fff" width="3.5" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn" id="vrExitBtn" data-action="exit" position="1.55 -0.20 0.01"
              geometry="primitive:plane;width:0.26;height:0.20"
              material="color:#a01010;opacity:0.95">
      <a-image id="vrExitIcon" width="0.14" height="0.14" position="0 0 0.005"></a-image>
    </a-entity>

  </a-entity>

  <!--
    In-VR projection picker. Hidden by default; toggled by the Format
    button on the playback panel. Three rows (Type, Degree, Stereo)
    of mutually-exclusive buttons + an Auto button that re-detects.
    Each preset button has data-pick-row and data-pick-value attrs that
    the JS tap handler reads to update state.
  -->
  <a-entity id="vrFormatPicker" position="0 0.830 -2.347" rotation="-15 0 0" visible="false">
    <a-cylinder class="vr-panel-bg"
                radius="3.02"
                height="1.22"
                position="0 0 3.02"
                theta-start="137.5"
                theta-length="85"
                open-ended="true"
                material="shader: flat; side: double; color: #000; opacity: 0.95">
    </a-cylinder>
    <a-text class="vr-format-proj" data-curve-lift="0.10"
            value="Format" align="left" color="#fff" width="3.5" position="-1.1 0.5 0.01"></a-text>

    <!-- Row 1: Type -->
    <a-text class="vr-format-proj" data-curve-lift="0.10"
            value="Type"   align="right" color="#aaa" width="2" position="-0.85 0.28 0.01"></a-text>
    <a-entity class="vr-btn picker-btn vr-format-proj" data-curve-lift="0.06" data-pick-row="type" data-pick-value="Normal"  position="-0.55 0.28 0.01"
              geometry="primitive:plane;width:0.45;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="Normal"  align="center" color="#fff" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn vr-format-proj" data-curve-lift="0.06" data-pick-row="type" data-pick-value="FishEye" position="0.0 0.28 0.01"
              geometry="primitive:plane;width:0.45;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="FishEye" align="center" color="#fff" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>

    <!-- Row 2: Degree -->
    <a-text class="vr-format-proj" data-curve-lift="0.10"
            value="Degree" align="right" color="#aaa" width="2" position="-0.85 0.04 0.01"></a-text>
    <a-entity class="vr-btn picker-btn vr-format-proj" data-curve-lift="0.06" data-pick-row="degree" data-pick-value="Cinema" position="-0.55 0.04 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="Cinema" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn vr-format-proj" data-curve-lift="0.06" data-pick-row="degree" data-pick-value="180"    position="-0.18 0.04 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="180" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn vr-format-proj" data-curve-lift="0.06" data-pick-row="degree" data-pick-value="200"    position="0.19 0.04 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="200" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn vr-format-proj" data-curve-lift="0.06" data-pick-row="degree" data-pick-value="360"    position="0.56 0.04 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="360" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>

    <!-- Row 3: Stereo -->
    <a-text class="vr-format-proj" data-curve-lift="0.10"
            value="Stereo" align="right" color="#aaa" width="2" position="-0.85 -0.20 0.01"></a-text>
    <a-entity class="vr-btn picker-btn vr-format-proj" data-curve-lift="0.06" data-pick-row="stereo" data-pick-value="2D"  position="-0.55 -0.20 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="2D" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn vr-format-proj" data-curve-lift="0.06" data-pick-row="stereo" data-pick-value="SBS" position="-0.18 -0.20 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="SBS" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>
    <a-entity class="vr-btn picker-btn vr-format-proj" data-curve-lift="0.06" data-pick-row="stereo" data-pick-value="TB"  position="0.19 -0.20 0.01"
              geometry="primitive:plane;width:0.30;height:0.18" material="color:#2c5282;opacity:0.95">
      <a-text value="TB" align="center" color="#fff" width="3" position="0 0 0.005"></a-text>
    </a-entity>

    <!-- Auto -->
    <a-entity class="vr-btn picker-btn vr-format-proj" data-curve-lift="0.06" data-pick-row="auto" data-pick-value="auto" position="0.0 -0.46 0.01"
              geometry="primitive:plane;width:0.80;height:0.16" material="color:#3776c2;opacity:0.95">
      <a-text value="Auto (re-detect)" align="center" color="#fff" width="2.5" position="0 0 0.005"></a-text>
    </a-entity>
  </a-entity>

  <!-- M3c help cheatsheet. Hidden by default; toggled by the "?" button. -->
  <a-entity id="vrHelpPanel" position="0 1.0 -2.5" rotation="-15 0 0" visible="false">
    <a-plane class="vr-panel-bg" width="2.4" height="1.5" color="#000" material="opacity:0.75"></a-plane>
    <a-text value="Controls" align="left" color="#fff" width="3.5" position="-1.1 0.65 0.01"></a-text>

    <a-text value="Trigger (no hit) · single"  align="left" color="#aaa" width="3" position="-1.1  0.42 0.01"></a-text>
    <a-text value="Toggle panel"               align="left" color="#fff" width="3" position=" 0.05 0.42 0.01"></a-text>
    <a-text value="Trigger · double"           align="left" color="#aaa" width="3" position="-1.1  0.30 0.01"></a-text>
    <a-text value="Play / Pause"               align="left" color="#fff" width="3" position=" 0.05 0.30 0.01"></a-text>
    <a-text value="Trigger · hold + move"      align="left" color="#aaa" width="3" position="-1.1  0.18 0.01"></a-text>
    <a-text value="Drag screen"                align="left" color="#fff" width="3" position=" 0.05 0.18 0.01"></a-text>
    <a-text value="A or X · single / double"   align="left" color="#aaa" width="3" position="-1.1  0.06 0.01"></a-text>
    <a-text value="Toggle panel / Play-Pause"  align="left" color="#fff" width="3" position=" 0.05 0.06 0.01"></a-text>
    <a-text value="Thumbstick L / R"           align="left" color="#aaa" width="3" position="-1.1 -0.06 0.01"></a-text>
    <a-text value="-10s / +10s"                align="left" color="#fff" width="3" position=" 0.05 -0.06 0.01"></a-text>
    <a-text value="Thumbstick U / D"           align="left" color="#aaa" width="3" position="-1.1 -0.18 0.01"></a-text>
    <a-text value="Zoom in / out"              align="left" color="#fff" width="3" position=" 0.05 -0.18 0.01"></a-text>
    <a-text value="B or Y · short"             align="left" color="#aaa" width="3" position="-1.1 -0.30 0.01"></a-text>
    <a-text value="Reset screen / Recenter"    align="left" color="#fff" width="3" position=" 0.05 -0.30 0.01"></a-text>
    <a-text value="B or Y · long-press"        align="left" color="#aaa" width="3" position="-1.1 -0.42 0.01"></a-text>
    <a-text value="Full recenter"              align="left" color="#fff" width="3" position=" 0.05 -0.42 0.01"></a-text>

    <a-entity class="vr-btn" data-action="help-close" position="1.05 0.65 0.01"
              geometry="primitive:plane;width:0.18;height:0.18" material="color:#a01010;opacity:0.95">
      <a-text value="X" align="center" color="#fff" width="3.5" position="0 0 0.005"></a-text>
    </a-entity>
  </a-entity>

  <!-- Subtitle language picker. Hidden by default; CC button toggles. JS at
       picker-render time populates the buttons row and resizes the
       background plane to fit. -->
  <a-entity id="vrSubtitlePicker" position="0 1.0 -2.5" rotation="-15 0 0" visible="false">
    <a-plane id="vrSubtitlePickerBg" class="vr-panel-bg" width="2.0" height="0.4" color="#000" material="opacity:0.7"></a-plane>
    <a-text id="vrSubtitlePickerTitle" value="Subtitles" align="left" color="#fff" width="3" position="-0.85 0.13 0.01"></a-text>
    <a-entity id="vrSubtitlePickerButtons" position="0 0 0.01"></a-entity>
  </a-entity>

  <!-- M4c browse panel. Hidden by default; toggled by the Browse button on
       the playback panel. Top strip is wired in Task 3 (this task);
       tile grid + load-more sentinel are populated by Tasks 4-5. -->
  <a-entity id="vrBrowsePanel" position="0 1.4 -2.5" rotation="-15 0 0" visible="false">
    <!-- Curved bg: partial-arc cylinder. Hub at panel-local z=3.02 (HUB_Z),
         shared with the tile covers (R=3.0) and top-strip buttons (R=2.97).
         BG R=3.02 → bg surface lands at panel-local z=0 (the panel back),
         so tiles (z=0.02) and buttons (z=0.05) sit clearly in front and
         don't z-fight. 85° arc covers the 3.4m chord of tile content
         (~64.93°) plus ~10° margin per side. -->
    <a-cylinder class="vr-grid-bg vr-btn" data-action="grid-bg"
                radius="3.02"
                height="2.4"
                position="0 0 3.02"
                theta-start="137.5"
                theta-length="85"
                open-ended="true"
                material="shader: flat; side: double; color: #000; opacity: 0.95">
    </a-cylinder>

    <!-- Top strip — five curved buttons sharing the panel hub. The wrapper
         is positioned at panel-local (0, 1.0, 3.02) so the cylinder hub for
         the buttons sits at the same hub as bg/tiles. Each button is its
         own a-cylinder primitive at default position (0,0,0) inside this
         wrapper, with its own theta-start / theta-length spanning its arc.
         BTN_R=2.97 → button surface at panel-local z=0.05 (in front of
         tiles at 0.02, in front of bg at 0). Text labels are positioned
         at the surface point of the button's angular center, with a
         matching yaw rotation so the label faces the user along the arc.

         Angular layout (mirroring the original flat x_center positions):
         search:  x=-1.0,  w=1.2  →  arc center at θ=-19.7°, span 23.1°
         filters: x=-0.10, w=0.45 →  arc center at θ= -1.93°, span 8.68°
         clear:   x= 0.40, w=0.45 →  arc center at θ=  7.74°, span 8.68°
         cols:    x= 0.95, w=0.40 →  arc center at θ= 18.65°, span 7.71°
         close:   x= 1.45, w=0.20 →  arc center at θ= 29.32°, span 3.86°
         A-Frame θ = 180 - our_θ. theta-start = aFrameCenter - span/2. -->
    <a-entity id="vrBrowseTopStrip" position="0 1.0 3.02">
      <!-- Search bar bg — also serves as a click target that focuses the
           in-VR search input (data-action="search-focus"). Text label is
           injected per-character on a curve at runtime by curveLabelInto(). -->
      <a-cylinder class="vr-search-bg vr-btn" data-action="search-focus"
                  data-label="Search…" data-label-color="#888" data-label-align="left"
                  radius="2.97" height="0.16" open-ended="true"
                  theta-start="188.15" theta-length="23.10"
                  material="shader: flat; color: #222; opacity: 0.9; side: double">
      </a-cylinder>
      <a-cylinder class="vr-btn" data-action="filters-clear"
                  data-label="Clear all" data-label-color="#fff" data-label-align="center"
                  radius="2.97" height="0.16" open-ended="true"
                  theta-start="167.92" theta-length="8.68"
                  material="shader: flat; color: #2c5282; opacity: 0.95; side: double">
      </a-cylinder>
      <a-cylinder class="vr-btn" data-action="cols-cycle" id="vrColsBtn"
                  data-label="Cols: 4" data-label-color="#fff" data-label-align="center"
                  radius="2.97" height="0.16" open-ended="true"
                  theta-start="157.49" theta-length="7.71"
                  material="shader: flat; color: #2c5282; opacity: 0.95; side: double">
      </a-cylinder>
      <a-cylinder class="vr-btn" data-action="browse-close"
                  data-label="✕" data-label-color="#fff" data-label-align="center"
                  radius="2.97" height="0.16" open-ended="true"
                  theta-start="148.75" theta-length="3.86"
                  material="shader: flat; color: #a01010; opacity: 0.95; side: double">
      </a-cylinder>
    </a-entity>

    <!-- Tile grid root (Task 4 populates). -->
    <a-entity id="vrBrowseTiles"></a-entity>

    <!-- "Loading more..." sentinel (Task 5 toggles). -->
    <a-text id="vrBrowseLoadMore" value="" align="center" color="#888" width="3"
            position="0 -1.05 0.01" visible="false"></a-text>

    <!-- M4c Task 7: Filters panel — cylindrical extension on the user's
         right of the browse panel. Shares the panel transform + hub
         (HUB at panel-local z=3.02), so the new BG arc abuts browse BG
         seamlessly at θ=137.5. Auto-visible when browse opens (the
         setSubpanelVisible traverse sets all descendants visible).
         Browse ✕ cascades-close everything via the same traverse. No
         dedicated open/close on the filters extension itself.

         Columns extend rightward past the filters BG seam (at θ=137.5)
         into the browse BG area, so Performer's right edge abuts the
         browse close button (left at θ=148.75). The lane/header/search
         cylinders are at smaller R than browse BG (R=3.02), so they
         render in front of browse BG without z-fighting; the area
         between rightmost browse tile (θ~147.5) and Performer column
         is now filled by the Performer lane instead of empty BG.
         Span: 3 cols × 16.73° + 4 even gaps × 1.64° = 56.75°.
         Column θ centers: Performer 138.745 (abuts close, 1.64° gap),
         Tag 120.375 (middle), Studio 102.005 (far right, 1.64° gap to
         filters BG left edge).
         Headers/search at y aligned with browse top strip (y=1.0). -->
    <a-entity id="vrFiltersExtension">
      <!-- BG cylinder — passive backdrop. No data-action so raycast
           doesn't snag here when reaching for buttons behind. -->
      <a-cylinder class="vr-panel-bg"
                  radius="3.02" height="2.4"
                  position="0 0 3.02"
                  theta-start="92" theta-length="45.5"
                  open-ended="true"
                  material="shader: flat; side: double; color: #000; opacity: 0.95">
      </a-cylinder>

      <!-- Per-column lane backgrounds. Slightly lighter shade than the
           main BG so each column "owns" its vertical strip visibly,
           even when its list/values are empty. R=3.01 so the lane sits
           just in front of the BG (R=3.02) without z-fighting. Centered
           vertically in the area below the value strip (y=0.58) and
           extending to the cylinder bottom area (y=-1.0). -->
      <a-cylinder class="vr-panel-bg" data-col-kind="performer"
                  radius="3.01" height="1.58" open-ended="true"
                  position="0 -0.21 3.02"
                  theta-start="130.38" theta-length="16.73"
                  material="shader: flat; color: #181828; opacity: 1.0; side: double">
      </a-cylinder>
      <a-cylinder class="vr-panel-bg" data-col-kind="tag"
                  radius="3.01" height="1.58" open-ended="true"
                  position="0 -0.21 3.02"
                  theta-start="112.01" theta-length="16.73"
                  material="shader: flat; color: #181828; opacity: 1.0; side: double">
      </a-cylinder>
      <a-cylinder class="vr-panel-bg" data-col-kind="studio"
                  radius="3.01" height="1.58" open-ended="true"
                  position="0 -0.21 3.02"
                  theta-start="93.64" theta-length="16.73"
                  material="shader: flat; color: #181828; opacity: 1.0; side: double">
      </a-cylinder>

      <!-- Column headers (y=1.0, same as browse top strip). -->
      <a-entity id="vrFiltersHeadersStrip" position="0 1.0 3.02">
        <a-cylinder data-col-kind="performer"
                    data-label="Performer" data-label-color="#fff" data-label-align="center"
                    radius="2.97" height="0.16" open-ended="true"
                    theta-start="130.38" theta-length="16.73"
                    material="shader: flat; color: #1a365d; opacity: 0.95; side: double">
        </a-cylinder>
        <a-cylinder data-col-kind="tag"
                    data-label="Tag" data-label-color="#fff" data-label-align="center"
                    radius="2.97" height="0.16" open-ended="true"
                    theta-start="112.01" theta-length="16.73"
                    material="shader: flat; color: #1a365d; opacity: 0.95; side: double">
        </a-cylinder>
        <a-cylinder data-col-kind="studio"
                    data-label="Studio" data-label-color="#fff" data-label-align="center"
                    radius="2.97" height="0.16" open-ended="true"
                    theta-start="93.64" theta-length="16.73"
                    material="shader: flat; color: #1a365d; opacity: 0.95; side: double">
        </a-cylinder>
      </a-entity>

      <!-- Per-column search bars (y=0.82, just below headers). -->
      <a-entity id="vrFiltersSearchStrip" position="0 0.82 3.02">
        <a-cylinder class="vr-search-bg vr-btn" data-action="picker-search-focus" data-picker-kind="performer" data-col-kind="performer"
                    data-label="Search…" data-label-color="#888" data-label-align="left"
                    radius="2.97" height="0.10" open-ended="true"
                    theta-start="130.38" theta-length="16.73"
                    material="shader: flat; color: #222; opacity: 0.9; side: double">
        </a-cylinder>
        <a-cylinder class="vr-search-bg vr-btn" data-action="picker-search-focus" data-picker-kind="tag" data-col-kind="tag"
                    data-label="Search…" data-label-color="#888" data-label-align="left"
                    radius="2.97" height="0.10" open-ended="true"
                    theta-start="112.01" theta-length="16.73"
                    material="shader: flat; color: #222; opacity: 0.9; side: double">
        </a-cylinder>
        <a-cylinder class="vr-search-bg vr-btn" data-action="picker-search-focus" data-picker-kind="studio" data-col-kind="studio"
                    data-label="Search…" data-label-color="#888" data-label-align="left"
                    radius="2.97" height="0.10" open-ended="true"
                    theta-start="93.64" theta-length="16.73"
                    material="shader: flat; color: #222; opacity: 0.9; side: double">
        </a-cylinder>
      </a-entity>

      <!-- Per-column list roots (JS populates row cylinders). data-col-*
           lets the renderer place each row at the column's theta. -->
      <a-entity id="vrFiltersList-performer" data-col-theta="130.38" data-col-length="16.73" position="0 0 3.02"></a-entity>
      <a-entity id="vrFiltersList-tag"       data-col-theta="112.01" data-col-length="16.73" position="0 0 3.02"></a-entity>
      <a-entity id="vrFiltersList-studio"    data-col-theta="93.64"  data-col-length="16.73" position="0 0 3.02"></a-entity>

      <!-- Value-picker row (JS populates Favorites/Stars/O-Counter).
           Positioned ABOVE the column lists (between search bars and
           list area) so the per-column "selected" sub-lists at the
           bottom of each column lane don't collide with it. -->
      <a-entity id="vrFiltersValuesStrip" position="0 0.65 3.02"></a-entity>

      <!-- Active-filter chips strip — kept as an empty wrapper for now;
           Step 4 dropped chips entirely (per-column blue selections +
           value-button color cover the same purpose). renderActiveChips
           still iterates an empty kinds list and renders nothing here. -->
      <a-entity id="vrFiltersChipsStrip" position="0 -1.05 3.02"></a-entity>
    </a-entity>

  </a-entity>

  </a-entity><!-- /vrControlsRoot -->

  <!-- Generic in-VR debug overlay. Hidden by default; toggled by the
       DBG button on the playback panel. Lives at scene root (not inside
       vrControlsRoot) so it stays visible even after the playback UI
       is hidden, which is the point of a debug surface. World position
       1.5m in front of user, slightly below eye level. Yellow text on a
       black backdrop placed behind (z=-0.01) so semi-transparent
       rendering doesn't occlude the text. Updated each frame from the
       browse-tick component (gated on visibility). -->
  <a-entity id="vrDebugOverlay" position="0 1.0 -1.5" visible="false">
    <a-plane width="2.0" height="0.30" color="#000" material="shader: flat; opacity: 0.7"
             position="0 0 -0.01"></a-plane>
    <a-text id="vrDebugOverlayText" value="DEBUG OVERLAY READY" align="center" color="#ffff00"
            width="2.5" wrap-count="30" position="0 0 0"></a-text>
  </a-entity>

  <!-- Laser controllers for raycast-clicking the panel buttons. -->
  <!-- Initial visible attribute would be overridden by tracked-controls'
       autoHide=true on every tick once a controller connects, so we don't
       set visible=false here. Hide the LINE via showLine: false and
       neutralize raycast hits via enabled: false; the controller model
       remains visible, matching SKYBOX. setPanelVisible toggles these
       two raycaster props (not the entity's visible). -->
  <a-entity id="vrLaserRight" laser-controls="hand: right" raycaster="objects: .vr-btn, .vr-panel-bg; far: 5; enabled: false; showLine: false"></a-entity>
  <a-entity id="vrLaserLeft"  laser-controls="hand: left"  raycaster="objects: .vr-btn, .vr-panel-bg; far: 5; enabled: false; showLine: false"></a-entity>

  <!-- M3c controller-mapping component. Hosts the trigger state machine,
       gamepad polling, and B/Y long-press timer. Emits semantic events
       on <a-scene>; the inline IIFE applies them. -->
  <a-entity controls></a-entity>

  <!-- Subtitle render plane. Starts as a child of <a-scene>; JS reparents
       it to vrFlat (cinema) or scene.camera (immersive) when a cue is
       active. Hidden until a cue activates. -->
  <a-entity id="vrSubtitlePlane" visible="false">
    <!-- Single canvas-textured plane. A CanvasTexture lets us render
         CJK / Cyrillic / Arabic / any Unicode via the browser's native
         font stack — A-Frame's default Roboto MSDF font is Latin-only
         and renders all other glyphs as blank. -->
    <a-plane id="vrSubtitleSurface" width="1.6" height="0.18"></a-plane>
  </a-entity>

  <!-- M4c Task 8 fade overlay. Black plane reparented to scene.camera at
       runtime so it travels with the headset. Material opacity is animated
       from 0 → 1 → 0 around a scene swap so audio + visual cross-fade
       cleanly without a WebXR session restart. The plane is huge (100×100)
       so it fully covers the camera frustum at any reasonable FOV.

       depthWrite: false is critical. Without it, the plane (parented to
       camera at z=-0.5) writes depth at 0.5m every frame even at
       opacity 0. When transparent objects (panel BG, buttons) at greater
       distances try to render afterward they pass depth test, but the
       sort + multi-pass interaction made the playback panel stop showing
       behind the fade plane. Disabling depth writes leaves the depth
       buffer untouched, so other transparent objects render normally
       both during and after a fade. -->
  <a-entity id="vrFadeOverlay" position="0 1.6 0">
    <a-plane id="vrFadePlane" width="100" height="100" color="#000"
             material="opacity:0;transparent:true;shader:flat;depthWrite:false" position="0 0 -0.5"></a-plane>
  </a-entity>
</a-scene>

<script src="/vendor/aframe.min.js"></script>
<script src="/controls.js"></script>
<script>
  (function() {
    const btn          = document.getElementById('enterVR');
    const scene        = document.getElementById('vrScene');
    const wrap         = document.querySelector('.wrap');
    const video        = document.getElementById('sceneVideo');
    const picker       = document.getElementById('vrFormatPicker');
    if (!btn || !scene || !wrap || !video) return;

    // Three.js's Raycaster does NOT skip invisible objects by default —
    // it only checks layers. So a panel with visible=false (e.g. the
    // format picker) still has its descendant .vr-btn meshes intercept
    // the laser ray, blocking it from reaching the visible browse panel
    // behind. Also, the browse-tile covers are visually clipped to the
    // browse panel's band, but their underlying cylinder geometry still
    // exists above/below that band. Patch intersectObjects to filter out:
    //   1) any hit whose object (or any ancestor) has visible=false
    //   2) any browse-grid hit whose intersection point is outside the
    //      visible tile band
    // This keeps the laser line, hover, and click behavior aligned with
    // what the user can actually see.
    (function patchRaycasterVisibility() {
      const TR = AFRAME.THREE.Raycaster.prototype;
      if (TR._svPatched) return;
      const orig = TR.intersectObjects;
      function isFullyVisible(obj) {
        for (let n = obj; n; n = n.parent) if (!n.visible) return false;
        return true;
      }
      TR.intersectObjects = function (objects, recursive, target) {
        const hits = orig.call(this, objects, recursive, target);
        // Sorted by distance already; filter in place to preserve order.
        for (let i = hits.length - 1; i >= 0; i--) {
          const hitEl = hits[i].object && hits[i].object.el;
          const browseHit = !!(hitEl && hitEl.closest && hitEl.closest('#vrBrowseTiles'));
          if (!isFullyVisible(hits[i].object) ||
              (browseHit && !isBrowseGridIntersectionWithinBand(hits[i]))) {
            hits.splice(i, 1);
          }
        }
        return hits;
      };
      TR._svPatched = true;
    })();

    // In-VR control-panel icons. A-Frame's <a-text> uses an MSDF font that
    // doesn't include emoji codepoints, so 🔊/🔇/🔁 render blank in-headset.
    // Inline SVG-as-data-URI textures on <a-image> planes work because
    // Three.js's TextureLoader uses Image() which loads SVG natively in
    // modern browsers (incl. Meta Browser). Toggle pairs (mute, play/pause)
    // overlap two planes and flip their `visible` attr.
    const ICONS = (function() {
      const svg = (body) => 'data:image/svg+xml;utf8,' + encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">' + body + '</svg>'
      );
      return {
        speakerOn:  svg('<path fill="white" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>'),
        speakerOff: svg('<path fill="white" d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zM3 9v6h4l5 5V4L7 9H3zM21 19.5L4.5 3 3 4.5 19.5 21z"/>'),
        play:       svg('<polygon fill="white" points="6,4 20,12 6,20"/>'),
        pause:      svg('<rect fill="white" x="6" y="4" width="4" height="16"/><rect fill="white" x="14" y="4" width="4" height="16"/>'),
        loop:       svg('<path fill="white" d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>'),
        format:     svg('<rect fill="none" stroke="white" stroke-width="2" x="3" y="5" width="18" height="14" rx="2"/><line stroke="white" stroke-width="2" x1="12" y1="5" x2="12" y2="19"/>'),
        exit:       svg('<line stroke="white" stroke-width="3" stroke-linecap="round" x1="5" y1="5" x2="19" y2="19"/><line stroke="white" stroke-width="3" stroke-linecap="round" x1="19" y1="5" x2="5" y2="19"/>'),
      };
    })();

    function applyIcon(id, src) {
      const el = document.getElementById(id);
      if (el) el.setAttribute('src', src);
    }
    function applyAllIcons() {
      applyIcon('vrMuteIconOn', ICONS.speakerOn);
      applyIcon('vrMuteIconOff', ICONS.speakerOff);
      applyIcon('vrPlayIcon', ICONS.play);
      applyIcon('vrPauseIcon', ICONS.pause);
      applyIcon('vrLoopIcon', ICONS.loop);
      applyIcon('vrFormatIcon', ICONS.format);
      applyIcon('vrExitIcon', ICONS.exit);
    }
    function updatePlayPauseIcon() {
      const play = document.getElementById('vrPlayIcon');
      const pause = document.getElementById('vrPauseIcon');
      if (play) play.setAttribute('visible', video.paused);
      if (pause) pause.setAttribute('visible', !video.paused);
    }
    // Apply after a-scene is ready so the entities exist; also try
    // immediately in case `loaded` already fired during script eval.
    scene.addEventListener('loaded', applyAllIcons);
    scene.addEventListener('loaded', updatePlayPauseIcon);
    applyAllIcons();
    video.addEventListener('play', updatePlayPauseIcon);
    video.addEventListener('pause', updatePlayPauseIcon);

    // Bind material + texture programmatically. aframe-stereo-component@1.4.0
    // doesn't work on A-Frame 1.7 (reads material as raw string at init), so
    // stereo is handled here directly.
    //
    // Single-video architecture: sceneVideo (the on-page <video>) is the
    // sole media element. THREE.VideoTexture reads frames from it; the
    // element also produces audio. One pipeline = no drift between audio
    // and picture, and the texture is non-empty on Enter VR because
    // sceneVideo will already be playing (or about to play, started by the
    // Enter VR click which is a user gesture).
    //
    // Three rendering paths, picked by the server based on tags + filename:
    //   1. Equirectangular sphere (DOME 180°, SPHERE 360°). Standard
    //      MeshBasicMaterial. Per-eye UV swap on tex.offset/repeat handles
    //      SBS/TB/mono via the scene's data-stereo attribute.
    //   2. Fisheye sphere (FISHEYE 180°, MKX200 200°, RF52). Custom
    //      ShaderMaterial: fragment shader maps direction → fisheye (u,v),
    //      eye offsets applied via uniforms set per-eye in onBeforeRender.
    //   3. Flat plane (no VR detected). Plain MeshBasicMaterial, no
    //      stereo, sits in front of the user as a virtual cinema screen.
    //
    // For paths 1 and 2 the half-sphere / full-sphere geometry uses
    // phiStart/phiLength values that face -Z (camera forward). WebXR
    // renders the scene twice per frame (once per eye); Three.js calls
    // mesh.onBeforeRender per render call with the active camera, which
    // is how we know which eye to configure UV/offset uniforms for.
    // Shared VideoTexture instance reused across all bind functions.
    // sphere materials mutate offset/repeat per eye; fisheye shader
    // ignores offset/repeat and applies its own UV math via uniforms,
    // so sharing is safe.
    let sharedTex = null;
    function getSharedTex() {
      if (!sharedTex) {
        sharedTex = new AFRAME.THREE.VideoTexture(video);
        if (AFRAME.THREE.SRGBColorSpace) sharedTex.colorSpace = AFRAME.THREE.SRGBColorSpace;
      }
      return sharedTex;
    }
    function disposeMeshMaterial(id) {
      const el = document.getElementById(id);
      if (!el) return;
      const mesh = el.getObject3D('mesh');
      if (!mesh) return;
      mesh.userData.boundVR = false;
      if (mesh.material) {
        if (mesh.material.dispose) {
          try { mesh.material.dispose(); } catch (e) {}
        }
        // The mesh keeps a default material; the next applySphere/applyFlat/
        // applyFisheye will replace it with a fresh MeshBasicMaterial /
        // ShaderMaterial wired to a live VideoTexture.
      }
    }
    function teardownVideoTexture() {
      // Dispose the shared VideoTexture so the next bind creates a fresh
      // one wired to the currently-active GL context. Without this, a
      // post-context-loss texture has dead GPU handles and renders black
      // even though the <video> element is still decoding frames.
      if (sharedTex) {
        if (sharedTex.dispose) {
          try { sharedTex.dispose(); } catch (e) {}
        }
        sharedTex = null;
      }
      ['vrSphere180', 'vrSphere360', 'vrFisheye', 'vrFlat'].forEach(disposeMeshMaterial);
    }
    function rebindActiveGeometry() {
      const active = activeGeometry();
      if (!active) return;
      if (active.id === 'vrFlat') applyFlat();
      else if (active.id === 'vrFisheye') applyFisheye();
      else if (active.id === 'vrSphere180' || active.id === 'vrSphere360') applySphere();
    }

    // Recover from WebGL context loss + suspended XR sessions. Quest 3 drops
    // the GL context after ~30s sleep; the VideoTexture and the materials
    // that reference it become invalid (they hold GPU handles tied to the
    // old context). Three.js doesn't auto-rebuild on context-restore — we
    // dispose and rebind.
    // Soft path: pause / seek-to-current / play. Restores frame flow when
    // the GL context was the only thing lost.
    function softVideoRefresh(t, wasPaused) {
      try {
        video.pause();
        video.currentTime = t;
        if (!wasPaused) {
          const p = video.play();
          if (p && p.catch) {
            p.catch(err => {
              console.warn('stash-vr: soft refresh play failed; falling back to load()', err);
              hardVideoRefresh(t, wasPaused);
            });
          }
        }
      } catch (e) {
        console.warn('stash-vr: soft refresh threw; falling back to load()', e);
        hardVideoRefresh(t, wasPaused);
      }
    }

    // Hard path: video.load() to fully reset the decoder pipeline. Used
    // after deep sleeps where the soft path can't restart frame flow.
    function hardVideoRefresh(t, wasPaused) {
      try {
        const onMeta = function() {
          video.removeEventListener('loadedmetadata', onMeta);
          try {
            video.currentTime = t;
            if (!wasPaused) {
              const p = video.play();
              if (p && p.catch) p.catch(err => console.warn('stash-vr: hard refresh play failed', err));
            }
          } catch (e) {
            console.warn('stash-vr: hard refresh post-meta failed', e);
          }
        };
        video.addEventListener('loadedmetadata', onMeta);
        video.load();
      } catch (e) {
        console.warn('stash-vr: hard refresh threw', e);
      }
    }

    function refreshVideoTexture() {
      teardownVideoTexture();
      rebindActiveGeometry();
      if (!video) return;
      const wasPaused = video.paused;
      const t = isFinite(video.currentTime) ? video.currentTime : 0;
      // Watchdog: if currentTime hasn't advanced after 1.2s of soft-refresh
      // attempt (and we expected playback), escalate to hard refresh.
      const startTime = t;
      softVideoRefresh(t, wasPaused);
      if (!wasPaused) {
        setTimeout(function() {
          if (!video) return;
          const advanced = video.currentTime > startTime + 0.05;
          if (!advanced) {
            console.warn('stash-vr: watchdog detected no playback advance — escalating to load()');
            hardVideoRefresh(t, wasPaused);
          }
        }, 1200);
      }
    }

    // First enter-vr: the initial bind path already handled it. Skip the
    // teardown — only rebuild on second-and-later entries (post-suspend).
    let enterVrCount = 0;
    function onEnterVr() {
      enterVrCount++;
      if (enterVrCount === 1) {
        // First entry: just kick the decoder, don't tear down a fresh bind.
        if (video && video.readyState >= 2) {
          try {
            const t = isFinite(video.currentTime) ? video.currentTime : 0;
            video.currentTime = t;
          } catch (e) {}
        }
        return;
      }
      refreshVideoTexture();
    }
    scene.addEventListener('enter-vr', onEnterVr);

    // WebGL context loss handlers (only available once the scene has
    // initialized its renderer canvas).
    scene.addEventListener('loaded', function() {
      const canvas = scene.canvas;
      if (!canvas) return;
      canvas.addEventListener('webglcontextlost', function(e) {
        console.warn('stash-vr: WebGL context lost — requesting restore');
        e.preventDefault(); // critical: without this the browser doesn't restore
      }, false);
      canvas.addEventListener('webglcontextrestored', function() {
        console.warn('stash-vr: WebGL context restored — rebuilding video texture');
        refreshVideoTexture();
      }, false);
    });

    // Page-visibility backstop. Refresh the decoder on visibility return so
    // a stalled pipeline doesn't survive a quick tab-switch.
    let lastHiddenAt = 0;
    document.addEventListener('visibilitychange', function() {
      if (document.hidden) {
        lastHiddenAt = performance.now();
        return;
      }
      // Visibility returned. Decide soft vs hard recovery based on how
      // long we were hidden. Quest deep sleeps invalidate the decoder
      // pipeline; quick tab-switches just need a frame kick.
      const wasHiddenForMs = lastHiddenAt > 0 ? performance.now() - lastHiddenAt : 0;
      lastHiddenAt = 0;
      if (wasHiddenForMs > 30000) {
        // Long sleep — full refresh including texture rebind.
        refreshVideoTexture();
      } else if (video && video.readyState >= 2) {
        try {
          const t = isFinite(video.currentTime) ? video.currentTime : 0;
          video.currentTime = t;
        } catch (e) {}
      }
    });

    function bindSphereMesh(id) {
      const el = document.getElementById(id);
      if (!el || !window.AFRAME || !AFRAME.THREE) return;
      const mesh = el.getObject3D('mesh');
      if (!mesh || mesh.userData.boundVR) return;
      const tex = getSharedTex();
      mesh.material = new AFRAME.THREE.MeshBasicMaterial({
        map: tex,
        side: AFRAME.THREE.BackSide
      });
      mesh.onBeforeRender = function(renderer, sceneObj, cam) {
        const xr = renderer.xr;
        const stereo = scene.dataset.stereo || '';
        // Sphere geometry has phiStart=π, phiLength=π so its UV u=0 is at
        // world +X (user's right) and u=1 at -X (user's left). The standard
        // VR180 convention is the opposite: video left edge = user's left.
        // We compensate here with a horizontal U-flip via negative repeat.x
        // and offset.x = (right-edge-of-eye-half).
        // Out of XR or mono content: still apply the U-flip.
        if (!xr || !xr.isPresenting || !stereo) {
          tex.offset.set(1, 0);
          tex.repeat.set(-1, 1);
          return;
        }
        const xrCam = xr.getCamera();
        if (!xrCam || !xrCam.cameras || xrCam.cameras.length < 2) return;
        const isLeft = cam === xrCam.cameras[0];
        const isRight = cam === xrCam.cameras[1];
        if (!isLeft && !isRight) return;
        if (stereo === 'sbs') {
          // Left eye sees tex u in [0, 0.5] flipped: geom u=0 → tex u=0.5; geom u=1 → tex u=0.
          // Right eye sees tex u in [0.5, 1] flipped: geom u=0 → tex u=1; geom u=1 → tex u=0.5.
          tex.repeat.set(-0.5, 1);
          tex.offset.set(isLeft ? 0.5 : 1, 0);
        } else if (stereo === 'tb') {
          // U-flipped, vertical halves per eye.
          tex.repeat.set(-1, 0.5);
          tex.offset.set(1, isLeft ? 0 : 0.5);
        } else {
          tex.offset.set(1, 0);
          tex.repeat.set(-1, 1);
        }
      };
      mesh.userData.boundVR = true;
    }
    function applySphere() {
      bindSphereMesh('vrSphere180');
      bindSphereMesh('vrSphere360');
    }
    function applyFlat() {
      const el = document.getElementById('vrFlat');
      if (!el || !window.AFRAME || !AFRAME.THREE) return;
      const mesh = el.getObject3D('mesh');
      if (!mesh || mesh.userData.boundVR) return;
      mesh.material = new AFRAME.THREE.MeshBasicMaterial({ map: getSharedTex() });
      mesh.userData.boundVR = true;
    }
    // applyFisheye binds a custom ShaderMaterial that converts each
    // fragment's direction (from sphere center) to a fisheye (u, v)
    // sample, then applies SBS/TB/mono eye offsets via uniforms set per
    // eye in onBeforeRender. uFOV in degrees comes from the entity's
    // data-fov attribute (180 / 190 / 200). Beyond the fisheye coverage,
    // fragments are discarded so the back of the sphere shows the
    // <a-scene> background color.
    function applyFisheye() {
      const el = document.getElementById('vrFisheye');
      if (!el || !window.AFRAME || !AFRAME.THREE) return;
      const mesh = el.getObject3D('mesh');
      if (!mesh || mesh.userData.boundVR) return;
      const tex = getSharedTex();
      const fov = parseFloat(el.dataset.fov || '180');
      const material = new AFRAME.THREE.ShaderMaterial({
        side: AFRAME.THREE.BackSide,
        uniforms: {
          uMap:       { value: tex },
          uFOV:       { value: fov },
          uCant:      { value: 0.0 },
          uEyeOffset: { value: new AFRAME.THREE.Vector2(0, 0) },
          uEyeRepeat: { value: new AFRAME.THREE.Vector2(1, 1) }
        },
        vertexShader: [
          'varying vec3 vDir;',
          'void main() {',
          '  vDir = normalize(position);',
          '  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);',
          '}'
        ].join('\n'),
        fragmentShader: [
          'precision highp float;',
          'varying vec3 vDir;',
          'uniform sampler2D uMap;',
          'uniform float uFOV;',
          'uniform float uCant;',
          'uniform vec2 uEyeOffset;',
          'uniform vec2 uEyeRepeat;',
          'void main() {',
          '  vec3 d = normalize(vDir);',
          '  float c = cos(uCant);',
          '  float s = sin(uCant);',
          '  vec3 dr = vec3(c * d.x + s * d.z, d.y, -s * d.x + c * d.z);',
          '  float theta = acos(-dr.z);',
          '  float maxTheta = radians(uFOV * 0.5);',
          '  if (theta > maxTheta) discard;',
          '  float r = (theta / maxTheta) * 0.5;',
          '  float phi = atan(dr.y, dr.x);',
          '  vec2 uv = vec2(0.5 + r * cos(phi), 0.5 + r * sin(phi));',
          '  uv = uv * uEyeRepeat + uEyeOffset;',
          '  gl_FragColor = texture2D(uMap, uv);',
          '}'
        ].join('\n')
      });
      mesh.material = material;
      mesh.onBeforeRender = function(renderer, sceneObj, cam) {
        const xr = renderer.xr;
        const stereo = scene.dataset.stereo || '';
        const u = material.uniforms;
        if (!xr || !xr.isPresenting || !stereo) {
          u.uEyeOffset.value.set(0, 0);
          u.uEyeRepeat.value.set(1, 1);
          u.uCant.value = 0;
          return;
        }
        const xrCam = xr.getCamera();
        if (!xrCam || !xrCam.cameras || xrCam.cameras.length < 2) return;
        const isLeft = cam === xrCam.cameras[0];
        const isRight = cam === xrCam.cameras[1];
        if (!isLeft && !isRight) return;
        const cantDeg = parseFloat(el.dataset.cant || '0');
        const cantRad = cantDeg * Math.PI / 180;
        u.uCant.value = isLeft ? -cantRad : cantRad;
        if (stereo === 'sbs') {
          u.uEyeRepeat.value.set(0.5, 1);
          u.uEyeOffset.value.set(isLeft ? 0 : 0.5, 0);
        } else if (stereo === 'tb') {
          u.uEyeRepeat.value.set(1, 0.5);
          u.uEyeOffset.value.set(0, isLeft ? 0 : 0.5);
        } else {
          u.uEyeOffset.value.set(0, 0);
          u.uEyeRepeat.value.set(1, 1);
          u.uCant.value = 0;
        }
      };
      mesh.userData.boundVR = true;
    }
    function applyAll() {
      applySphere();
      applyFlat();
      applyFisheye();
    }
    scene.addEventListener('loaded', applyAll);
    ['vrSphere180', 'vrSphere360', 'vrFlat', 'vrFisheye'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('object3dset', applyAll);
    });

    // Resolve the currently-rendering geometry entity. M3b ensures
    // exactly one of the four has visible=true at any time. Read the
    // Three.js object3D.visible property directly (unambiguous boolean)
    // instead of getAttribute (which returned strings before A-Frame
    // parsed and booleans after, leading to flaky resolution at handler
    // time).
    function activeGeometry() {
      const ids = ['vrSphere180', 'vrSphere360', 'vrFisheye', 'vrFlat'];
      for (let i = 0; i < ids.length; i++) {
        const el = document.getElementById(ids[i]);
        if (!el || !el.object3D) continue;
        if (el.object3D.visible) return el;
      }
      return null;
    }

    // M3c drag — translate the active geometry by per-tick controller
    // delta. The cinema plane is at finite distance (~3m) so 1:1 hand
    // motion looks right. Spheres are at radius 100 so a 30cm hand motion
    // shifts the center by 0.3% of the sphere — invisible. Scale up for
    // the spheres so motion is perceptible.
    scene.addEventListener('vr:drag-move', function(e) {
      const el = activeGeometry();
      if (!el || !el.object3D) return;
      const isImmersive = el.id !== 'vrFlat';
      const k = isImmersive ? 50 : 1;
      el.object3D.position.x += e.detail.dx * k;
      el.object3D.position.y += e.detail.dy * k;
      el.object3D.position.z += e.detail.dz * k;
      if (el.id === 'vrFlat') {
        const cam = scene.camera;
        if (cam) el.object3D.lookAt(cam.position);
      }
    });
    scene.addEventListener('vr:panel-toggle', function() {
      setPanelVisible(!isPanelVisible());
    });
    scene.addEventListener('vr:play-pause', function() {
      if (video.paused) {
        const p = video.play();
        if (p && p.catch) p.catch(err => console.warn('stash-vr: video play failed', err));
      } else {
        video.pause();
      }
    });

    // Reset the active geometry to its template-default position+scale.
    // Defaults are static per the HTML: vrFlat at (0,1.6,-3) scale 1,
    // all others at (0,0,0) scale 1.
    function resetGeometry() {
      const el = activeGeometry();
      if (!el || !el.object3D) return;
      if (el.id === 'vrFlat') {
        el.object3D.position.set(0, 1.6, -3);
      } else {
        el.object3D.position.set(0, 0, 0);
      }
      el.object3D.scale.set(1, 1, 1);
      const cam = scene.camera;
      if (el.id === 'vrFlat' && cam) el.object3D.lookAt(cam.position);
    }

    // WebXR yaw recenter: capture current camera yaw, build inverse-yaw
    // offset, swap reference space. Pitch/roll left to the headset (it
    // reports them correctly).
    function recenterYaw() {
      const r = scene.renderer;
      if (!r || !r.xr || !r.xr.isPresenting) return;
      const cam = r.xr.getCamera();
      if (!cam) return;
      // Extract user's yaw from camera matrixWorld.
      // Cols 8,9,10 are camera's local +Z (= -forward). yaw measured from
      // canonical -Z forward = atan2(forward.x, -forward.z) = atan2(-e[8], e[10]).
      const e = cam.matrixWorld.elements;
      const yaw = Math.atan2(-e[8], e[10]);
      const el = activeGeometry();
      if (!el || !el.object3D) return;
      if (el.id === 'vrFlat') {
        // Cinema: yaw recenter is a no-op; resetGeometry's lookAt(camera)
        // handles plane orientation. Skipping here keeps the cinema reset
        // path simple.
        return;
      }
      // Immersive: rotate the active geometry by -yaw about Y so its local
      // -Z direction (where texture center is for spheres / fisheye) aligns
      // with the user's current gaze direction. We do NOT change the WebXR
      // reference space — that desyncs A-Frame's tracked-controls (which
      // samples controller poses against the original ref space) from the
      // camera (which follows setReferenceSpace). Rotating the geometry
      // achieves the visual recenter without touching the ref space, so
      // controllers remain in their real-world positions.
      el.object3D.rotation.y = -yaw;
    }

    scene.addEventListener('vr:reset-short', function(e) {
      if (e.detail.mode === 'cinema') {
        resetGeometry();
      } else {
        recenterYaw();
      }
    });

    scene.addEventListener('vr:reset-long', function() {
      // Full recenter: yaw recenter + geometry reset, both modes.
      recenterYaw();
      resetGeometry();
    });

    scene.addEventListener('vr:seek', function(e) {
      if (isNaN(video.currentTime)) return;
      const delta = e.detail.sign * e.detail.seconds;
      if (delta < 0) {
        video.currentTime = Math.max(0, video.currentTime + delta);
      } else if (!isNaN(video.duration) && video.duration > 0) {
        video.currentTime = Math.min(video.duration - 0.1, video.currentTime + delta);
      }
      // If duration is unknown (live stream / early load), silently
      // skip forward seek — matches the seek logic above.
    });

    scene.addEventListener('vr:scale', function(e) {
      // Suppress geometry scale while the browse panel is grabbing thumbstick
      // Y for grid scrolling — otherwise the user scrolls the grid AND
      // simultaneously rescales the cinema/immersive geometry.
      if (browseConsumeThumbY) return;
      const el = activeGeometry();
      if (!el || !el.object3D) return;
      const newScale = el.object3D.scale.x * e.detail.factor;
      const clamped = Math.max(0.3, Math.min(5.0, newScale));
      el.object3D.scale.setScalar(clamped);
    });

    // Panel + lasers visibility is shared. tracked-controls' autoHide=true
    // would force el.object3D.visible = !!controller every tick, fighting
    // any visible attribute we set. We disable autoHide on each laser
    // entity once the controller connects, then own visibility ourselves.
    // We toggle BOTH the entity's visible (which hides the controller
    // model) AND the raycaster's showLine + enabled (which hide the
    // laser line and stop phantom raycast clicks).
    function setLaserActive(el, active) {
      if (!el) return;
      el.setAttribute('visible', active ? 'true' : 'false');
      el.setAttribute('raycaster', 'enabled', !!active);
      el.setAttribute('raycaster', 'showLine', !!active);
    }
    function setPanelVisible(visible) {
      const root = document.getElementById('vrControlsRoot');
      if (root) {
        // Summon = position the panel cluster in front of wherever the
        // user is currently looking, matching SKYBOX/HereSphere behavior.
        // Otherwise the panel stays at world origin and is invisible to
        // a user who has turned their head while watching the scene
        // (post-swap, post-recenter, or after natural exploration).
        // Children (vrControls, vrFormatPicker, etc.) keep their fixed
        // local offsets; only the root's transform tracks the camera.
        if (visible && scene.camera && root.object3D) {
          const cam = scene.camera;
          const camPos = new AFRAME.THREE.Vector3();
          cam.getWorldPosition(camPos);
          const camDir = new AFRAME.THREE.Vector3();
          cam.getWorldDirection(camDir);
          // Project to horizontal plane so the panel doesn't tilt with
          // headset pitch — children carry their own pitch.
          camDir.y = 0;
          if (camDir.lengthSq() < 1e-6) camDir.set(0, 0, -1);
          camDir.normalize();
          // Yaw such that root's local -Z (where children sit) points
          // along camDir (the user's gaze).
          const yaw = Math.atan2(-camDir.x, -camDir.z);
          root.object3D.position.set(camPos.x, 0, camPos.z);
          root.object3D.rotation.set(0, yaw, 0);
        }
        root.setAttribute('visible', visible ? 'true' : 'false');
      }
      setLaserActive(document.getElementById('vrLaserRight'), visible);
      setLaserActive(document.getElementById('vrLaserLeft'),  visible);
    }
    function isPanelVisible() {
      const root = document.getElementById('vrControlsRoot');
      if (!root) return false;
      const v = root.getAttribute('visible');
      // A-Frame returns boolean true/false after parse; before parse it's a string.
      return v === true || v === 'true';
    }
    // laser-controls re-applies its raycaster config (including showLine: true)
    // whenever a controller (re)connects, and tracked-controls' autoHide
    // re-asserts entity visibility every tick. Disable autoHide and then
    // re-apply our hidden-state on each (re)connect.
    ['vrLaserRight', 'vrLaserLeft'].forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      const reapply = () => {
        // Defer: tracked-controls' init may not have populated this.data yet.
        // setAttribute pushes the override through A-Frame's component update
        // flow even if the component data isn't fully initialized.
        el.setAttribute('tracked-controls', 'autoHide', false);
        setLaserActive(el, isPanelVisible());
      };
      el.addEventListener('controllerconnected', reapply);
      el.addEventListener('controllermodelready', reapply);
    });

    // In-VR control panel: raycast clicks fire on .vr-btn entities (via
    // A-Frame's laser-controls + cursor pipeline). Each button has a
    // data-action attribute that maps to a sceneVideo playback verb.
    const SPEEDS = [0.5, 1.0, 1.25, 1.5, 2.0];
    let speedIdx = 1; // start at 1.0x

    const PLAYBACK_TITLE_MAX_CHARS = 31;
    const PLAYBACK_TEXT_RADIUS = 3.02;
    const PLAYBACK_TITLE_THETA_START = 173.0;
    const PLAYBACK_TITLE_THETA_LENGTH = 31.0;
    const PLAYBACK_TIME_THETA_START = 154.5;
    const PLAYBACK_TIME_THETA_LENGTH = 18.0;
    const PLAYBACK_SCRUB_Y = 0.04;
    const PLAYBACK_SCRUB_ROOT_Z = 0.01;
    const SCRUB_VISUAL_RADIUS = 3.02;
    // SCRUB_VISUAL_LIFT is the WORLD-Z gap (toward the user) between the rail
    // surface and the shell surface. Small enough that the rail still reads
    // as painted on the panel, big enough that the shell — which writes depth
    // and is rendered first in three.js's transparent-pass back-to-front sort
    // — doesn't occlude the rail. 2 mm puts the rail clearly in front while
    // matching the shell's curvature visually.
    const SCRUB_VISUAL_LIFT = 0.005;
    const SCRUB_FILL_MIN_DEG = 0.15;
    const SCRUB_THUMB_Z = 0.03;
    const SCRUB_MARKER_Z = 0.028;

    function updateMuteIcon() {
      const on = document.getElementById('vrMuteIconOn');
      const off = document.getElementById('vrMuteIconOff');
      if (on) on.setAttribute('visible', !video.muted);
      if (off) off.setAttribute('visible', video.muted);
    }
    function updateLoopBtn() {
      const el = document.getElementById('vrLoopBtn');
      if (!el) return;
      el.setAttribute('material', 'color: ' + (video.loop ? '#3776c2' : '#2c5282') + '; opacity: 0.95');
    }
    function updateSpeedLabel() {
      const el = document.getElementById('vrSpeedLabel');
      if (!el) return;
      const v = SPEEDS[speedIdx];
      // Show "1.0x" not "1x"; show "1.25x" not "1.2500x".
      el.setAttribute('text', 'value', (Number.isInteger(v) ? v.toFixed(1) : v.toString()) + 'x');
    }

    function formatPlaybackTitle(raw) {
      const text = String(raw || '').replace(/\s+/g, ' ').trim();
      if (!text) return '';
      if (text.length <= PLAYBACK_TITLE_MAX_CHARS) return text;
      return text.slice(0, PLAYBACK_TITLE_MAX_CHARS - 1) + '…';
    }

    function setPlaybackTitle(raw) {
      const el = document.getElementById('vrTitle');
      if (!el) return;
      const text = String(raw || '');
      el.dataset.fullValue = text;
      el.dataset.displayValue = formatPlaybackTitle(text);
      renderPlaybackTitle();
    }

    function setPlaybackTime(text) {
      const el = document.getElementById('vrTime');
      if (!el) return;
      el.dataset.displayValue = String(text || '');
      renderPlaybackTime();
    }

    function renderPlaybackTitle() {
      const el = document.getElementById('vrTitle');
      if (!el) return;
      const text = el.dataset.displayValue || formatPlaybackTitle(el.dataset.fullValue || '');
      el.dataset.displayValue = text;
      placeCurvedString(el, text, {
        R: PLAYBACK_TEXT_RADIUS,
        thetaStartDeg: PLAYBACK_TITLE_THETA_START,
        thetaLengthDeg: PLAYBACK_TITLE_THETA_LENGTH,
        color: '#fff',
        y: 0,
      }, 'playback-title-char');
    }

    function renderPlaybackTime() {
      const el = document.getElementById('vrTime');
      if (!el) return;
      const text = String(el.dataset.displayValue || '0:00 / 0:00');
      placeCurvedString(el, text, {
        R: PLAYBACK_TEXT_RADIUS,
        thetaStartDeg: PLAYBACK_TIME_THETA_START,
        thetaLengthDeg: PLAYBACK_TIME_THETA_LENGTH,
        color: '#fff',
        y: 0,
      }, 'playback-time-char');
    }

    // <a-entity visible="false"> sets object3D.visible only on that entity,
    // not on descendants — and Three.js' Raycaster checks each object's own
    // visibility, so child buttons inside a hidden picker still raycast-hit
    // and intercept laser clicks meant for whichever picker is actually
    // visible. Walk the subtree to keep visibility consistent.
    function setSubpanelVisible(panelId, visible) {
      const panel = document.getElementById(panelId);
      if (!panel) return;
      panel.setAttribute('visible', visible);
      // Three.js Raycaster ignores visibility entirely, so the laser still
      // hits hidden sub-panel descendants and intercepts clicks. Rebuild
      // the laser raycaster's objects selector so it includes only the
      // currently-visible sub-panels' targets.
      if (panel.object3D) {
        panel.object3D.traverse(function(obj) { obj.visible = visible; });
      }
      updateRaycasterTargets();
    }

    // Keep the laser raycaster's `objects` selector in sync with current
    // sub-panel visibility. Three.js Raycaster doesn't honor object.visible
    // (own or ancestor), so without this, hidden sub-panel buttons still
    // intercept clicks at their world position. Always include the main
    // panel's targets + all panel backgrounds (so trigger lands on the
    // dark area between buttons count as a panel hit and don't fire
    // vr:panel-toggle). Only include a sub-panel's targets while it is
    // actually visible.
    function updateRaycasterTargets() {
      const parts = ['#vrControls .vr-btn', '#vrControls .vr-panel-bg'];
      ['vrFormatPicker', 'vrHelpPanel', 'vrSubtitlePicker', 'vrBrowsePanel'].forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        const v = el.getAttribute('visible');
        const isVisible = (v === true || v === 'true');
        if (isVisible) {
          parts.push('#' + id + ' .vr-btn');
          parts.push('#' + id + ' .vr-panel-bg');
        }
      });
      const selector = parts.join(', ');
      ['vrLaserRight', 'vrLaserLeft'].forEach(id => {
        const laser = document.getElementById(id);
        if (laser) laser.setAttribute('raycaster', 'objects', selector);
      });
    }

    function closeAllSubpanels(except) {
      ['vrFormatPicker', 'vrHelpPanel', 'vrSubtitlePicker', 'vrBrowsePanel'].forEach(id => {
        if (id === except) return;
        setSubpanelVisible(id, false);
      });
    }

    // M4c: persisted column-count for the browse grid. Cycles 3→4→5→6→3.
    let browseCols = parseInt(localStorage.getItem('browse.cols') || '4', 10);
    if (browseCols < 3 || browseCols > 6) browseCols = 4;

    // Place a string as a row of single-character a-text entities laid
    // along an arc, so the whole label visually follows a cylinder curve.
    // - parentEl: where the per-char a-text children are appended.
    // - text: the full string.
    // - opts: { R, thetaStartDeg, thetaLengthDeg, color, y, hubLocal }.
    //   hubLocal=true (default) means the char xz are computed relative to
    //   the parent's local origin sitting on the cylinder hub axis (works
    //   for top-strip cylinder primitives where local 0,0,0 is the hub).
    //   When parentEl's origin is OFFSET from the hub (e.g. tile titles
    //   where the tile entity sits at the hub but the title baseline is
    //   below the cover center), pass `y` as the y-coord for char meshes
    //   and `hubLocal: true` still — z is `R*cos(θ)` from the hub axis.
    // - tagClass: class assigned to each child (used for idempotent wipe).
    function placeCurvedString(parentEl, text, opts, tagClass) {
      if (!text) return;
      const R           = opts.R;
      const thetaStart  = opts.thetaStartDeg;
      const thetaLength = opts.thetaLengthDeg;
      const color       = opts.color || '#fff';
      const y           = (typeof opts.y === 'number') ? opts.y : 0;
      if (!isFinite(R) || !isFinite(thetaStart) || !isFinite(thetaLength)) return;

      // Wipe any prior curved-label children of this class so this is idempotent.
      const old = parentEl.querySelectorAll(':scope > .' + tagClass);
      old.forEach(n => n.parentNode.removeChild(n));

      // Fixed per-char arc span (0.95° at R≈3 ≈ 0.05m). Truncate with an
      // ellipsis if the full string wouldn't fit in the arc, so all
      // labels render at the SAME readable glyph size — instead of
      // shrinking long titles into illegible micro-text.
      const charDeg = 0.95;
      const maxChars = Math.max(1, Math.floor((thetaLength * 0.95) / charDeg));
      if (text.length > maxChars) {
        text = (maxChars > 1) ? (text.slice(0, maxChars - 1) + '…') : text.slice(0, 1);
      }
      const totalArcDeg = text.length * charDeg;
      const centerDeg   = thetaStart + thetaLength / 2;
      const startDeg    = centerDeg - totalArcDeg / 2;
      // Glyph size: font scale = aTextWidth / wrap-count. With width =
      // 3.6× charArcLen and wrap-count = 4, font scale ≈ 0.9× the slot
      // width — wide chars (M, W, K) fit comfortably without overlapping
      // their neighbour, narrow chars (i, l, .) leave a small gap.
      // (Earlier 6× / 4 made wide-char glyphs 50% wider than the slot.)
      const charArcLen  = R * (charDeg * Math.PI / 180);
      const aTextWidth  = (charArcLen * 3.6).toFixed(3);
      const aTextWrap   = '4';

      for (let i = 0; i < text.length; i++) {
        // char[0] at the LARGEST theta (left side from user view), char[N-1]
        // at smallest theta (right side). +theta in A-Frame's convention
        // moves the surface point in -X panel-local.
        const charDegHere = startDeg + (text.length - i - 0.5) * charDeg;
        const charRad     = charDegHere * Math.PI / 180;
        // Pull text ~5mm toward hub (closer to user) so it doesn't z-fight
        // with whatever cylinder shell shares this arc.
        const Rtxt = R - 0.005;
        const x = Rtxt * Math.sin(charRad);
        const z = Rtxt * Math.cos(charRad);
        const yawDeg = charDegHere - 180;
        const t = document.createElement('a-text');
        t.classList.add(tagClass);
        t.setAttribute('value', text[i]);
        t.setAttribute('align', 'center');
        t.setAttribute('color', color);
        t.setAttribute('width', aTextWidth);
        t.setAttribute('wrap-count', aTextWrap);
        t.setAttribute('position', x.toFixed(3) + ' ' + y.toFixed(3) + ' ' + z.toFixed(3));
        t.setAttribute('rotation', '0 ' + yawDeg.toFixed(2) + ' 0');
        parentEl.appendChild(t);
      }
    }

    // Convenience wrapper: read R + theta-* + data-label from a top-strip
    // cylinder and call placeCurvedString.
    function curveLabelInto(parentCylEl) {
      placeCurvedString(parentCylEl,
        parentCylEl.getAttribute('data-label') || '',
        {
          R:               parseFloat(parentCylEl.getAttribute('radius')),
          thetaStartDeg:   parseFloat(parentCylEl.getAttribute('theta-start')),
          thetaLengthDeg:  parseFloat(parentCylEl.getAttribute('theta-length')),
          color:           parentCylEl.getAttribute('data-label-color') || '#fff',
          y: 0,
        },
        'curved-label-char');
    }

    function applyAllCurvedLabels() {
      // Any cylinder carrying data-label gets a curved per-character
      // label. Catches the browse top strip + the new filters extension
      // strips + any future dynamically-added curved button.
      document.querySelectorAll('a-cylinder[data-label]').forEach(curveLabelInto);
    }
    // Apply once after scene is ready (so a-cylinder primitives have parsed
    // their attributes and we can read radius / theta-* from them).
    if (scene.hasLoaded) {
      applyAllCurvedLabels();
    } else {
      scene.addEventListener('loaded', applyAllCurvedLabels);
    }

    function updateColsLabel() {
      const el = document.getElementById('vrColsBtn');
      if (!el) return;
      el.setAttribute('data-label', 'Cols: ' + browseCols);
      curveLabelInto(el);
    }
    updateColsLabel();

    const PANEL_CURVE_HUB_Z = 3.02;
    function curvePanelElement(el, radius, zLift, hubZ) {
      if (!el) return;
      const pos = el.getAttribute('position');
      if (!pos || typeof pos.x !== 'number' || typeof pos.y !== 'number') return;
      const rot = el.getAttribute('rotation') || { x: 0, y: 0, z: 0 };
      const flatX = parseFloat(el.dataset.flatX || pos.x);
      if (!isFinite(flatX) || !isFinite(radius) || radius <= 0) return;
      el.dataset.flatX = String(flatX);
      const theta = flatX / radius;
      const curvedX = radius * Math.sin(theta);
      const curvedZ = (hubZ || PANEL_CURVE_HUB_Z) - radius * Math.cos(theta) + (zLift || 0);
      el.setAttribute('position', { x: curvedX, y: pos.y, z: curvedZ });
      el.setAttribute('rotation', { x: rot.x || 0, y: (-theta * 180 / Math.PI), z: rot.z || 0 });
    }

    function projectPlaybackPanel() {
      // Small controls ride just a hair in front of the playback shell.
      // Keep title/time flat in local space; curving those a-text nodes
      // made the panel header read broken in-headset.
      [
        ['vrDebugBtn',     3.02, 0.015],
        ['vrMuteBtn',      3.02, 0.015],
        ['vrVolumeSlider', 3.02, 0.015],
        ['vrCCBtn',        3.02, 0.015],
        ['vrPlayPauseBtn', 3.02, 0.015],
        ['vrSpeedBtn',     3.02, 0.015],
        ['vrLoopBtn',      3.02, 0.015],
        ['vrBrowseBtn',    3.02, 0.015],
        ['vrFormatBtn',    3.02, 0.015],
        ['vrHelpBtn',      3.02, 0.015],
        ['vrExitBtn',      3.02, 0.015]
      ].forEach(function(args) {
        curvePanelElement(document.getElementById(args[0]), args[1], args[2], PANEL_CURVE_HUB_Z);
      });
      const scrubBar = document.getElementById('vrScrubBar');
      if (scrubBar) {
        scrubBar.setAttribute('position', { x: 0, y: PLAYBACK_SCRUB_Y, z: PLAYBACK_SCRUB_ROOT_Z });
        scrubBar.setAttribute('rotation', { x: 0, y: 0, z: 0 });
      }
      // Concentric layer stack on the panel hub. The rail cylinder's axis must
      // sit in front of the shell hub by enough to keep its SURFACE in front
      // in WORLD Z, not just vrControls-local Z. vrControls' -15° X rotation
      // tilts +Y back into -world_z, so the scrubBar's +0.04 Y offset alone
      // pushes the rail surface ~10 mm BEHIND the shell — the shell then
      // depth-occludes the whole rail and the user sees only the fill/thumb,
      // which is exactly the symptom reported on the headset.
      //
      // SCRUB_VISUAL_LIFT is the desired WORLD-Z gap between rail surface and
      // shell surface (rail in front of shell). The vrControls-local axis Z
      // is solved for: surface_z_world = origin_z + Y·sin(-15°) + (Z-R)·cos(-15°),
      // so Z = (LIFT + Y·sin(15°))/cos(15°) + R + scrubBar-local correction.
      const PANEL_PITCH_RAD = 15 * Math.PI / 180;
      const yWorldShift = PLAYBACK_SCRUB_Y * Math.sin(PANEL_PITCH_RAD);
      const localZForwardPerWorldZ = 1 / Math.cos(PANEL_PITCH_RAD);
      const vrControlsAxisZ = PANEL_CURVE_HUB_Z
        + (SCRUB_VISUAL_LIFT + yWorldShift) * localZForwardPerWorldZ;
      const axisZ = vrControlsAxisZ - PLAYBACK_SCRUB_ROOT_Z;
      const layers = [
        ['vrScrubTint', axisZ - 0.001],
        ['vrScrubRail', axisZ],
        ['vrScrubFill', axisZ + 0.001],
      ];
      layers.forEach(function(args) {
        const el = document.getElementById(args[0]);
        if (!el) return;
        el.setAttribute('radius', SCRUB_VISUAL_RADIUS);
        el.setAttribute('position', { x: 0, y: 0, z: args[1] });
        el.setAttribute('theta-start', SCRUB_ARC_START_DEG.toFixed(3));
        el.setAttribute('theta-length', SCRUB_ARC_LENGTH_DEG.toFixed(3));
      });
      const scrubHit = document.querySelector('#vrScrubBar .vr-scrub-bg');
      if (scrubHit) {
        scrubHit.setAttribute('radius', SCRUB_VISUAL_RADIUS);
        scrubHit.setAttribute('position', { x: 0, y: 0, z: axisZ + 0.002 });
        scrubHit.setAttribute('theta-start', SCRUB_ARC_START_DEG.toFixed(3));
        scrubHit.setAttribute('theta-length', SCRUB_ARC_LENGTH_DEG.toFixed(3));
      }
    }

    function projectFormatPicker() {
      document.querySelectorAll('#vrFormatPicker > .vr-format-proj').forEach(function(el) {
        const zLift = parseFloat(el.getAttribute('data-curve-lift') || '0.06');
        curvePanelElement(el, 2.97, zLift, PANEL_CURVE_HUB_Z);
      });
    }
    if (scene.hasLoaded) {
      projectPlaybackPanel();
      projectFormatPicker();
      setPlaybackTitle(document.getElementById('vrTitle')?.dataset?.fullValue || '');
      renderPlaybackTime();
    } else {
      scene.addEventListener('loaded', function() {
        projectPlaybackPanel();
        projectFormatPicker();
        setPlaybackTitle(document.getElementById('vrTitle')?.dataset?.fullValue || '');
        renderPlaybackTime();
      });
    }

    // M4c Task 6: live search via hidden <input>. Quest's keyboard
    // delivers chars to the input even though the input itself isn't
    // visible during the WebXR session (DOM overlay is refused). We
    // mirror the value onto the existing curved search-bar label.
    (function wireSearchInput() {
      const si = document.getElementById('vrSearchInput');
      if (!si) return;
      let timer = null;

      // Find the curved cylinder that should mirror the typed text for
      // whichever search input is currently active. Browse top-strip
      // search-bg for grid; per-column picker-search-bg for picker
      // queries. browseState may not be initialized yet at module-load
      // time, so default to 'grid'.
      function activeBg() {
        const target = (browseState && browseState.overlayTarget) || 'grid';
        if (target === 'grid') {
          return document.querySelector('a-cylinder.vr-search-bg[data-action="search-focus"]');
        }
        if (target.indexOf('picker-') === 0) {
          const kind = target.slice(7);
          return document.querySelector('a-cylinder.vr-search-bg[data-action="picker-search-focus"][data-picker-kind="' + kind + '"]');
        }
        return null;
      }

      function updateActiveSearchLabel(text) {
        const bg = activeBg();
        if (!bg) return;
        bg.setAttribute('data-label', text || 'Search…');
        bg.setAttribute('data-label-color', text ? '#fff' : '#888');
        curveLabelInto(bg);
      }

      si.addEventListener('input', function() {
        updateActiveSearchLabel(si.value);
        if (timer) clearTimeout(timer);
        const target = (browseState && browseState.overlayTarget) || 'grid';
        // Picker search is local-only (filters cached options, no
        // network), so a tighter debounce feels snappier. Grid search
        // hits the backend each time so 250ms balances feel vs cost.
        const debounceMs = (target === 'grid') ? 250 : 100;
        timer = setTimeout(function() {
          if (target === 'grid') {
            const q = si.value.trim();
            if (q === browseState.q) return;
            browseState.q = q;
            fetchGrid(true);
          } else if (target.indexOf('picker-') === 0) {
            const kind = target.slice(7);
            const q = si.value;
            if (q === browseState.pickerQuery[kind]) return;
            browseState.pickerQuery[kind] = q;
            browseState.listScrollY[kind] = 0; // reset per-column scroll on filter change
            renderColumnList(kind);
          }
        }, debounceMs);
      });

      // Quest's keyboard delivers chars via IME (keydown reports
      // keyCode 229, no usable key name), so we cannot detect specific
      // keys like Enter or its X dismiss button. Both leave state
      // intact; vrAction's search-focus handlers clear the target on
      // each tap so re-engaging the bar is always a fresh start.

      // Helper for vrAction's search-focus handlers (Step 5): tapping
      // a search bar clears the matching target so Quest's keyboard
      // (which always pops empty regardless of input.value) starts fresh.
      function clearSearchTarget(target) {
        si.value = '';
        let bg;
        if (target === 'grid') {
          bg = document.querySelector('a-cylinder.vr-search-bg[data-action="search-focus"]');
        } else if (target.indexOf('picker-') === 0) {
          const kind = target.slice(7);
          bg = document.querySelector('a-cylinder.vr-search-bg[data-action="picker-search-focus"][data-picker-kind="' + kind + '"]');
        }
        if (bg) {
          bg.setAttribute('data-label', 'Search…');
          bg.setAttribute('data-label-color', '#888');
          curveLabelInto(bg);
        }
      }
      // Expose so vrAction can call it.
      window._browseClearSearchTarget = clearSearchTarget;

      // Browse panel closes → drop focus so the keyboard hides.
      const bp = document.getElementById('vrBrowsePanel');
      if (bp) {
        bp.addEventListener('componentchanged', function(evt) {
          if (evt.detail && evt.detail.name === 'visible') {
            const v = bp.getAttribute('visible');
            if (v === false || v === 'false') si.blur();
          }
        });
      }
    })();

    // M4c Task 4: in-VR browse grid state + tile rendering on a cylinder curve.
    const browseState = {
      q: '',
      // performer/studio/tag are arrays for multi-select; favorite/stars/
      // ocount stay scalar. filterNames is parallel-indexed with the id
      // arrays so we can show readable labels in the per-column "selected"
      // sub-lists without re-fetching options.
      filters: { performer: [], studio: [], tag: [], favorite: '', stars: 0, ocount: 0 },
      filterNames: { performer: [], studio: [], tag: [] },
      cursor: '1',
      tiles: [],   // accumulated GridTile[]
      hasMore: true,
      loading: false,
      // M4c Task 7 additions:
      cachedOptions:  {},                                            // kind → [{id,name}, ...] (Step 3)
      cachedOptionsPromise: {},                                      // kind → Promise<[ {id,name}, ... ]> while fetch is in flight
      facetCatalog: null,                                            // { performers, studios, tags }
      facetCatalogStatus: 'idle',                                    // 'idle' | 'loading' | 'ready' | 'failed'
      facetCatalogPromise: null,
      facetCatalogEtag: '',                                          // weak ETag from /browse/filter-catalog
      facetMatrix: null,                                             // { scenes: [...] }
      facetMatrixStatus: 'idle',                                     // same enum as catalog
      facetMatrixPromise: null,
      facetMatrixEtag: '',
      pickerQuery:    { performer: '', studio: '', tag: '' },        // per-column search text (Step 5)
      listScrollY:    { performer: 0, studio: 0, tag: 0 },           // per-column scroll (Step 6)
      lastScrollFocus: 'grid',                                        // 'grid' | 'list-<kind>' | 'none'
      overlayTarget:  'grid'                                          // 'grid' | 'picker-<kind>' (Step 5)
    };

    function perfMark(name) {
      try { performance.mark('vrbrowse.' + name); } catch (e) {}
    }
    function perfReport(label, fromMark, toMark) {
      try {
        const from = performance.getEntriesByName('vrbrowse.' + fromMark).pop();
        const to = performance.getEntriesByName('vrbrowse.' + toMark).pop();
        if (!from || !to) return;
        console.log('vrbrowse: ' + label + ' = ' + Math.round(to.startTime - from.startTime) + 'ms');
      } catch (e) {}
    }
    function perfClearAll() {
      // Clear all vrbrowse.* marks so the 5-second perfReport doesn't pick
      // up stale entries from a prior panel open.
      try {
        ['open',
         'grid.json.received',
         'grid.stubs.rendered',
         'grid.hydration.complete',
         'facets.catalog.received',
         'facets.matrix.received'
        ].forEach(function(name) {
          performance.clearMarks('vrbrowse.' + name);
        });
      } catch (e) {}
    }

    const tileHydrationQueue = [];   // [{el, tile, geom}, ...]
    let tileHydrationWasNonEmpty = false; // tracks last-tick state so we can emit hydration.complete once when the queue drains

    // Drains up to HYDRATION_BUDGET_PER_FRAME hydration jobs. Called every
    // frame from the browse-tick A-Frame component (registered near the
    // bottom of this script). We avoid window.requestAnimationFrame on
    // purpose — it doesn't fire reliably inside an immersive WebXR session
    // on Quest, which leaves stubs grey forever. The scene's tick fires
    // in both 2D and immersive modes.
    function drainTileHydration() {
      if (tileHydrationQueue.length === 0) {
        if (tileHydrationWasNonEmpty) {
          tileHydrationWasNonEmpty = false;
          perfMark('grid.hydration.complete');
        }
        return;
      }
      tileHydrationWasNonEmpty = true;
      const HYDRATION_BUDGET_PER_FRAME = 4;
      let budget = HYDRATION_BUDGET_PER_FRAME;
      while (budget > 0 && tileHydrationQueue.length > 0) {
        const job = tileHydrationQueue.shift();
        try {
          hydrateTile(job.el, job.tile, job.geom);
        } catch (e) {
          console.warn('stash-vr: hydrateTile failed', e);
        }
        budget--;
      }
    }

    function buildGridParams() {
      const p = new URLSearchParams();
      if (browseState.q) p.set('q', browseState.q);
      // Multi-value: server reads q.URL.Query()["performer"] (etc.) which
      // returns all values for that param. Each .append adds another.
      browseState.filters.performer.forEach(id => p.append('performer', id));
      browseState.filters.studio.forEach(id    => p.append('studio',    id));
      browseState.filters.tag.forEach(id       => p.append('tag',       id));
      if (browseState.filters.favorite)  p.set('favorite',  browseState.filters.favorite);
      if (browseState.filters.stars > 0) p.set('stars',     String(browseState.filters.stars));
      if (browseState.filters.ocount > 0) p.set('ocount',   String(browseState.filters.ocount));
      if (browseState.cursor !== '1')    p.set('cursor',    browseState.cursor);
      return p;
    }

    function fetchGrid(reset) {
      if (browseState.loading) return;
      if (reset) {
        browseState.cursor = '1';
        browseState.tiles = [];
        browseState.hasMore = true;
      }
      if (!browseState.hasMore) return;
      browseState.loading = true;
      const sentinel = document.getElementById('vrBrowseLoadMore');
      if (sentinel) {
        sentinel.setAttribute('value', 'Loading…');
        sentinel.setAttribute('visible', 'true');
      }
      fetch('/browse/grid?' + buildGridParams().toString(), {
        headers: { 'Accept': 'application/json' }
      })
        .then(r => r.json())
        .then(json => {
          perfMark('grid.json.received');
          browseState.tiles = browseState.tiles.concat(json.tiles || []);
          browseState.hasMore = !!json.hasMore;
          browseState.cursor = json.nextCursor || '1';
          browseState.loading = false;
          relayoutTiles();
          if (sentinel) {
            sentinel.setAttribute('value', browseState.hasMore ? '' : (browseState.tiles.length ? 'No more scenes' : 'No scenes found'));
            sentinel.setAttribute('visible', !!sentinel.getAttribute('value'));
          }
        })
        .catch(err => {
          browseState.loading = false;
          if (sentinel) {
            sentinel.setAttribute('value', 'fetch failed');
            sentinel.setAttribute('visible', 'true');
          }
          console.warn('stash-vr: grid fetch failed', err);
        });
    }

    // ─── M4c Task 7 Step 2: active-filter chips ───────────────────────────
    // Chips are dynamic curved cylinders in #vrFiltersChipsStrip (panel-local
    // y=-1.05). Each represents one active filter; tap a chip to clear that
    // filter. The chip strip is empty when no filters are active.

    // Chips show only favorite/stars/ocount filters now (performer/studio/
    // tag are visualized per-column in their respective lane via the
    // selected sub-list, so duplicating them as chips is redundant).
    function chipLabel(kind) {
      const f  = browseState.filters;
      if (kind === 'favorite' && f.favorite === 'only') return 'Favorites: Only';
      if (kind === 'favorite' && f.favorite === 'not')  return 'Favorites: Not';
      if (kind === 'stars'    && f.stars > 0) return 'Stars: ' + (f.stars === 5 ? '5 only' : f.stars + '+');
      if (kind === 'ocount'   && f.ocount > 0) return 'O-Count: ' + f.ocount + '+';
      return '';
    }

    function clearChip(kind) {
      if (kind === 'favorite') {
        browseState.filters.favorite = '';
      } else if (kind === 'stars') {
        browseState.filters.stars = 0;
      } else if (kind === 'ocount') {
        browseState.filters.ocount = 0;
      }
      renderActiveChips();
      renderValuesRow();
      rerenderAllFacetColumns();
      fetchGrid(true);
    }

    // Re-render the chips strip from current browseState. Each active filter
    // gets one curved-cylinder chip (label "Kind: Value ✕"). Chips pack
    // right-to-left in user view (highest A-Frame θ first), starting from
    // the right edge of the filters extension arc (θ=148.75) and extending
    // leftward. Width grows with text length (curve-glyph spacing 0.95°/ch).
    function renderActiveChips() {
      const root = document.getElementById('vrFiltersChipsStrip');
      if (!root) return;
      while (root.firstChild) root.removeChild(root.firstChild);
      // Step 4 dropped chips entirely: per-column blue selections handle
      // performer/studio/tag, and value-button color handles favorite/
      // stars/ocount. renderActiveChips remains a no-op call site so other
      // code paths (filters-clear, applyFilterPick) don't need conditional
      // branches; if chip UX comes back later, just put kinds back here.
      const kinds = [];
      const items = kinds.map(k => ({ kind: k, label: chipLabel(k) })).filter(o => o.label);
      if (items.length === 0) {
        // Nothing to render; raycaster targets unchanged.
        return;
      }
      const ARC_RIGHT_DEG = 148.75;   // right edge in user view (abuts browse close)
      const CHAR_DEG = 0.95;          // matches placeCurvedString glyph spacing
      const PADDING_DEG = 1.5;        // visual breathing room left+right of label
      const GAP_DEG = 1.5;            // between adjacent chips
      let cursor = ARC_RIGHT_DEG;
      items.forEach(({ kind, label }) => {
        const text = label + '  ✕';
        const widthDeg = Math.min(40, text.length * CHAR_DEG + PADDING_DEG * 2);
        const thetaStart = cursor - widthDeg;
        if (thetaStart < 50) return; // out of arc; drop chip
        const chip = document.createElement('a-cylinder');
        chip.classList.add('vr-btn');
        chip.dataset.action  = 'filter-chip-clear';
        chip.dataset.chipKind = kind;
        chip.setAttribute('data-label', text);
        chip.setAttribute('data-label-color', '#fff');
        chip.setAttribute('data-label-align', 'center');
        chip.setAttribute('radius', '2.97');
        chip.setAttribute('height', '0.10');
        chip.setAttribute('open-ended', 'true');
        chip.setAttribute('theta-start', thetaStart.toFixed(3));
        chip.setAttribute('theta-length', widthDeg.toFixed(3));
        chip.setAttribute('material', 'shader: flat; color: #3776c2; opacity: 1.0; side: double');
        root.appendChild(chip);
        // Place curved label directly to avoid the getAttribute round-trip
        // that fails on freshly-created a-cylinder primitives.
        placeCurvedString(chip, text, {
          R: 2.97,
          thetaStartDeg: thetaStart,
          thetaLengthDeg: widthDeg,
          color: '#fff',
          y: 0,
        }, 'curved-chip-char');
        // Click: clears this chip's filter.
        chip.addEventListener('click', () => clearChip(kind));
        cursor = thetaStart - GAP_DEG;
      });
      // Raycaster has cached the previous .vr-btn match set; re-evaluate so
      // newly-created chip cylinders become click targets.
      updateRaycasterTargets();
    }
    // Initial render (empty state — no chips until a filter is applied).
    renderActiveChips();

    // ─── M4c Task 7 Step 3: per-column lists ──────────────────────────────
    // Each column root (#vrFiltersList-{kind}) holds row cylinders. Rows
    // share the column's theta range (data-col-theta / data-col-length)
    // and stack vertically below the search bar. Tap a row → toggles that
    // filter; chip appears at the bottom and grid refetches.

    const LIST_ROW_H    = 0.10;    // row pitch (height + small gap)
    const LIST_ROW_GEOM_H = 0.09;  // row cylinder height (leaves 0.01 gap)
    const LIST_TOP_Y    = 0.50;    // y of first regular row's center (below value strip at y=0.65)
    const LIST_REGULAR_BOTTOM_Y = -0.95;  // last regular row center; spans the full lane bg (top y=0.58, bottom y=-1.0). 15 visible rows at scrollY=0.
    const LIST_SELECTED_TOP_Y   = -1.20;  // first selected sub-list row center; sits well BELOW the lane bg (y=-1.0) so the blue chips have visible breathing room from the last regular row. Chips overflow into the area beneath the lane (over the video / playback panel) — that's intentional, matches the requested "green area" growth.
    const LIST_VISIBLE_REGULAR  = Math.floor((LIST_TOP_Y - LIST_REGULAR_BOTTOM_Y) / LIST_ROW_H) + 1; // 15

    function ensureCachedOptions(kind) {
      if (browseState.cachedOptions[kind]) return Promise.resolve(browseState.cachedOptions[kind]);
      if (browseState.cachedOptionsPromise[kind]) return browseState.cachedOptionsPromise[kind];
      browseState.cachedOptionsPromise[kind] = fetch('/browse/filter-options/' + kind, {
        headers: { 'Accept': 'application/json' }
      })
        .then(r => r.json())
        .then(opts => {
          browseState.cachedOptions[kind] = opts || [];
          return browseState.cachedOptions[kind];
        })
        .catch(err => {
          console.warn('stash-vr: filter options fetch failed', err);
          return [];
        })
        .finally(function() {
          browseState.cachedOptionsPromise[kind] = null;
        });
      return browseState.cachedOptionsPromise[kind];
    }

    function ensureFacetCatalog() {
      if (browseState.facetCatalogStatus === 'ready') {
        return Promise.resolve(browseState.facetCatalog);
      }
      if (browseState.facetCatalogStatus === 'failed') {
        return Promise.resolve(null);
      }
      if (browseState.facetCatalogPromise) {
        return browseState.facetCatalogPromise;
      }
      browseState.facetCatalogStatus = 'loading';
      const headers = { 'Accept': 'application/json' };
      if (browseState.facetCatalogEtag) {
        headers['If-None-Match'] = browseState.facetCatalogEtag;
      }
      browseState.facetCatalogPromise = fetch('/browse/filter-catalog', { headers: headers })
        .then(function(r) {
          if (r.status === 304) {
            // Snapshot unchanged — keep the existing cached payload.
            return browseState.facetCatalog;
          }
          if (!r.ok) throw new Error('filter-catalog ' + r.status);
          browseState.facetCatalogEtag = r.headers.get('ETag') || '';
          return r.json();
        })
        .then(function(json) {
          browseState.facetCatalog = json || null;
          browseState.facetCatalogStatus = 'ready';
          perfMark('facets.catalog.received');
          return browseState.facetCatalog;
        })
        .catch(function(err) {
          console.warn('stash-vr: filter-catalog fetch failed', err);
          browseState.facetCatalog = null;
          browseState.facetCatalogStatus = 'failed';
          return null;
        })
        .finally(function() {
          browseState.facetCatalogPromise = null;
        });
      return browseState.facetCatalogPromise;
    }

    function ensureFacetMatrix() {
      if (browseState.facetMatrixStatus === 'ready') {
        return Promise.resolve(browseState.facetMatrix);
      }
      if (browseState.facetMatrixStatus === 'failed') {
        return Promise.resolve(null);
      }
      if (browseState.facetMatrixPromise) {
        return browseState.facetMatrixPromise;
      }
      browseState.facetMatrixStatus = 'loading';
      const headers = { 'Accept': 'application/json' };
      if (browseState.facetMatrixEtag) {
        headers['If-None-Match'] = browseState.facetMatrixEtag;
      }
      browseState.facetMatrixPromise = fetch('/browse/filter-matrix', { headers: headers })
        .then(function(r) {
          if (r.status === 304) {
            return browseState.facetMatrix;
          }
          if (!r.ok) throw new Error('filter-matrix ' + r.status);
          browseState.facetMatrixEtag = r.headers.get('ETag') || '';
          return r.json();
        })
        .then(function(json) {
          browseState.facetMatrix = json || null;
          browseState.facetMatrixStatus = 'ready';
          perfMark('facets.matrix.received');
          return browseState.facetMatrix;
        })
        .catch(function(err) {
          console.warn('stash-vr: filter-matrix fetch failed', err);
          browseState.facetMatrix = null;
          browseState.facetMatrixStatus = 'failed';
          return null;
        })
        .finally(function() {
          browseState.facetMatrixPromise = null;
        });
      return browseState.facetMatrixPromise;
    }

    // Render `text` to a HTMLCanvas via the system font (Quest's Meta
     // Browser includes CJK fallbacks, so this works for any unicode).
    // Returns a Three.js CanvasTexture ready to bind to a material.
    function renderTextToCanvas(text, opts) {
      const canvas = document.createElement('canvas');
      canvas.width = opts.canvasW || 1024;
      canvas.height = opts.canvasH || 96;
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const fontPx = opts.fontPx || 56;
      ctx.font = fontPx + 'px sans-serif';
      ctx.fillStyle = opts.color || '#fff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      // Truncate with ellipsis if it doesn't fit.
      let draw = text || '';
      const maxW = canvas.width - 20;
      if (ctx.measureText(draw).width > maxW) {
        while (draw.length > 1 && ctx.measureText(draw + '…').width > maxW) {
          draw = draw.slice(0, -1);
        }
        draw = draw + '…';
      }
      ctx.fillText(draw, canvas.width / 2, canvas.height / 2);
      const tex = new AFRAME.THREE.CanvasTexture(canvas);
      tex.minFilter = AFRAME.THREE.LinearFilter;
      tex.magFilter = AFRAME.THREE.LinearFilter;
      return tex;
    }

    // Attach a flat <a-plane> child carrying a canvas-texture label,
    // positioned at the column's theta center on the row's R surface and
    // rotated to face the cylinder axis. Replaces placeCurvedString for
    // dynamic row labels so non-ASCII glyphs (Japanese/Korean/Chinese)
    // render via the system font instead of A-Frame's CJK-less MSDF
    // default. Per ~16° column arc the chord-vs-arc deviation is small
    // enough that a flat plane is visually indistinguishable from
    // per-character curving.
    function attachRowLabel(parent, text, colTheta, colLen) {
      const R = 2.97 - 0.005;
      const centerDeg = colTheta + colLen / 2;
      const centerRad = centerDeg * Math.PI / 180;
      const px = R * Math.sin(centerRad);
      const pz = R * Math.cos(centerRad);
      const yaw = centerDeg - 180;
      const chordW = 2 * R * Math.sin((colLen / 2) * Math.PI / 180);
      const planeH = LIST_ROW_GEOM_H - 0.01;

      const plane = document.createElement('a-plane');
      plane.setAttribute('width', chordW.toFixed(3));
      plane.setAttribute('height', planeH.toFixed(3));
      plane.setAttribute('position', px.toFixed(3) + ' 0 ' + pz.toFixed(3));
      plane.setAttribute('rotation', '0 ' + yaw.toFixed(2) + ' 0');
      plane.setAttribute('material', 'shader: flat; transparent: true; opacity: 1; color: #fff');

      // Aspect-ratio-matched canvas to keep glyphs un-stretched.
      const canvasW = 1024;
      const canvasH = Math.max(48, Math.round(canvasW * planeH / chordW));
      const tex = renderTextToCanvas(text, { canvasW: canvasW, canvasH: canvasH });
      plane.addEventListener('loaded', function() {
        const mesh = plane.getObject3D('mesh');
        if (mesh) {
          mesh.material = new AFRAME.THREE.MeshBasicMaterial({
            map: tex, transparent: true, side: AFRAME.THREE.DoubleSide,
          });
          mesh.material.needsUpdate = true;
        }
      });
      parent.appendChild(plane);
      return plane;
    }

    // Helper: build one row cylinder + canvas-texture label + click handler.
    // Used by both the regular list and the selected sub-list.
    function makeFilterRow(kind, opt, y, colTheta, colLen, isSelected) {
      const row = document.createElement('a-cylinder');
      row.classList.add('vr-btn');
      row.dataset.optId = String(opt.id);
      row.setAttribute('radius', '2.97');
      row.setAttribute('height', LIST_ROW_GEOM_H.toString());
      row.setAttribute('open-ended', 'true');
      row.setAttribute('theta-start', colTheta.toString());
      row.setAttribute('theta-length', colLen.toString());
      row.setAttribute('position', '0 ' + y.toFixed(3) + ' 0');
      row.setAttribute('material',
        'shader: flat; color: ' + (isSelected ? '#3776c2' : '#222') + '; opacity: 1.0; side: double');
      attachRowLabel(row, opt.name || '', colTheta, colLen);
      row.addEventListener('click', function() {
        browseState.lastScrollFocus = 'list-' + kind;
        applyFilterPick(kind, opt.id, opt.name);
      });
      return row;
    }

    function renderColumnMessage(root, colTheta, colLen, text) {
      while (root.firstChild) root.removeChild(root.firstChild);
      const row = document.createElement('a-cylinder');
      row.setAttribute('radius', '2.97');
      row.setAttribute('height', LIST_ROW_GEOM_H.toString());
      row.setAttribute('open-ended', 'true');
      row.setAttribute('theta-start', colTheta.toString());
      row.setAttribute('theta-length', colLen.toString());
      row.setAttribute('position', '0 ' + LIST_TOP_Y.toFixed(3) + ' 0');
      row.setAttribute('material', 'shader: flat; color: #333; opacity: 1.0; side: double');
      attachRowLabel(row, text, colTheta, colLen);
      root.appendChild(row);
      updateRaycasterTargets();
    }

    function facetCatalogOptionsForKind(kind) {
      if (!browseState.facetCatalog) return [];
      if (kind === 'performer') return browseState.facetCatalog.performers || [];
      if (kind === 'studio') return browseState.facetCatalog.studios || [];
      if (kind === 'tag') return browseState.facetCatalog.tags || [];
      return [];
    }

    function currentColumnOptions(kind) {
      if (browseState.facetCatalogStatus === 'ready') return facetCatalogOptionsForKind(kind);
      if (browseState.facetCatalogStatus === 'failed') return browseState.cachedOptions[kind] || [];
      return [];
    }

    function rerenderAllFacetColumns() {
      ['performer', 'tag', 'studio'].forEach(function(kind) {
        browseState.listScrollY[kind] = 0;
        renderColumnList(kind);
      });
    }

    function sceneMatchesActiveFacetFilters(scene) {
      scene = scene || {};
      const performerIDs = (scene.performerIds || scene.performerIDs || []).map(String);
      const studioIDs = (scene.studioIds || scene.studioIDs || []).map(String);
      const tagIDs = (scene.tagIds || scene.tagIDs || []).map(String);
      const selectedPerformers = (browseState.filters.performer || []).map(String);
      const selectedStudios = (browseState.filters.studio || []).map(String);
      const selectedTags = (browseState.filters.tag || []).map(String);

      if (!selectedPerformers.every(id => performerIDs.indexOf(id) >= 0)) return false;
      if (!selectedStudios.every(id => studioIDs.indexOf(id) >= 0)) return false;
      if (!selectedTags.every(id => tagIDs.indexOf(id) >= 0)) return false;

      const starsMin = parseInt(browseState.filters.stars || '0', 10) || 0;
      const ocountMin = parseInt(browseState.filters.ocount || '0', 10) || 0;
      const rating100 = parseInt(scene.rating100 || 0, 10) || 0;
      const oCount = parseInt(scene.oCount || 0, 10) || 0;
      if (starsMin > 0 && rating100 <= starsMin * 20 - 1) return false;
      if (ocountMin > 0 && oCount <= ocountMin - 1) return false;

      // Favorite intentionally does not participate here: the facet index
      // omits favorite state, so favorite only narrows the fetched grid.
      return true;
    }

    // Returns a Set of facet IDs that are still reachable given current
    // filters, OR null when the matrix hasn't loaded yet (caller should
    // treat null as "no narrowing — show every option").
    function visibleFacetIDSet(kind) {
      if (!browseState.facetMatrix || !Array.isArray(browseState.facetMatrix.scenes)) {
        return null;
      }
      const key = kind === 'performer' ? 'performerIds'
        : kind === 'studio' ? 'studioIds'
        : kind === 'tag' ? 'tagIds'
        : null;
      const out = new Set();
      if (!key) return out;
      browseState.facetMatrix.scenes.forEach(scene => {
        if (!sceneMatchesActiveFacetFilters(scene)) return;
        const ids = scene[key] || [];
        ids.forEach(id => out.add(String(id)));
      });
      return out;
    }

    function noFacetFiltersActive() {
      const f = browseState.filters;
      return (
        (!f.performer || f.performer.length === 0) &&
        (!f.studio || f.studio.length === 0) &&
        (!f.tag || f.tag.length === 0) &&
        (!f.stars || f.stars === 0) &&
        (!f.ocount || f.ocount === 0)
      );
    }

    function narrowedCatalog(kind) {
      // Fast path: when no facet filters are active (e.g. user just
      // deselected the last chip), every catalog option is reachable.
      // Skip the O(matrix.scenes × 3 kinds) intersection iteration —
      // on libraries with thousands of scenes that's hundreds of ms.
      if (noFacetFiltersActive()) {
        return facetCatalogOptionsForKind(kind);
      }
      const visible = visibleFacetIDSet(kind);
      if (visible === null) {
        // Matrix not loaded yet — show all catalog options (no dimming).
        return facetCatalogOptionsForKind(kind);
      }
      return facetCatalogOptionsForKind(kind).filter(opt => visible.has(String(opt.id)));
    }

    function regularListOptions(kind, opts) {
      const q = (browseState.pickerQuery[kind] || '').trim().toLowerCase();
      const selectedIDs = new Set((browseState.filters[kind] || []).map(String));
      return (opts || []).filter(opt => {
        const id = String(opt.id);
        if (selectedIDs.has(id)) return false;
        if (!q) return true;
        return (opt.name || '').toLowerCase().includes(q);
      });
    }

    function renderColumnOptions(root, kind, colTheta, colLen, opts) {
      const selectedIds = browseState.filters[kind] || [];
      const selectedNames = browseState.filterNames[kind] || [];
      const selectedIdStrings = selectedIds.map(String);
      const regularOpts = regularListOptions(kind, opts);

      // Skip rebuild when only the scroll position changed — the scroll
      // path uses updateColumnScroll which only translates the content
      // container and toggles per-row visibility. Hash everything that
      // affects which rows exist or how they look (NOT scrollY).
      const hash = JSON.stringify([
        regularOpts.map(o => String(o.id)),
        selectedIdStrings,
        selectedNames,
      ]);
      if (_columnStateHash[kind] === hash) {
        updateColumnScroll(kind);
        return;
      }
      _columnStateHash[kind] = hash;

      while (root.firstChild) root.removeChild(root.firstChild);

      // Regular-list content container. Rows are positioned at fixed
      // local y = -i * LIST_ROW_H (row 0 at container origin). The
      // container's own y position carries the scroll offset, which lets
      // applyListScroll just nudge container.object3D.position.y per
      // frame for buttery-smooth scrolling — no DOM churn, no canvas-
      // texture rebuilds. Row visibility is toggled in updateColumnScroll
      // so rows scrolled outside [LIST_TOP_Y, LIST_REGULAR_BOTTOM_Y]
      // disappear instead of poking out above headers / below the lane.
      //
      // Important: A-Frame entity components init asynchronously via a
      // MutationObserver microtask after appendChild, so object3D doesn't
      // exist synchronously. The initial position + per-row visibility
      // therefore go through setAttribute so the component lifecycle
      // applies them on init. updateColumnScroll's direct object3D
      // mutations only kick in from later scroll frames, by which point
      // the entities are fully initialized.
      const initialScrollY = browseState.listScrollY[kind] || 0;
      const half = LIST_ROW_H / 2;
      const visTop = LIST_TOP_Y + half;
      const visBottom = LIST_REGULAR_BOTTOM_Y - half;
      const content = document.createElement('a-entity');
      content.id = 'vrFiltersListContent-' + kind;
      content.setAttribute('position', '0 ' + (LIST_TOP_Y + initialScrollY) + ' 0');
      regularOpts.forEach((opt, i) => {
        const row = makeFilterRow(kind, opt, -i * LIST_ROW_H, colTheta, colLen, false);
        row.dataset.rowIdx = String(i);
        const worldY = LIST_TOP_Y + initialScrollY - i * LIST_ROW_H;
        if (worldY > visTop || worldY < visBottom) {
          row.setAttribute('visible', false);
        }
        content.appendChild(row);
      });
      root.appendChild(content);

      // Selected sub-list — sits BELOW the lane bg so it never overlaps
      // the regular list area. Renders all selected entries (no visible
      // cap); the user explicitly OK'd letting chips overflow past the
      // lane boundary. Static container, no scroll handoff.
      if (selectedIds.length) {
        const sel = document.createElement('a-entity');
        sel.id = 'vrFiltersSelected-' + kind;
        sel.setAttribute('position', '0 0 0');
        selectedIds.forEach((id, i) => {
          const name = selectedNames[i] || '';
          const y = LIST_SELECTED_TOP_Y - i * LIST_ROW_H;
          sel.appendChild(makeFilterRow(kind, { id: id, name: name }, y, colTheta, colLen, true));
        });
        root.appendChild(sel);
      }

      // Initial position + visibility were baked into setAttribute calls
      // above so they apply via the component init lifecycle. Skip the
      // synchronous updateColumnScroll here — object3D doesn't exist yet
      // and the call would be a no-op (the !object3D guard would bail).
      updateRaycasterTargets();
    }

    // Cached state-hash per column so renderColumnList skips rebuilding
    // the row DOM when only scrollY changed (the scroll path mutates
    // object3D.position directly via updateColumnScroll instead).
    const _columnStateHash = { performer: null, studio: null, tag: null };

    function renderColumnList(kind) {
      const root = document.getElementById('vrFiltersList-' + kind);
      if (!root) return;
      const colTheta = parseFloat(root.getAttribute('data-col-theta'));
      const colLen   = parseFloat(root.getAttribute('data-col-length'));
      if (!isFinite(colTheta) || !isFinite(colLen)) return;

      if (browseState.facetCatalogStatus === 'loading' || browseState.facetCatalogStatus === 'idle') {
        _columnStateHash[kind] = null;
        renderColumnMessage(root, colTheta, colLen, 'Loading…');
        return;
      }
      if (browseState.facetCatalogStatus === 'failed') {
        ensureCachedOptions(kind).then(opts => {
          if (!root.parentNode) return; // panel torn down
          renderColumnOptions(root, kind, colTheta, colLen, opts || []);
        });
        return;
      }
      // Catalog ready: render rows immediately. narrowedCatalog returns the
      // full list while matrix is still loading (no intersection dimming),
      // then automatically narrows once the matrix arrives and the column
      // is re-rendered.
      renderColumnOptions(root, kind, colTheta, colLen, narrowedCatalog(kind));
    }

    // Per-frame scroll application. Translates the content container
    // (cheap object3D mutation, no a-frame attr churn) and toggles row
    // visibility based on whether each row's effective world-y falls
    // inside the visible band.
    function updateColumnScroll(kind) {
      const content = document.getElementById('vrFiltersListContent-' + kind);
      if (!content || !content.object3D) return;
      const scrollY = browseState.listScrollY[kind] || 0;
      content.object3D.position.set(0, LIST_TOP_Y + scrollY, 0);
      const half = LIST_ROW_H / 2;
      const top = LIST_TOP_Y + half;
      const bottom = LIST_REGULAR_BOTTOM_Y - half;
      const rows = content.children;
      for (let j = 0; j < rows.length; j++) {
        const row = rows[j];
        const i = parseFloat(row.dataset.rowIdx);
        if (!isFinite(i)) continue;
        const worldY = LIST_TOP_Y + scrollY - i * LIST_ROW_H;
        const vis = worldY <= top && worldY >= bottom;
        if (row.object3D && row.object3D.visible !== vis) {
          row.object3D.visible = vis;
        }
      }
    }

    function maxListScrollY(kind) {
      let opts = [];
      if (browseState.facetCatalogStatus === 'ready') {
        opts = narrowedCatalog(kind);
      } else if (browseState.facetCatalogStatus === 'failed') {
        opts = browseState.cachedOptions[kind] || [];
      }
      const overflow = regularListOptions(kind, opts).length - LIST_VISIBLE_REGULAR;
      return Math.max(0, overflow * LIST_ROW_H);
    }
    function applyListScroll(kind, stickY, dt) {
      const max = maxListScrollY(kind);
      if (max <= 0) return;
      const cur = browseState.listScrollY[kind] || 0;
      // Stick DOWN (stickY = +1) → scrollY INCREASES → later rows reveal,
      // matching the tile-grid scroll convention from tickBrowseScroll.
      const target = Math.max(0, Math.min(cur + stickY * 0.6 * dt, max));
      if (Math.abs(target - cur) < 0.0001) return;
      browseState.listScrollY[kind] = target;
      updateColumnScroll(kind);
    }

    function applyFilterPick(kind, id, name) {
      if (kind === 'performer' || kind === 'studio' || kind === 'tag') {
        // Multi-select toggle: present → remove, absent → append.
        const ids = browseState.filters[kind];
        const names = browseState.filterNames[kind];
        const normID = String(id);
        const idx = ids.findIndex(existingID => String(existingID) === normID);
        if (idx >= 0) {
          ids.splice(idx, 1);
          names.splice(idx, 1);
        } else {
          ids.push(normID);
          names.push(name);
        }
        rerenderAllFacetColumns();
      } else if (kind === 'favorite') {
        browseState.filters.favorite = browseState.filters.favorite === id ? '' : id;
        renderValuesRow();
      } else if (kind === 'stars') {
        const n = parseInt(id || '0', 10);
        browseState.filters.stars = browseState.filters.stars === n ? 0 : n;
        renderValuesRow();
        rerenderAllFacetColumns();
      } else if (kind === 'ocount') {
        const n = parseInt(id || '0', 10);
        browseState.filters.ocount = browseState.filters.ocount === n ? 0 : n;
        renderValuesRow();
        rerenderAllFacetColumns();
      }
      renderActiveChips();
      fetchGrid(true);
    }

    // ─── M4c Task 7 Step 4: bottom value pickers ──────────────────────────
    // Single horizontal row of 10 curved buttons in #vrFiltersValuesStrip
    // (panel-local y=-0.85). Three visually-distinct groups by tint:
    //   Favorites (gold) [Only] [Not]
    //   Stars     (orange) [★5] [★4] [★3] [★2] [★1]
    //   O-Counter (cyan)  [10+] [5+] [1+]
    // Click toggles the value off if already selected, sets it otherwise.
    // Filters arc 56.75°: 10×4° buttons + 11×1.523° equal gaps = 56.75°.
    function renderValuesRow() {
      const root = document.getElementById('vrFiltersValuesStrip');
      if (!root) return;
      while (root.firstChild) root.removeChild(root.firstChild);

      const buttons = [
        // Right-to-left in user view (highest A-Frame θ first).
        { kind: 'favorite', value: 'only', label: 'Only', color: '#b58a2c' },
        { kind: 'favorite', value: 'not',  label: 'Not',  color: '#b58a2c' },
        { kind: 'stars',    value: '5',    label: '★5',   color: '#b56a2c' },
        { kind: 'stars',    value: '4',    label: '★4',   color: '#b56a2c' },
        { kind: 'stars',    value: '3',    label: '★3',   color: '#b56a2c' },
        { kind: 'stars',    value: '2',    label: '★2',   color: '#b56a2c' },
        { kind: 'stars',    value: '1',    label: '★1',   color: '#b56a2c' },
        { kind: 'ocount',   value: '10',   label: '10+',  color: '#2c8eb5' },
        { kind: 'ocount',   value: '5',    label: '5+',   color: '#2c8eb5' },
        { kind: 'ocount',   value: '1',    label: '1+',   color: '#2c8eb5' },
      ];
      const ARC_RIGHT = 148.75;
      const BUTTON_W  = 4.0;
      const GAP       = 1.523;  // (56.75 - 10*4) / 11
      let cursor = ARC_RIGHT;

      buttons.forEach(btn => {
        cursor -= GAP;
        const thetaStart = cursor - BUTTON_W;
        const isSelected = (
          (btn.kind === 'favorite' && browseState.filters.favorite === btn.value) ||
          (btn.kind === 'stars'    && String(browseState.filters.stars)  === btn.value) ||
          (btn.kind === 'ocount'   && String(browseState.filters.ocount) === btn.value)
        );
        const cyl = document.createElement('a-cylinder');
        cyl.classList.add('vr-btn');
        cyl.dataset.valueKind  = btn.kind;
        cyl.dataset.valueValue = btn.value;
        cyl.setAttribute('radius', '2.97');
        cyl.setAttribute('height', '0.10');
        cyl.setAttribute('open-ended', 'true');
        cyl.setAttribute('theta-start',  thetaStart.toFixed(3));
        cyl.setAttribute('theta-length', BUTTON_W.toString());
        cyl.setAttribute('material',
          'shader: flat; color: ' + (isSelected ? '#3776c2' : btn.color) +
          '; opacity: 1.0; side: double');
        root.appendChild(cyl);
        // Curved per-character label (ASCII + ★ both in default Roboto).
        placeCurvedString(cyl, btn.label, {
          R: 2.97,
          thetaStartDeg: thetaStart,
          thetaLengthDeg: BUTTON_W,
          color: '#fff',
          y: 0,
        }, 'curved-value-char');
        cyl.addEventListener('click', function() {
          browseState.lastScrollFocus = 'none';
          applyFilterPick(btn.kind, btn.value);
        });
        cursor = thetaStart;
      });
      updateRaycasterTargets();
    }
    // Initial render so the buttons are present even before browse opens
    // (matches the chips-strip pattern; buttons reflect current state).
    renderValuesRow();

    // Initial population of all 3 columns happens lazily via
    // onBrowsePanelOpen below (the column lists are useless until the
    // panel is actually shown, and we don't want to fetch /browse/filter-
    // options until then).

    // Tile rendering geometry. Computed at relayout time from browseCols
    // and the panel's usable area. Constants here are the layout *parameters*;
    // derived per-tile dimensions live inside relayoutTiles().
    const PANEL_USABLE_W = 3.4;     // panel width (3.6) minus 0.1m padding each side
    const TILE_GAP_X = 0.06;        // horizontal gap between tiles
    const TILE_GAP_Y = 0.06;        // vertical gap between rows
    const TITLE_GAP = 0.04;         // gap between cover bottom and title strip top
    const TITLE_STRIP_H = 0.08;     // height of the title text strip
    const TILE_AREA_TOP_Y    = 0.85;   // top edge of first row (panel-local y); fixed regardless of cols
    const TILE_AREA_BOTTOM_Y = -1.05;  // bottom of visible tile area; tiles clipped below
    const TILE_BUFFER_ROWS   = 1;      // rows above + below the visible band kept in the pool
    // Concentric cylinder radii — bg, tiles, and top-strip buttons share the
    // same hub at panel-local z = HUB_Z, but use different radii so their
    // surfaces don't z-fight. Smaller radius = surface farther from hub =
    // closer to user (since hub is on user's side, concave-toward-user).
    const HUB_Z              = 3.02;   // shared cylinder hub (panel-local +z)
    const BG_R               = 3.02;   // bg surface lands at panel-local z=0
    const ARC_R              = 3.00;   // tile cover surface at z=0.02 (in front of bg)
    const BTN_R              = 2.97;   // top-strip button surface at z=0.05 (in front of tiles)
    const TILE_Z = HUB_Z - ARC_R;     // 0.02 — for back-compat reads only
    let scrollY = 0;                // updated by thumbstick scroll
    let browseMaxScroll = 0;           // computed in relayoutTiles each pass
    // Set true (in tickBrowseScroll) when the laser is hovering on the
    // browse panel AND the panel is visible. Read by the vr:scale handler
    // to suppress geometry-scale binding while the user is scrolling
    // the grid with the thumbstick.
    let browseConsumeThumbY = false;

    // ─── Tile cover: clip planes + UV-mirror helper ──────────────────────
    // The tile covers are partial cylinders viewed from the inside (hub on
    // user's side). The inside face is the *back* face of the geometry, so
    // the texture's U coordinate appears mirrored. We compensate by flipping
    // texture.repeat.x = -1 / offset.x = 1 each time we set/replace a
    // texture on a cover material.
    //
    // Clipping: tiles must not render outside the panel's visible band.
    // We use two THREE.Plane clip planes in panel-local coords (top + bottom
    // of TILE_AREA), transformed to world coords once the panel is in the
    // scene. The same plane *array* is shared across all tile covers so we
    // can mutate-in-place without re-assigning per material.
    const browseClipPlanes = [
      new AFRAME.THREE.Plane(new AFRAME.THREE.Vector3(0,  1, 0), -TILE_AREA_BOTTOM_Y),
      new AFRAME.THREE.Plane(new AFRAME.THREE.Vector3(0, -1, 0),  TILE_AREA_TOP_Y),
    ];
    let browseClipPlanesReady = false;
    function setupBrowseClipping() {
      // Idempotent: enable local clipping on the renderer and recompute
      // clip planes in world coords from the panel's worldMatrix. Called
      // every time the panel becomes visible (cheap; one matrix multiply).
      const panelEl = document.getElementById('vrBrowsePanel');
      if (!scene.renderer || !panelEl || !panelEl.object3D) return;
      scene.renderer.localClippingEnabled = true;
      panelEl.object3D.updateWorldMatrix(true, false);
      const mat = panelEl.object3D.matrixWorld;
      // Reset planes to panel-local, then transform to world in-place. THREE.Plane
      // doesn't have a "set local" method, so we re-init from the original normals
      // each time before applying the matrix.
      browseClipPlanes[0].set(new AFRAME.THREE.Vector3(0,  1, 0), -TILE_AREA_BOTTOM_Y);
      browseClipPlanes[1].set(new AFRAME.THREE.Vector3(0, -1, 0),  TILE_AREA_TOP_Y);
      browseClipPlanes[0].applyMatrix4(mat);
      browseClipPlanes[1].applyMatrix4(mat);
      browseClipPlanesReady = true;
    }

    // Apply the standard cover-material settings (UV mirror + clipping +
    // double-sided + flat shader) to a Three.js material that's about to be
    // shown on a tile cover cylinder. `texture` is the map being applied.
    // For sprite mode (3x3 grid), pass {sprite: true} so we negate within
    // the per-frame repeat.x = 1/SCOLS and offset.x = c/SCOLS dance.
    function applyCoverMaterial(material, texture, opts) {
      if (texture) {
        texture.wrapS = AFRAME.THREE.RepeatWrapping;
        if (!opts || !opts.sprite) {
          texture.repeat.x = -1;
          texture.offset.x =  1;
        }
        // Anisotropic filtering + mipmaps keep the cover sharp at the
        // glancing angles a curved cylinder presents and at the small
        // tile size — without this Three.js falls back to a single
        // sample, which looks soft on VR displays.
        texture.minFilter = AFRAME.THREE.LinearMipmapLinearFilter;
        texture.magFilter = AFRAME.THREE.LinearFilter;
        texture.generateMipmaps = true;
        try {
          const caps = scene.renderer && scene.renderer.capabilities;
          if (caps && caps.getMaxAnisotropy) {
            texture.anisotropy = caps.getMaxAnisotropy();
          }
        } catch (_) {}
        texture.needsUpdate = true;
      }
      material.side = AFRAME.THREE.DoubleSide;
      if (browseClipPlanesReady) {
        material.clippingPlanes = browseClipPlanes;
        material.clipShadows = false;
      }
      material.needsUpdate = true;
    }

    // Returns per-tile placement on a curved cylinder. Each tile's cover is
    // a partial cylinder segment (a-cylinder with theta-start/theta-length)
    // rather than a flat tangent plane — so adjacent tiles share the same
    // cylinder surface and their edges meet exactly with no cross-cut.
    //
    // All tiles in a row share the same tile-entity position (the cylinder
    // hub for the row). Per-tile theta-start positions the visible segment
    // around the hub. The badge / title use the surface-point math derived
    // from the segment center.
    //
    // A-Frame cylinder convention: theta-start = 0 is +X axis, increasing
    // CCW. Our convention (theta=0 facing the user, +Z) maps to A-Frame
    // theta-start = 90°.
    //
    // Vertical anchor: row 0's *cover top edge* sits at TILE_AREA_TOP_Y
    // regardless of cols, so changing column count never pushes the first
    // row up into the top button strip.
    function tileCellPositions(tileW, tileH, tileCoverH, count) {
      const cols = browseCols;
      const halfCols = (cols - 1) / 2;
      const thetaPerTile = tileW / ARC_R;              // arc length / radius (radians)
      const thetaPerGap  = TILE_GAP_X / ARC_R;
      const thetaSpacing = thetaPerTile + thetaPerGap;
      // Concave-toward-user: cylinder hub sits on the user's side of the
      // panel; the curved surface at A-Frame theta=180° (i.e., -Z from hub)
      // is what the user sees. hubZ + (-R) = TILE_Z → hubZ = TILE_Z + R.
      // Edge tiles are CLOSER to user than the center tile (the curve wraps
      // around the user like an IMAX screen).
      const hubZ = TILE_Z + ARC_R;

      // Top-edge anchor: row 0's cover top at TILE_AREA_TOP_Y → row 0 center
      // is one half-cover-height below.
      const yRow0Center = TILE_AREA_TOP_Y - tileCoverH / 2;

      const positions = [];
      const rows = Math.ceil(count / cols);
      for (let row = 0; row < rows; row++) {
        // scrollY increases as the user scrolls forward (stick up). For
        // forward scrolling, all tiles must shift UP (their y INCREASES)
        // so row 0 exits the top of the band and row N+1 enters from
        // below. Hence: y = base + scrollY (NOT - scrollY).
        const y = yRow0Center - row * (tileH + TILE_GAP_Y) + scrollY;
        for (let col = 0; col < cols; col++) {
          const i = row * cols + col;
          if (i >= count) break;
          const ourThetaCenter = (col - halfCols) * thetaSpacing;       // radians
          // Three.js CylinderGeometry uses vertex.x=sin(θ)*R, vertex.z=cos(θ)*R.
          // theta=0 is +Z (the side AWAY from user, since hub is on user's
          // side). theta=180° is -Z (the side facing user). Our convention's
          // +ourTheta = user's right = +X = sin(π - ourTheta) > 0 for
          // ourTheta<π/2, so the mapping is aFrameTheta = π - ourTheta.
          const aFrameThetaCenterDeg = 180 - ourThetaCenter * 180 / Math.PI;
          const aFrameThetaLengthDeg = thetaPerTile * 180 / Math.PI;
          const aFrameThetaStartDeg  = aFrameThetaCenterDeg - aFrameThetaLengthDeg / 2;
          // All tiles in a row share x=0, z=hubZ (the cylinder hub). The
          // cylinder's theta-start handles the per-column placement on the
          // curve. tileW/tileCoverH are also passed to the caller for layout
          // of the badge/title relative to the surface point.
          positions.push({
            x: 0,
            y: y,
            z: hubZ,
            thetaStartDeg:  aFrameThetaStartDeg,
            thetaLengthDeg: aFrameThetaLengthDeg,
            ourThetaCenter: ourThetaCenter,
            thetaPerTile:   thetaPerTile
          });
        }
      }
      return positions;
    }

    const tileTextures = {}; // cache: thumbnailURL → THREE.Texture

    function getTileTexture(url) {
      if (!url) return null;
      if (tileTextures[url]) return tileTextures[url];
      const loader = new AFRAME.THREE.TextureLoader();
      const tex = loader.load(url);
      tileTextures[url] = tex;
      return tex;
    }

    // Hover preview: swap a tile's cover texture for its WebM preview clip
    // while the laser pointer is on it. One decoded video at a time (whichever
    // tile is hovered). The <video> element is allocated lazily on first hover
    // and cached on the tile entity as el._previewVideo.
    function attachPreviewHandlers(tileEl) {
      const plane = tileEl.querySelector('.vr-tile-cover');
      if (!plane) return;

      function ensureVideo() {
        if (tileEl._previewVideo) return tileEl._previewVideo;
        const v = document.createElement('video');
        v.src = tileEl.dataset.previewUrl;
        v.muted = true;
        v.loop = true;
        v.playsInline = true;
        v.crossOrigin = 'anonymous';
        v.preload = 'metadata';
        tileEl._previewVideo = v;
        return v;
      }

      plane.addEventListener('mouseenter', function() {
        // Hover affordance: pop the whole tile entity forward by 0.04m in
        // panel-local +z (toward the user, since the cylinder hub is on
        // the user's side of the concave surface). Avoids the prior 1.05×
        // scale, which expanded the cylinder radius from 3.0 to 3.15 and
        // pushed the cover surface behind the bg plane (clip-through).
        if (tileEl.object3D && !tileEl._hoverPopped) {
          tileEl.object3D.position.z += 0.04;
          tileEl._hoverPopped = true;
        }
        const v = ensureVideo();
        v.currentTime = 0;
        // Track this hover so that a stale (slow) play() resolution after
        // the user has already moved off doesn't replace the cover.
        const hoverToken = (tileEl._hoverToken = (tileEl._hoverToken || 0) + 1);
        const playPromise = v.play();
        if (!playPromise || !playPromise.then) return;
        playPromise.then(function() {
          // Only swap to VideoTexture once the video is actually playing
          // (avoids the "pitch black" frame on no-preview scenes that
          // 404 — play() rejects, cover stays). Also bail if the user
          // already moved off this tile.
          if (tileEl._hoverToken !== hoverToken) return;
          const mesh = plane.getObject3D('mesh');
          if (!mesh) return;
          const tex = new AFRAME.THREE.VideoTexture(v);
          tex.minFilter = AFRAME.THREE.LinearFilter;
          tex.magFilter = AFRAME.THREE.LinearFilter;
          mesh.material = new AFRAME.THREE.MeshBasicMaterial({ map: tex });
          applyCoverMaterial(mesh.material, tex);
        }).catch(function(err) {
          if (tileEl._hoverToken !== hoverToken) return;
          // WebM unavailable (common: Stash hasn't generated a preview).
          // Fall back to cycling through the sprite sheet.
          console.debug('stash-vr: preview play() failed; trying sprite', err);
          startSpriteCycle(tileEl, plane);
        });
      });

      plane.addEventListener('mouseleave', function() {
        // Reverse the hover pop (+0.04m in panel-local z) regardless of
        // which fallback path (video / sprite / nothing) was active.
        if (tileEl.object3D && tileEl._hoverPopped) {
          tileEl.object3D.position.z -= 0.04;
          tileEl._hoverPopped = false;
        }
        // Invalidate any in-flight play() resolution from the previous
        // mouseenter so it can't replace the cover after we restore it.
        tileEl._hoverToken = (tileEl._hoverToken || 0) + 1;
        const v = tileEl._previewVideo;
        if (v) {
          v.pause();
          v.currentTime = 0;
        }
        stopSpriteCycle(tileEl);
        const coverURL = tileEl.dataset.thumbnailUrl;
        const coverTex = coverURL ? tileTextures[coverURL] : null;
        const mesh = plane.getObject3D('mesh');
        if (mesh && coverTex) {
          mesh.material = new AFRAME.THREE.MeshBasicMaterial({ map: coverTex });
          applyCoverMaterial(mesh.material, coverTex);
        }
      });
    }

    // Sprite-sheet fallback when WebM preview is missing. Stash convention:
    // a 3x3 grid of 9 frames at /browse/scene/{id}/sprite. Cycle frames by
    // updating the texture's UV offset every 250ms (~4 fps cinema feel).
    function startSpriteCycle(tileEl, plane) {
      if (tileEl._spriteIntervalId) return;
      const spriteUrl = '/browse/scene/' + encodeURIComponent(tileEl.dataset.sceneId) + '/sprite';
      const loader = new AFRAME.THREE.TextureLoader();
      loader.load(spriteUrl, function(spriteTex) {
        spriteTex.minFilter = AFRAME.THREE.LinearFilter;
        spriteTex.magFilter = AFRAME.THREE.LinearFilter;
        const SCOLS = 3, SROWS = 3;
        // Mirror via negative repeat.x (cylinder-inside view); offset.x then
        // shifts the negated cell into place per-frame in showFrame().
        spriteTex.repeat.set(-1 / SCOLS, 1 / SROWS);
        const mesh = plane.getObject3D('mesh');
        if (!mesh) return;
        mesh.material = new AFRAME.THREE.MeshBasicMaterial({ map: spriteTex });
        applyCoverMaterial(mesh.material, spriteTex, { sprite: true });
        let frame = 0;
        function showFrame() {
          const c = frame % SCOLS;
          const r = Math.floor(frame / SCOLS) % SROWS;
          // U: with repeat.x = -1/SCOLS, range is from offset.x (at u=0) to
          // offset.x - 1/SCOLS (at u=1). For cell c, we want the texture
          // U range [c/SCOLS, (c+1)/SCOLS] to land on geometry u in [0,1],
          // mirrored, so offset.x = (c+1)/SCOLS.
          // V: (0,0) is bottom-left; sprite rows are top-to-bottom, so y=1-(r+1)/SROWS.
          spriteTex.offset.set((c + 1) / SCOLS, 1 - (r + 1) / SROWS);
          spriteTex.needsUpdate = true;
        }
        showFrame();
        tileEl._spriteIntervalId = setInterval(function() {
          frame = (frame + 1) % (SCOLS * SROWS);
          showFrame();
        }, 250);
      }, undefined, function(err) {
        // Sprite also unavailable — silently keep cover.
        console.debug('stash-vr: sprite unavailable', err);
      });
    }

    function stopSpriteCycle(tileEl) {
      if (tileEl._spriteIntervalId) {
        clearInterval(tileEl._spriteIntervalId);
        tileEl._spriteIntervalId = null;
      }
    }

    function isBrowseGridIntersectionWithinBand(intersection) {
      if (!intersection || !intersection.point) return true;
      const panelEl = document.getElementById('vrBrowsePanel');
      if (!panelEl || !panelEl.object3D) return true;
      const local = panelEl.object3D.worldToLocal(intersection.point.clone());
      const eps = 0.0001;
      return local.y <= TILE_AREA_TOP_Y + eps && local.y >= TILE_AREA_BOTTOM_Y - eps;
    }

    // Build the cheapest possible tile entity — cylinder cover with a
    // solid background color and the right theta range. No texture load,
    // no title chars, no badge, no hover handlers. Returns the entity
    // ready to append; the full content arrives via hydrateTile().
    function buildTileStub(tile, geom) {
      const el = document.createElement('a-entity');
      el.classList.add('vr-tile');
      el.dataset.sceneId = tile.id;
      el.dataset.projection = JSON.stringify(tile.projection);
      el.dataset.streamUrl = '/browse/scene/' + encodeURIComponent(tile.id) + '/stream';
      el.dataset.previewUrl = '/browse/scene/' + encodeURIComponent(tile.id) + '/preview';
      el.dataset.thumbnailUrl = tile.thumbnailURL || '';
      el.dataset.tileTitle = tile.title || '';
      el.dataset.hydrationState = 'stub';

      const plane = document.createElement('a-cylinder');
      plane.classList.add('vr-btn', 'vr-tile-cover');
      plane.setAttribute('radius', ARC_R);
      plane.setAttribute('height', geom.tileCoverH);
      plane.setAttribute('open-ended', 'true');
      // Stub material: flat dark grey, no texture. Hydration swaps in the
      // real cover URL via material src once we get to this tile's slot
      // in the queue.
      plane.setAttribute('material',
        'shader: flat; side: double; color: #222');
      plane.setAttribute('theta-start',  geom.thetaStartDeg);
      plane.setAttribute('theta-length', geom.thetaLengthDeg);
      // Apply panel-band clipping planes to the stub material as soon as
      // its mesh exists. Without this, off-band rows render their grey
      // cylinder past the band edge and bleed onto the playback panel.
      // Hydration later replaces the material; the materialtextureloaded
      // listener in hydrateTile re-runs applyCoverMaterial for the new
      // material so clipping persists across the stub→full transition.
      plane.addEventListener('loaded', function() {
        const mesh = plane.getObject3D('mesh');
        if (mesh && mesh.material) applyCoverMaterial(mesh.material, null);
      });
      el.appendChild(plane);
      return el;
    }

    // Hydrate a stub: swap in the real cover texture, build the curved
    // title characters, add the ⓘ detail badge, wire hover/preview
    // handlers. Skipped if the element has already been hydrated for the
    // bound tile id.
    function hydrateTile(el, tile, geom) {
      if (!el || !el.parentNode) return;
      if (el.dataset.hydrationState === 'full' && el.dataset.sceneId === tile.id) return;

      // Rebind in case the pool slot now points to a different tile id.
      el.dataset.sceneId = tile.id;
      el.dataset.projection = JSON.stringify(tile.projection);
      el.dataset.streamUrl = '/browse/scene/' + encodeURIComponent(tile.id) + '/stream';
      el.dataset.previewUrl = '/browse/scene/' + encodeURIComponent(tile.id) + '/preview';
      el.dataset.thumbnailUrl = tile.thumbnailURL || '';
      el.dataset.tileTitle = tile.title || '';

      // Real cover texture.
      const plane = el.querySelector('a-cylinder.vr-tile-cover');
      if (plane && tile.thumbnailURL) {
        plane.setAttribute('material',
          'shader: flat; side: double; color: #fff; src: url(' + tile.thumbnailURL + ')');
        plane.addEventListener('materialtextureloaded', function onLoaded() {
          const mesh = plane.getObject3D('mesh');
          if (!mesh || !mesh.material) return;
          applyCoverMaterial(mesh.material, mesh.material.map || null);
        });
        getTileTexture(tile.thumbnailURL);
      }

      // Detail badge (build if absent; reposition if present from a prior
      // bind on a different tile but the pool slot's geometry is reused).
      let badge = el.querySelector(':scope > .vr-tile-detail');
      if (!badge) {
        badge = document.createElement('a-entity');
        badge.classList.add('vr-btn', 'vr-tile-detail');
        badge.setAttribute('geometry', 'primitive:circle;radius:' + geom.badgeR.toFixed(3));
        badge.setAttribute('material', 'color:#000;opacity:0.85;shader:flat');
        badge.setAttribute('position',
          geom.badgeLocalX.toFixed(3) + ' ' + geom.badgeLocalY.toFixed(3) + ' ' + geom.badgeLocalZ.toFixed(3));
        badge.setAttribute('rotation', '0 ' + geom.badgeYawDeg.toFixed(3) + ' 0');
        const badgeText = document.createElement('a-text');
        badgeText.setAttribute('value', 'ⓘ');
        badgeText.setAttribute('align', 'center');
        badgeText.setAttribute('color', '#fff');
        badgeText.setAttribute('width', (geom.badgeR * 8).toFixed(3));
        badgeText.setAttribute('position', '0 0 0.005');
        badge.appendChild(badgeText);
        el.appendChild(badge);
      }

      // Curved title characters.
      let titleWrap = el.querySelector(':scope > .vr-tile-title');
      if (!titleWrap) {
        titleWrap = document.createElement('a-entity');
        titleWrap.classList.add('vr-tile-title');
        el.appendChild(titleWrap);
      } else {
        while (titleWrap.firstChild) titleWrap.removeChild(titleWrap.firstChild);
      }
      placeCurvedString(titleWrap, tile.title, {
        R: ARC_R,
        thetaStartDeg:  geom.thetaStartDeg,
        thetaLengthDeg: geom.thetaLengthDeg,
        color: '#fff',
        y: geom.titleY,
      }, 'curved-title-char');

      // Hover handlers — attach exactly once per element.
      if (!el._previewHandlersAttached) {
        attachPreviewHandlers(el);
        el._previewHandlersAttached = true;
      }

      el.dataset.hydrationState = 'full';
      el.dataset.geomSig = geom.thetaStartDeg.toFixed(2) + '|' +
                           geom.thetaLengthDeg.toFixed(2) + '|' +
                           geom.tileCoverH.toFixed(3);
    }

    function relayoutTiles() {
      const root = document.getElementById('vrBrowseTiles');
      if (!root) return;

      const cols = browseCols;
      const tileW = (PANEL_USABLE_W - (cols - 1) * TILE_GAP_X) / cols;
      const tileCoverH = tileW * 9 / 16;
      const tileH = tileCoverH + TITLE_GAP + TITLE_STRIP_H;
      const badgeR = Math.min(0.04, tileW * 0.07);

      // Remove tile entities for tiles no longer in state.tiles. This
      // covers filter changes (fetchGrid(true) wipes the array) and any
      // other case where the tile set shrinks.
      const expected = new Set(browseState.tiles.map(t => t.id));
      Array.from(root.children).forEach(child => {
        if (!expected.has(child.dataset.sceneId)) {
          root.removeChild(child);
        }
      });
      // Prune the hydration queue of jobs whose entity was just removed.
      // Without this, the browse-tick budget spends ~15+ frames draining
      // no-op orphan jobs before reaching the new stubs — visible as lag
      // when the user clears a filter and waits for the broader grid to
      // populate. Mirrors the off-pool release path's queue cleanup.
      for (let q = tileHydrationQueue.length - 1; q >= 0; q--) {
        if (!tileHydrationQueue[q].el.parentNode) {
          tileHydrationQueue.splice(q, 1);
        }
      }

      const positions = tileCellPositions(tileW, tileH, tileCoverH, browseState.tiles.length);

      // Max scroll: total content height minus visible band. When content
      // fits in band, max=0 (no scroll). Used by tickBrowseScroll to clamp.
      const totalRows = Math.ceil(browseState.tiles.length / cols);
      const totalContentH = totalRows > 0 ? totalRows * (tileH + TILE_GAP_Y) - TILE_GAP_Y : 0;
      const visibleH = TILE_AREA_TOP_Y - TILE_AREA_BOTTOM_Y;
      browseMaxScroll = Math.max(0, totalContentH - visibleH);
      // Clamp scrollY to the new range. When a filter change shrinks the
      // tile count (deselecting a chip → fewer scenes match → smaller
      // browseMaxScroll), the prior scrollY may sit past the bottom of
      // the new content. tickBrowseScroll only clamps on stick input, so
      // without this the visible band would be empty until the user
      // scrolls.
      if (scrollY > browseMaxScroll) {
        scrollY = browseMaxScroll;
      }

      // Pool window: keep entities only for tiles within `visibleRows +
      // bufferRows*2` of the current scroll position. Tiles outside the
      // window have their entity released; scrolling back recreates the
      // stub via the !el branch below.
      const rowPitch = tileH + TILE_GAP_Y;
      const visibleRows = Math.max(1, Math.ceil(visibleH / rowPitch));
      const poolRowSpan = visibleRows + TILE_BUFFER_ROWS * 2;
      // First fully-or-partially-visible logical row at the current scroll
      // position. scrollY grows positive as the user scrolls forward (rows
      // shift up), so visible row index = floor(scrollY / rowPitch).
      const firstVisibleRow = Math.max(0, Math.floor(scrollY / rowPitch) - TILE_BUFFER_ROWS);
      const lastVisibleRow = firstVisibleRow + poolRowSpan - 1;
      const firstVisibleIdx = firstVisibleRow * cols;
      const lastVisibleIdx = Math.min(browseState.tiles.length - 1, (lastVisibleRow + 1) * cols - 1);

      browseState.tiles.forEach((tile, i) => {
        if (i < firstVisibleIdx || i > lastVisibleIdx) {
          // Outside the pool window — release any entity bound to this tile.
          const orphan = root.querySelector('a-entity[data-scene-id="' + CSS.escape(tile.id) + '"]');
          if (orphan && orphan.parentNode) {
            // Cancel any pending hydration job that still references it.
            for (let q = 0; q < tileHydrationQueue.length; q++) {
              if (tileHydrationQueue[q].el === orphan) {
                tileHydrationQueue.splice(q, 1);
                q--;
              }
            }
            orphan.parentNode.removeChild(orphan);
          }
          return; // skip layout/build for off-pool tiles
        }
        const pos = positions[i];
        // Surface points in tile-entity local coords. The tile entity is at
        // the cylinder hub. With concave-toward-user (aFrameTheta = π-ourθ),
        // a surface point at our_theta is at:
        //   (sin(π-ourθ)·R, *, cos(π-ourθ)·R) = (sin(ourθ)·R, *, -cos(ourθ)·R)
        // i.e., x uses sin (sign-preserved), z uses -cos (negated vs. convex).
        const thetaRightEdge   = pos.ourThetaCenter + pos.thetaPerTile / 2;
        const titleSurfaceX    =  ARC_R * Math.sin(pos.ourThetaCenter);
        const titleSurfaceZ    = -ARC_R * Math.cos(pos.ourThetaCenter);
        const badgeSurfaceX    =  ARC_R * Math.sin(thetaRightEdge);
        const badgeSurfaceZ    = -ARC_R * Math.cos(thetaRightEdge);
        const badgeLocalX      = badgeSurfaceX - badgeR - 0.005;
        const badgeLocalY      = (tileCoverH / 2) - badgeR - 0.005;
        // +0.005 along surface→hub direction (toward user, since hub is on
        // user's side of the curved surface). For concave the surface z is
        // negative, hub at 0; moving toward hub = adding small positive z.
        const badgeLocalZ      = badgeSurfaceZ + 0.005;
        const badgeYawDeg      = -thetaRightEdge * 180 / Math.PI;
        const titleY           = -(tileCoverH / 2 + TITLE_GAP + TITLE_STRIP_H / 2);
        const titleZ           = titleSurfaceZ + 0.005;
        const titleYawDeg      = -pos.ourThetaCenter * 180 / Math.PI;

        // Package per-tile geometry so buildTileStub/hydrateTile can use
        // it without a long parameter list. Mirrors the locals computed
        // just above plus tileCoverH/badgeR from the outer scope.
        const geom = {
          thetaStartDeg: pos.thetaStartDeg,
          thetaLengthDeg: pos.thetaLengthDeg,
          tileCoverH: tileCoverH,
          badgeR: badgeR,
          badgeLocalX: badgeLocalX,
          badgeLocalY: badgeLocalY,
          badgeLocalZ: badgeLocalZ,
          badgeYawDeg: badgeYawDeg,
          titleY: titleY,
        };
        let el = root.querySelector('a-entity[data-scene-id="' + CSS.escape(tile.id) + '"]');
        if (!el) {
          // Build a stub (cylinder + grey bg only) synchronously so the
          // grid lays out immediately. Real cover texture, title chars,
          // badge, and hover handlers arrive via hydrateTile() across
          // subsequent rAF ticks (bounded budget per frame).
          el = buildTileStub(tile, geom);
          root.appendChild(el);
          tileHydrationQueue.push({ el: el, tile: tile, geom: geom });
          el.dataset.hydrationState = 'queued';   // prevent re-enqueue on next relayout
        } else if (el.dataset.hydrationState === 'stub') {
          // Existing un-queued stub — enqueue and mark queued.
          tileHydrationQueue.push({ el: el, tile: tile, geom: geom });
          el.dataset.hydrationState = 'queued';
        } else if (el.dataset.hydrationState === 'queued') {
          // Already in the queue; nothing to do for this relayout pass.
          // The hydration budget will pick it up.
        } else {
          // Existing fully-hydrated tile: cols may have changed → resize cover, badge, title.
          // Track whether per-tile geometry actually changed since the
          // last relayout. If only the row's y has shifted (pure scroll),
          // we don't need to rebuild any of the cylinder geometry or the
          // per-character title chars — the children all live in
          // tile-local coords and inherit the y-shift from the tile entity.
          const geomSig = pos.thetaStartDeg.toFixed(2) + '|' +
                          pos.thetaLengthDeg.toFixed(2) + '|' +
                          tileCoverH.toFixed(3);
          const geomChanged = (el.dataset.geomSig !== geomSig);
          const cyl = el.querySelector('a-cylinder.vr-tile-cover');
          if (cyl && geomChanged) {
            cyl.setAttribute('radius', ARC_R);
            cyl.setAttribute('height', tileCoverH);
            cyl.setAttribute('theta-start',  pos.thetaStartDeg);
            cyl.setAttribute('theta-length', pos.thetaLengthDeg);
          }
          const badge = el.querySelector('.vr-tile-detail');
          if (badge && geomChanged) {
            badge.setAttribute('geometry', 'primitive:circle;radius:' + badgeR.toFixed(3));
            badge.setAttribute('position',
              badgeLocalX.toFixed(3) + ' ' + badgeLocalY.toFixed(3) + ' ' + badgeLocalZ.toFixed(3));
            badge.setAttribute('rotation', '0 ' + badgeYawDeg.toFixed(3) + ' 0');
          }
          // Only rebuild the per-character title chars if the cover arc
          // has actually changed (cols cycle), NOT on every scroll frame.
          // Without this gate, scrolling wipes + recreates ~20 a-text
          // entities per visible tile every frame, causing titles to
          // flicker / vanish during scroll.
          const titleWrap = el.querySelector(':scope > .vr-tile-title');
          if (titleWrap && geomChanged) {
            placeCurvedString(titleWrap, tile.title, {
              R: ARC_R,
              thetaStartDeg:  pos.thetaStartDeg,
              thetaLengthDeg: pos.thetaLengthDeg,
              color: '#fff',
              y: titleY,
            }, 'curved-title-char');
          }
          el.dataset.geomSig = geomSig;
        }
        // Tile entity sits at the cylinder hub for the row. The cover
        // cylinder's theta-start handles the per-column placement on the
        // curve, so no per-tile yaw rotation is needed on the entity itself.
        // Preserve the +0.04m hover pop so a relayout (e.g. cols cycle,
        // load-more) doesn't snap a currently-hovered tile back.
        const popOffset = el._hoverPopped ? 0.04 : 0;
        el.setAttribute('position', { x: pos.x, y: pos.y, z: pos.z + popOffset });
        el.setAttribute('rotation', { x: 0, y: 0, z: 0 });
        // Tile entity stays visible whenever its cover bbox overlaps the
        // panel band — the cover material's clippingPlanes do the partial
        // render at the top/bottom edges. We hide the entire tile only when
        // the cover is fully outside the band (saves draw calls and avoids
        // text/badge bleed past the edge).
        const coverTop = pos.y + tileCoverH / 2;
        const coverBot = pos.y - tileCoverH / 2;
        if (el.object3D) {
          el.object3D.visible = (coverTop > TILE_AREA_BOTTOM_Y && coverBot < TILE_AREA_TOP_Y);
        }
        // Title/badge use independent bool visibility (their text/circle
        // materials don't carry clippingPlanes — MSDF text shader doesn't
        // support them, and we don't bother for the small badge circle).
        // Hide them once their *center* leaves the band; the cover's clip
        // planes still render the cover correctly behind them.
        const titleAbsY = pos.y + titleY;
        const badgeAbsY = pos.y + badgeLocalY;
        const titleNode = el.querySelector(':scope > .vr-tile-title');
        if (titleNode && titleNode.object3D) {
          titleNode.object3D.visible = (titleAbsY > TILE_AREA_BOTTOM_Y && titleAbsY < TILE_AREA_TOP_Y);
        }
        const badgeNode = el.querySelector(':scope > .vr-tile-detail');
        if (badgeNode && badgeNode.object3D) {
          badgeNode.object3D.visible = (badgeAbsY > TILE_AREA_BOTTOM_Y && badgeAbsY < TILE_AREA_TOP_Y);
        }
      });
      perfMark('grid.stubs.rendered');
    }

    function onBrowsePanelOpen() {
      perfClearAll();
      perfMark('open');
      // First open: enable renderer local clipping + compute the band's
      // world-space planes from the panel's transform. Cheap to call again
      // on every open (the panel's transform doesn't change, but this lets
      // us recover if the user resized/relocated the panel later).
      setupBrowseClipping();
      // Re-apply clip planes to existing tile cover materials (those whose
      // texture loaded *before* setupBrowseClipping ran on first open).
      document.querySelectorAll('#vrBrowseTiles .vr-tile-cover').forEach(function(c) {
        const mesh = c.getObject3D && c.getObject3D('mesh');
        if (mesh && mesh.material) {
          mesh.material.clippingPlanes = browseClipPlanes;
          mesh.material.clipShadows = false;
          mesh.material.needsUpdate = true;
        }
      });
      fetchGrid(true);
      ensureFacetCatalog().finally(function() {
        ['performer', 'tag', 'studio'].forEach(renderColumnList);
      });
      ensureFacetMatrix().finally(function() {
        ['performer', 'tag', 'studio'].forEach(renderColumnList);
      });
      ['performer', 'tag', 'studio'].forEach(renderColumnList);
      setTimeout(function() {
        perfReport('json wait', 'open', 'grid.json.received');
        perfReport('stub render', 'grid.json.received', 'grid.stubs.rendered');
        perfReport('hydration', 'grid.stubs.rendered', 'grid.hydration.complete');
        perfReport('catalog', 'open', 'facets.catalog.received');
        perfReport('matrix', 'open', 'facets.matrix.received');
      }, 5000);
    }

    function vrAction(action, el) {
      if (action === 'playpause') {
        if (video.paused) {
          const p = video.play();
          if (p && p.catch) p.catch(err => console.warn('stash-vr: video play failed', err));
        } else {
          video.pause();
        }
      } else if (action === 'mute') {
        video.muted = !video.muted;
        updateMuteIcon();
        refreshVolumeUI();
      } else if (action === 'speed') {
        speedIdx = (speedIdx + 1) % SPEEDS.length;
        video.playbackRate = SPEEDS[speedIdx];
        if ('preservesPitch' in video) video.preservesPitch = true;
        updateSpeedLabel();
      } else if (action === 'loop') {
        video.loop = !video.loop;
        updateLoopBtn();
      } else if (action === 'exit') {
        try { scene.exitVR(); } catch (e) { console.warn('stash-vr: exitVR failed', e); }
      } else if (action === 'format') {
        if (picker) {
          const visible = picker.getAttribute('visible');
          const willShow = !(visible === true || visible === 'true');
          if (willShow) closeAllSubpanels('vrFormatPicker');
          setSubpanelVisible('vrFormatPicker', willShow);
        }
      } else if (action === 'help') {
        const help = document.getElementById('vrHelpPanel');
        if (help) {
          const visible = help.getAttribute('visible');
          const willShow = !(visible === true || visible === 'true');
          if (willShow) closeAllSubpanels('vrHelpPanel');
          setSubpanelVisible('vrHelpPanel', willShow);
        }
      } else if (action === 'help-close') {
        setSubpanelVisible('vrHelpPanel', false);
      } else if (action === 'browse') {
        const bp = document.getElementById('vrBrowsePanel');
        if (bp) {
          const visible = bp.getAttribute('visible');
          const willShow = !(visible === true || visible === 'true');
          if (willShow) closeAllSubpanels('vrBrowsePanel');
          setSubpanelVisible('vrBrowsePanel', willShow);
          if (willShow) onBrowsePanelOpen();
        }
      } else if (action === 'browse-close') {
        // Cascade closes the filters extension too via the
        // setSubpanelVisible traverse (filters is a child of browse).
        setSubpanelVisible('vrBrowsePanel', false);
      } else if (action === 'picker-search-focus') {
        // Step 5: retarget the hidden <input> at the tapped column.
        // Tap-to-clear: wipe target's state slot + curved label + input
        // before focusing, so Quest's always-empty keyboard pop matches
        // a clean state. Existing filtered results refresh accordingly.
        const kind = el && el.dataset && el.dataset.pickerKind;
        if (!kind) return;
        browseState.overlayTarget = 'picker-' + kind;
        browseState.lastScrollFocus = 'list-' + kind;
        const had = browseState.pickerQuery[kind] !== '';
        browseState.pickerQuery[kind] = '';
        if (typeof window._browseClearSearchTarget === 'function') {
          window._browseClearSearchTarget('picker-' + kind);
        }
        if (had) {
          browseState.listScrollY[kind] = 0;
          renderColumnList(kind);
        }
        const si = document.getElementById('vrSearchInput');
        if (si) si.focus();
      } else if (action === 'filters-clear') {
        // M4c Task 7: "Clear all" wipes every filter (incl. q + arrays),
        // resets in-VR search input/labels, re-renders chips + per-column
        // lists, refetches.
        browseState.q = '';
        browseState.filters     = { performer: [], studio: [], tag: [], favorite: '', stars: 0, ocount: 0 };
        browseState.filterNames = { performer: [], studio: [], tag: [] };
        browseState.pickerQuery = { performer: '', studio: '', tag: '' };
        const si = document.getElementById('vrSearchInput');
        if (si) si.value = '';
        const browseSearchBg = document.querySelector('a-cylinder.vr-search-bg[data-action="search-focus"]');
        if (browseSearchBg) {
          browseSearchBg.setAttribute('data-label', 'Search…');
          browseSearchBg.setAttribute('data-label-color', '#888');
          curveLabelInto(browseSearchBg);
        }
        document.querySelectorAll('a-cylinder.vr-search-bg[data-action="picker-search-focus"]').forEach(bg => {
          bg.setAttribute('data-label', 'Search…');
          bg.setAttribute('data-label-color', '#888');
          curveLabelInto(bg);
        });
        renderActiveChips();
        ['performer', 'tag', 'studio'].forEach(kind => {
          browseState.listScrollY[kind] = 0;
        });
        rerenderAllFacetColumns();
        renderValuesRow();
        fetchGrid(true);
      } else if (action === 'filter-chip-clear') {
        // The chip's own click handler already calls clearChip(kind);
        // this dispatcher branch is a no-op kept here so the global
        // .vr-btn click router doesn't log an unknown-action warning.
      } else if (action === 'toggle-debug-overlay') {
        // Not a sub-panel — no raycast targets, so direct setAttribute is fine.
        const dbg = document.getElementById('vrDebugOverlay');
        if (dbg) {
          const v = dbg.getAttribute('visible');
          dbg.setAttribute('visible', !(v === true || v === 'true'));
        }
      } else if (action === 'search-focus') {
        // Retarget the hidden <input> at the grid search. Tap-to-clear:
        // wipe q + curved label + input value before focusing so the
        // empty Quest keyboard pop matches a clean state.
        browseState.overlayTarget = 'grid';
        const had = browseState.q !== '';
        browseState.q = '';
        if (typeof window._browseClearSearchTarget === 'function') {
          window._browseClearSearchTarget('grid');
        }
        if (had) fetchGrid(true);
        const si = document.getElementById('vrSearchInput');
        if (si) si.focus();
      } else if (action === 'cols-cycle') {
        browseCols = (browseCols >= 6) ? 3 : (browseCols + 1);
        localStorage.setItem('browse.cols', String(browseCols));
        updateColsLabel();
        if (typeof relayoutTiles === 'function') relayoutTiles(); // Task 4 defines
      } else if (action === 'cc') {
        const sub = document.getElementById('vrSubtitlePicker');
        if (sub) {
          const visible = sub.getAttribute('visible');
          if (visible === true || visible === 'true') {
            setSubpanelVisible('vrSubtitlePicker', false);
          } else {
            closeAllSubpanels('vrSubtitlePicker');
            setSubpanelVisible('vrSubtitlePicker', true);
          }
        }
      } else if (action === 'scrub' || action === 'scrub-bg') {
        // No-op here; the scrub-bar drag handles seeking via mousedown.
      }
      // 'vol-track' is a no-op (the slider drag uses mousedown).
    }
    document.querySelectorAll('.vr-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const action = btn.dataset.action || btn.getAttribute('data-action');
        if (action) {
          vrAction(action, btn);
          return;
        }
        const row = btn.dataset.pickRow;
        const value = btn.dataset.pickValue;
        if (row) handlePickerTap(row, value);
      });
    });

    // Volume slider drag — write video.volume in [0, 1] from cursor X across
    // the slider track. Local-X math: slider element is at panel-local
    // (-0.96, -0.20, 0.01); track center is the slider's origin and spans
    // -0.20 .. +0.20 (width 0.40). worldToLocal converts the raycaster's
    // world-space hit into the slider's local frame.
    const VOL_BAR_W = 0.40;
    const VOL_BAR_LEFT = -0.20;
    let volActive = false;

    function cursorToVol(intersection) {
      const slider = document.getElementById('vrVolumeSlider');
      if (!slider || !slider.object3D || !intersection || !intersection.point) return null;
      const local = slider.object3D.worldToLocal(intersection.point.clone());
      return Math.max(0, Math.min(1, (local.x - VOL_BAR_LEFT) / VOL_BAR_W));
    }

    // Pick whichever laser currently has a non-empty intersection list.
    // raycaster-intersection only fires on list change, so for per-frame
    // sampling during a drag we poll the raycaster component directly.
    function activeLaserIntersection() {
      const ids = ['vrLaserRight', 'vrLaserLeft'];
      for (let i = 0; i < ids.length; i++) {
        const el = document.getElementById(ids[i]);
        if (!el) continue;
        const rc = el.components && el.components.raycaster;
        if (!rc) continue;
        const its = rc.intersections || [];
        if (its.length) return its[0];
      }
      return null;
    }

    function tickSliders() {
      if (!volActive && !scrubActive) return;
      const hit = activeLaserIntersection();
      if (!hit) return;
      if (volActive) {
        const v = cursorToVol(hit);
        if (v !== null) setVideoVolume(v);
      }
      if (scrubActive) {
        const t = cursorToScrubT(hit);
        if (t !== null) setVideoTime(t, true);
      }
    }

    // Browse-panel thumbstick scroll. Polls the same axis source M3c uses
    // (controller.gamepad.axes / tracked-controls.axis), so we never have
    // to subscribe to thumbstickmoved events that may not fire on every
    // platform. Active only while the browse panel is visible AND a laser
    // is intersecting one of its surfaces — that's also the gate that tells
    // vr:scale to skip (so the user doesn't simultaneously scale the
    // cinema/immersive geometry while scrolling the grid). M4c spec §4.4:
    // stick-up (positive normalized y) → scroll up (decrease scrollY).
    function _readThumbstickAxes(laserEl) {
      if (!laserEl) return null;
      const tc = laserEl.components && laserEl.components['tracked-controls'];
      const ctrl = tc && tc.controller;
      const axes = (ctrl && ctrl.gamepad && ctrl.gamepad.axes) || (tc && tc.axis) || null;
      if (!axes || axes.length < 2) return null;
      const safe = (n) => (typeof n === 'number' && !isNaN(n)) ? n : 0;
      // Same dual-slot probe as controls._getThumbstick.
      const x2 = axes.length >= 3 ? safe(axes[2]) : 0;
      const y2 = axes.length >= 4 ? safe(axes[3]) : 0;
      const x0 = safe(axes[0]);
      const y0 = safe(axes[1]);
      const x = Math.abs(x2) > 0.001 ? x2 : x0;
      const y = Math.abs(y2) > 0.001 ? y2 : y0;
      return { x: x, y: y };
    }
    function _laserIsOnBrowsePanel(laserEl) {
      if (!laserEl) return false;
      const rc = laserEl.components && laserEl.components.raycaster;
      if (!rc) return false;
      const its = rc.intersections || [];
      if (!its.length) return false;
      let target = its[0].el || (its[0].object && its[0].object.el);
      if (!target) return false;
      // Walk up the DOM tree; if we hit #vrBrowsePanel, the laser is on
      // some descendant (tile cover, badge, top-strip button, bg). Any of
      // those should let the thumbstick scroll the grid — otherwise users
      // had to keep the laser on a tile cover, which is fiddly.
      while (target) {
        if (target.id === 'vrBrowsePanel') return true;
        target = target.parentElement;
      }
      return false;
    }
    // M4c Task 7 Step 6: figure out which surface the laser is over so the
    // thumbstick scrolls the right list. Walks up the DOM from the first
    // intersection: a #vrFiltersList-{kind} ancestor under #vrBrowsePanel
    // means the user is pointing at a column → scroll that column. Anything
    // else under #vrBrowsePanel → scroll the tile grid. No browse-panel
    // ancestor → null (laser is off-panel; caller bails).
    function _laserBrowseScrollTarget(laserEl) {
      if (!laserEl) return null;
      const rc = laserEl.components && laserEl.components.raycaster;
      if (!rc) return null;
      const its = rc.intersections || [];
      if (!its.length) return null;
      let target = its[0].el || (its[0].object && its[0].object.el);
      if (!target) return null;
      let onBrowsePanel = false;
      let columnKind = null;
      while (target) {
        // Column attribution. The list-row entities live under
        // #vrFiltersList-{kind}, but the lane bg / header / search-bar
        // cylinders carry data-col-kind directly so the laser still
        // routes to a column even when it lands in a row gap or below
        // the last filled row (where the lane bg is the closest hit).
        if (!columnKind) {
          if (target.id && target.id.indexOf('vrFiltersList-') === 0) {
            columnKind = target.id.substring('vrFiltersList-'.length);
          } else if (target.dataset && target.dataset.colKind) {
            columnKind = target.dataset.colKind;
          }
        }
        if (target.id === 'vrBrowsePanel') { onBrowsePanel = true; break; }
        target = target.parentElement;
      }
      if (!onBrowsePanel) return null;
      return columnKind ? ('list-' + columnKind) : 'grid';
    }
    // Diagnostics — writes what each laser's first intersection is hitting
    // into the in-VR debug overlay AND into window.svDebugLasers().
    function _summarizeIntersection(its) {
      if (!its || !its.length) return '(none)';
      return its.slice(0, 3).map(i => {
        const el = i.el || (i.object && i.object.el);
        if (!el) return '?';
        const id  = el.id ? '#' + el.id : '';
        const cls = el.className ? '.' + String(el.className).split(' ').filter(Boolean).join('.') : '';
        const tag = el.tagName ? el.tagName.toLowerCase() : '?';
        const dist = (typeof i.distance === 'number') ? i.distance.toFixed(2) : '?';
        return tag + id + cls + '@' + dist;
      }).join(' | ');
    }
    function _laserHits(laserId) {
      const el = document.getElementById(laserId);
      if (!el) return '(no laser)';
      const rc = el.components && el.components.raycaster;
      return _summarizeIntersection(rc && rc.intersections);
    }
    window.svDebugLasers = function () {
      return { right: _laserHits('vrLaserRight'), left: _laserHits('vrLaserLeft') };
    };

    let browseLastScrollTickMs = 0;
    function _setDbg(line1, line2) {
      const dbg = document.getElementById('vrDebugOverlayText');
      if (!dbg) return;
      // Use the text component's value prop directly — setAttribute('value', ...)
      // on an a-text triggers a full schema reparse and can be flaky.
      dbg.setAttribute('text', 'value', (line1 || '') + (line2 ? '\n' + line2 : ''));
    }
    function tickBrowseScroll() {
      const bp = document.getElementById('vrBrowsePanel');
      const bpVis = bp && (bp.getAttribute('visible') === true || bp.getAttribute('visible') === 'true');

      // Pick whichever laser is currently on a browse-panel surface.
      const lasers = ['vrLaserRight', 'vrLaserLeft'].map(id => document.getElementById(id));
      let activeLaser = null;
      for (let i = 0; i < lasers.length; i++) {
        if (_laserIsOnBrowsePanel(lasers[i])) { activeLaser = lasers[i]; break; }
      }

      // Update diagnostic overlay only if it's currently visible (toggled
      // on by the DBG button on the playback panel). Saves the per-frame
      // a-text reflow when the user isn't looking at the diagnostics.
      const dbgRoot = document.getElementById('vrDebugOverlay');
      const dbgVis = dbgRoot && (dbgRoot.getAttribute('visible') === true ||
                                 dbgRoot.getAttribute('visible') === 'true');
      if (dbgVis) {
        const tsR = _readThumbstickAxes(document.getElementById('vrLaserRight')) || { x: 0, y: 0 };
        const tsL = _readThumbstickAxes(document.getElementById('vrLaserLeft'))  || { x: 0, y: 0 };
        const dbgLine1 = 'R hits: ' + _laserHits('vrLaserRight');
        const dbgLine2 = 'sy R=' + tsR.y.toFixed(2) + ' L=' + tsL.y.toFixed(2) +
                         ' scroll=' + scrollY.toFixed(2) +
                         '/' + browseMaxScroll.toFixed(2) +
                         ' onPanel=' + (activeLaser ? activeLaser.id.replace('vrLaser','') : 'no') +
                         ' bp=' + (bpVis ? '1' : '0');
        _setDbg(dbgLine1, dbgLine2);
      }

      if (!bpVis) {
        browseConsumeThumbY = false;
        browseLastScrollTickMs = 0;
        return;
      }
      if (!activeLaser) {
        browseConsumeThumbY = false;
        browseLastScrollTickMs = 0;
        return;
      }
      browseConsumeThumbY = true;  // suppress vr:scale while we own thumbstick

      const ts = _readThumbstickAxes(activeLaser);
      if (!ts) { browseLastScrollTickMs = 0; return; }
      // xr-standard: stick-up reads as ts.y = -1, stick-down as +1.
      // Deadzone matches M3c's scale gate (0.3) so light drift doesn't scroll.
      if (Math.abs(ts.y) < 0.3) { browseLastScrollTickMs = 0; return; }

      const now = performance.now();
      const dt = browseLastScrollTickMs ? Math.min(0.1, (now - browseLastScrollTickMs) / 1000) : 1 / 60;
      browseLastScrollTickMs = now;

      // M4c Task 7 Step 6: route the scroll to whichever surface the laser
      // is hovering on. Pointing at a filter column → scroll that column's
      // option list; anywhere else on the browse panel → scroll the tile
      // grid (existing behavior).
      const scrollTarget = _laserBrowseScrollTarget(activeLaser);
      if (scrollTarget && scrollTarget.indexOf('list-') === 0) {
        applyListScroll(scrollTarget.substring(5), ts.y, dt);
        return;
      }

      // 0.6 m/s at full deflection. Stick DOWN (ts.y = +1) → scroll
      // forward (scrollY INCREASES → tiles shift up → next rows revealed
      // below). Stick UP reverses; scrollY clamps at 0 (top). Matches the
      // mobile "drag down to scroll down" convention requested by the user.
      const rate = 0.6;
      const target = scrollY + ts.y * rate * dt;
      const clamped = Math.max(0, Math.min(target, browseMaxScroll));
      if (Math.abs(clamped - scrollY) < 0.0001) return;
      scrollY = clamped;
      relayoutTiles();
      // Lazy-load when nearing the bottom of currently-loaded content. The
      // 0.5m buffer gives time for the fetch round-trip before the user
      // scrolls past the end.
      if (browseState.hasMore && !browseState.loading && scrollY > browseMaxScroll - 0.5) {
        fetchGrid(false);
      }
    }

    function refreshVolumeUI() {
      const displayed = video.muted ? 0 : video.volume;
      const fill = document.getElementById('vrVolumeFill');
      const thumb = document.getElementById('vrVolumeThumb');
      const w = displayed * VOL_BAR_W;
      if (fill) {
        // A-Frame plane width must be > 0; use a hairline minimum.
        fill.setAttribute('width', Math.max(0.001, w));
        fill.setAttribute('position', { x: VOL_BAR_LEFT + w / 2, y: 0, z: 0.001 });
      }
      if (thumb) {
        thumb.setAttribute('position', { x: VOL_BAR_LEFT + w, y: 0, z: 0.005 });
      }
    }

    function setVideoVolume(v) {
      video.volume = Math.max(0, Math.min(1, v));
      // Dragging the slider unmutes — matches HTML5 video element semantics
      // and avoids the user wondering why volume changes don't take effect.
      if (video.muted && video.volume > 0) {
        video.muted = false;
        updateMuteIcon();
      }
      refreshVolumeUI();
    }

    document.querySelectorAll('.vr-vol-track, .vr-vol-thumb').forEach(el => {
      el.addEventListener('mousedown', function(evt) {
        volActive = true;
        const intersection = evt.detail && evt.detail.intersection;
        if (intersection) {
          const v = cursorToVol(intersection);
          if (v !== null) setVideoVolume(v);
        }
      });
      el.addEventListener('mouseup', function() { volActive = false; });
    });

    // Drag sampling itself happens in tickSliders() inside the panel-tickers
    // component. The cleared listener stays as a backstop: if the laser leaves all
    // targets mid-drag, the matching mouseup fires on whatever the laser
    // landed on (often nothing), so we end the drag here instead.
    ['vrLaserRight', 'vrLaserLeft'].forEach(id => {
      const laser = document.getElementById(id);
      if (!laser) return;
      laser.addEventListener('raycaster-intersection-cleared', function() {
        volActive = false;
      });
    });

    // Backstop: any mouseup anywhere ends the drag. Cheap; runs only on click.
    scene.addEventListener('mouseup', function() { volActive = false; });

    // Slider drag — driven by controller-level triggerdown/up events on the
    // lasers themselves. The cursor synthetic mousedown/mouseup events
    // proved unreliable for sustained drags (cursor emits mouseup as soon
    // as the laser leaves the hit entity, killing the active flag). Use
    // the same event source M3c uses for its trigger state machine.
    function _laserHitTarget(intersection) {
      if (!intersection) return null;
      return intersection.el || (intersection.object && intersection.object.el) || null;
    }

    ['vrLaserRight', 'vrLaserLeft'].forEach(id => {
      const laser = document.getElementById(id);
      if (!laser) return;
      laser.addEventListener('triggerdown', function() {
        const rc = laser.components && laser.components.raycaster;
        if (!rc) return;
        const its = rc.intersections || [];
        if (!its.length) return;
        const intersection = its[0];
        const target = _laserHitTarget(intersection);
        if (!target || !target.classList) return;
        const cl = target.classList;
        if (cl.contains('vr-vol-track') || cl.contains('vr-vol-thumb')) {
          volActive = true;
          const v = cursorToVol(intersection);
          if (v !== null) setVideoVolume(v);
        } else if (cl.contains('vr-scrub-marker')) {
          // Marker click: jump to its seconds (no drag).
          const secs = parseFloat(target.dataset.markerSeconds);
          if (!isNaN(secs)) setVideoTime(secs, false);
        } else if (cl.contains('vr-scrub') || cl.contains('vr-scrub-bg')) {
          scrubActive = true;
          const t = cursorToScrubT(intersection);
          if (t !== null) setVideoTime(t, false);
        }
      });
      laser.addEventListener('triggerup', function() {
        volActive = false;
        scrubActive = false;
      });
    });

    // Initialize volume to 1.0; this also positions the fill + thumb at the right edge.
    setVideoVolume(1.0);

    function formatTime(s) {
      if (!isFinite(s) || s < 0) s = 0;
      const total = Math.floor(s);
      const h = Math.floor(total / 3600);
      const m = Math.floor((total % 3600) / 60);
      const sec = total % 60;
      if (h > 0) return h + ':' + String(m).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
      return m + ':' + String(sec).padStart(2, '0');
    }

    let lastTimeUpdateMs = 0;
    function tickTimeDisplay(nowMs) {
      // Throttle to ~1 Hz: <a-text> re-renders are expensive enough that
      // running them per-frame burns frame budget for no visible benefit.
      if (nowMs - lastTimeUpdateMs < 1000) return;
      lastTimeUpdateMs = nowMs;
      const el = document.getElementById('vrTime');
      if (!el) return;
      const cur = formatTime(video.currentTime || 0);
      const dur = formatTime(video.duration || 0);
      setPlaybackTime(cur + ' / ' + dur);
    }

    // M4c Task 8: array kept as a stable reference but mutated in place
    // by refreshSceneMeta on a swap so renderSubtitlePicker rebuilds from
    // the new scene's caption tracks.
    const captionsData = {{ marshal .Captions }} || [];

    // Picker layout — buttons in a wrapping flex of up to 4 per row.
    function renderSubtitlePicker() {
      const buttonsRoot = document.getElementById('vrSubtitlePickerButtons');
      const bg = document.getElementById('vrSubtitlePickerBg');
      const title = document.getElementById('vrSubtitlePickerTitle');
      if (!buttonsRoot) return;
      while (buttonsRoot.firstChild) buttonsRoot.removeChild(buttonsRoot.firstChild);

      const items = [{ lang: '', type: '', label: 'Off' }].concat(
        captionsData.map(c => ({ lang: c.languageCode, type: c.captionType, label: c.languageCode }))
      );
      const PER_ROW = 4;
      const BTN_W = 0.40;
      const BTN_H = 0.16;
      const GAP_X = 0.06;
      const ROW_H = 0.20;
      const rowCount = Math.max(1, Math.ceil(items.length / PER_ROW));

      const bgHeight = 0.18 + rowCount * ROW_H;
      if (bg) bg.setAttribute('height', bgHeight.toFixed(2));
      if (title) title.setAttribute('position', '-0.85 ' + ((bgHeight / 2) - 0.07).toFixed(2) + ' 0.01');

      items.forEach((it, i) => {
        const row = Math.floor(i / PER_ROW);
        const col = i % PER_ROW;
        const xCenter = -((PER_ROW - 1) / 2) * (BTN_W + GAP_X) + col * (BTN_W + GAP_X);
        const yCenter = ((rowCount - 1) / 2) * ROW_H - row * ROW_H - 0.02;

        const btn = document.createElement('a-entity');
        btn.classList.add('vr-btn', 'vr-cc-pick');
        btn.dataset.ccLang = it.lang;
        btn.dataset.ccType = it.type;
        btn.setAttribute('geometry', 'primitive:plane;width:' + BTN_W + ';height:' + BTN_H);
        btn.setAttribute('material', 'color:#2c5282;opacity:0.95');
        btn.setAttribute('position', xCenter.toFixed(3) + ' ' + yCenter.toFixed(3) + ' 0.005');

        const text = document.createElement('a-text');
        text.setAttribute('value', it.label);
        text.setAttribute('align', 'center');
        text.setAttribute('color', '#fff');
        text.setAttribute('width', '2.5');
        text.setAttribute('position', '0 0 0.005');
        btn.appendChild(text);
        buttonsRoot.appendChild(btn);
        // Direct click handler — the global .vr-btn click router only fires
        // vrAction(data-action) or handlePickerTap(data-pick-row); these
        // language buttons have neither, so no double-fire.
        btn.addEventListener('click', () => handleCCPick(it.lang, it.type));
      });
    }
    scene.addEventListener('loaded', renderSubtitlePicker);
    // Refresh raycaster targets after the scene loads. A-Frame fires
    // 'loaded' listeners in registration order, so by the time this runs
    // renderSubtitlePicker has already created the dynamic subtitle
    // language buttons. Without this, the initial selector is whatever
    // the static markup specifies and any sub-panel that flips visible
    // before a subsequent setSubpanelVisible call would have stale
    // targets.
    scene.addEventListener('loaded', updateRaycasterTargets);

    // Parses VTT and SRT. Both share the cue-timing line shape
    //   HH:MM:SS.mmm --> HH:MM:SS.mmm   (VTT uses '.', SRT uses ',')
    // The regex matches [\.,] so a single regex covers both. SRT's bare
    // cue-number lines don't match and are skipped naturally. ASS / SSA
    // / other formats produce zero matches and the picker silently
    // stays at "no cues."
    function parseSubtitles(text) {
      const cues = [];
      const lines = text.split(/\r?\n/);
      for (let i = 0; i < lines.length; i++) {
        const m = lines[i].match(/(\d{2}):(\d{2}):(\d{2})[\.,](\d{3})\s+-->\s+(\d{2}):(\d{2}):(\d{2})[\.,](\d{3})/);
        if (!m) continue;
        const start = (+m[1]) * 3600 + (+m[2]) * 60 + (+m[3]) + (+m[4]) / 1000;
        const end   = (+m[5]) * 3600 + (+m[6]) * 60 + (+m[7]) + (+m[8]) / 1000;
        const payload = [];
        i++;
        while (i < lines.length && lines[i].trim() !== '') {
          payload.push(lines[i].replace(/<[^>]+>/g, ''));
          i++;
        }
        cues.push({ start: start, end: end, text: payload.join('\n') });
      }
      return cues;
    }

    let currentCues = [];
    let currentLang = '';

    function handleCCPick(lang, type) {
      setSubpanelVisible('vrSubtitlePicker', false);
      if (!lang) {
        currentCues = [];
        currentLang = '';
        return;
      }
      fetch('/browse/scene/' + encodeURIComponent(sceneId) + '/caption?lang=' + encodeURIComponent(lang) + '&type=' + encodeURIComponent(type))
        .then(r => r.text())
        .then(text => {
          currentCues = parseSubtitles(text);
          currentLang = lang;
        })
        .catch(err => console.warn('stash-vr: caption fetch failed', err));
    }

    // Reparent the subtitle plane based on the active geometry. Cinema mode
    // (vrFlat is the active entity) → child of vrFlat at its bottom edge.
    // Immersive (sphere/fisheye) → child of the camera, in front-low. Use
    // the Three.js object3D parent/add path so we don't fight A-Frame's
    // scene-graph component lifecycle.
    function reparentSubtitlePlane() {
      const subEl = document.getElementById('vrSubtitlePlane');
      if (!subEl || !subEl.object3D) return;
      const active = activeGeometry();
      let targetObj = null;
      if (active && active.id === 'vrFlat' && active.object3D) {
        targetObj = active.object3D;
        subEl.object3D.position.set(0, -1.0, 0.01);
      } else {
        const cam = scene.camera;
        if (!cam) return;
        targetObj = cam;
        subEl.object3D.position.set(0, -0.5, -1.5);
      }
      if (subEl.object3D.parent !== targetObj) {
        if (subEl.object3D.parent) subEl.object3D.parent.remove(subEl.object3D);
        targetObj.add(subEl.object3D);
      }
    }

    // CanvasTexture-backed subtitle rendering. Lazily binds a canvas to
    // the vrSubtitleSurface plane's material so any Unicode the
    // browser can render (CJK, Cyrillic, etc.) shows up — A-Frame's
    // default MSDF font is Latin-only.
    const subtitleCanvas = document.createElement('canvas');
    subtitleCanvas.width = 2048;
    subtitleCanvas.height = 256; // matches 1.6:0.18 plane aspect (8.89:1) closely enough
    const subtitleCtx = subtitleCanvas.getContext('2d');
    const subtitleTexture = AFRAME.THREE
      ? new AFRAME.THREE.CanvasTexture(subtitleCanvas)
      : null;
    if (subtitleTexture) {
      subtitleTexture.minFilter = AFRAME.THREE.LinearFilter;
      subtitleTexture.magFilter = AFRAME.THREE.LinearFilter;
      subtitleTexture.generateMipmaps = false;
    }
    let subtitleSurfaceBound = false;
    function bindSubtitleSurface() {
      if (subtitleSurfaceBound || !subtitleTexture) return;
      const el = document.getElementById('vrSubtitleSurface');
      if (!el) return;
      const mesh = el.getObject3D('mesh');
      if (!mesh) {
        el.addEventListener('object3dset', bindSubtitleSurface, { once: true });
        return;
      }
      mesh.material = new AFRAME.THREE.MeshBasicMaterial({
        map: subtitleTexture,
        transparent: true,
        side: AFRAME.THREE.DoubleSide,
        depthWrite: false
      });
      subtitleSurfaceBound = true;
    }
    scene.addEventListener('loaded', bindSubtitleSurface);

    function paintSubtitleText(text) {
      if (!subtitleCtx || !subtitleTexture) return;
      const W = subtitleCanvas.width, H = subtitleCanvas.height;
      subtitleCtx.clearRect(0, 0, W, H);
      subtitleCtx.fillStyle = 'rgba(0, 0, 0, 0.55)';
      subtitleCtx.fillRect(0, 0, W, H);
      subtitleCtx.fillStyle = '#fff';
      // Native font stack so the browser falls back through CJK /
      // Cyrillic / Arabic system fonts as needed.
      subtitleCtx.font = 'bold 64px "Noto Sans CJK SC", "Noto Sans CJK JP", "Hiragino Sans", "Yu Gothic", "Microsoft YaHei", Arial, sans-serif';
      subtitleCtx.textAlign = 'center';
      subtitleCtx.textBaseline = 'middle';
      const lines = (text || '').split('\n');
      const lineHeight = 80;
      const startY = H / 2 - (lines.length - 1) * lineHeight / 2;
      lines.forEach(function(line, i) {
        subtitleCtx.fillText(line, W / 2, startY + i * lineHeight);
      });
      subtitleTexture.needsUpdate = true;
    }

    function tickSubtitles() {
      const plane = document.getElementById('vrSubtitlePlane');
      if (!plane) return;
      if (!currentCues.length) {
        plane.setAttribute('visible', 'false');
        return;
      }
      reparentSubtitlePlane();
      const t = video.currentTime || 0;
      let active = null;
      for (let i = 0; i < currentCues.length; i++) {
        if (t >= currentCues[i].start && t <= currentCues[i].end) {
          active = currentCues[i];
          break;
        }
      }
      if (active) {
        if (!subtitleSurfaceBound) bindSubtitleSurface();
        paintSubtitleText(active.text);
        plane.setAttribute('visible', 'true');
      } else {
        plane.setAttribute('visible', 'false');
      }
    }

    // Per-frame work runs from an A-Frame component's tick callback rather
    // than window.requestAnimationFrame because the WebXR spec freezes
    // window.rAF callbacks while an XRSession is presenting. A-Frame's
    // tick system bridges window.rAF (out of XR) and XRSession.rAF (in XR)
    // so it fires reliably in both modes — which is exactly when the user
    // is actually looking at the HUD. Each tick is wrapped in try/catch
    // so one ticker's error doesn't kill the loop and freeze every
    // per-frame UI update. The component is registered + attached at the
    // bottom of the IIFE after all four tick* functions are declared.

    // tickBrowseScroll reads laser raycaster intersections — those are
    // updated by A-Frame's raycaster component during the scene tick,
    // which runs AFTER our window.requestAnimationFrame callback. So we
    // can't read them from rafLoop or we'll see stale/empty data. Run
    // the browse-scroll tick from an A-Frame component instead, whose
    // tick() fires inside the scene tick — i.e. after the raycaster has
    // updated its intersections array for this frame.
    AFRAME.registerComponent('browse-tick', {
      tick: function () {
        try { tickBrowseScroll(); } catch (e) { console.warn('stash-vr: tickBrowseScroll', e); }
        try { drainTileHydration(); } catch (e) { console.warn('stash-vr: drainTileHydration', e); }
      },
    });
    scene.setAttribute('browse-tick', '');

    // ============================================================
    // Scrub bar: per-frame fill/thumb advance, drag-to-seek, scene
    // marker dots with jump-on-click + tooltip-on-hover.
    // ============================================================

    // Bar geometry: centered at x=0 inside vrScrubBar; left/right map to
    // -1.4..+1.4 in panel-local space.
    const SCRUB_BAR_W = 2.8;
    const SCRUB_BAR_LEFT = -1.4;
    const SCRUB_ARC_HALF_DEG = Math.asin((SCRUB_BAR_W / 2) / SCRUB_VISUAL_RADIUS) * 180 / Math.PI;
    const SCRUB_ARC_START_DEG = 180 - SCRUB_ARC_HALF_DEG;
    const SCRUB_ARC_LENGTH_DEG = SCRUB_ARC_HALF_DEG * 2;
    const SCRUB_ARC_END_DEG = SCRUB_ARC_START_DEG + SCRUB_ARC_LENGTH_DEG;

    // null when the scene has no markers (server emits JSON null). Coerce to
    // [] so .length / forEach are always safe.
    // M4c Task 8: sceneMarkers stays const (mutated in place on swap);
    // sceneDurationSec is `let` so refreshSceneMeta can reassign after a
    // scene swap before the new video.duration is reported.
    const sceneMarkers = {{ marshal .SceneMarkers }} || [];
    let sceneDurationSec = {{ printf "%f" .DurationSec }};

    function tForMarkerX(secs) {
      if (!sceneDurationSec) return SCRUB_BAR_LEFT;
      return SCRUB_BAR_LEFT + (secs / sceneDurationSec) * SCRUB_BAR_W;
    }

    function projectScrubChild(el, flatX, zLift) {
      if (!el) return;
      // curvePanelElement caches its first input in el.dataset.flatX and
      // re-uses that on every subsequent call (so a curved element can be
      // re-projected without re-flattening). For the thumb and marker dots
      // — which we want to move every frame — that cache pins them to their
      // initial X forever. Overwrite the cache so the new flatX wins.
      el.dataset.flatX = String(flatX);
      el.setAttribute('position', { x: flatX, y: 0, z: zLift || 0.005 });
      curvePanelElement(el, SCRUB_VISUAL_RADIUS, zLift || 0.005, PANEL_CURVE_HUB_Z);
    }

    function tickScrubBar() {
      const dur = isFinite(video.duration) && video.duration > 0
        ? video.duration
        : sceneDurationSec;
      if (!dur) return;
      const t = Math.max(0, Math.min(dur, video.currentTime || 0));
      const ratio = t / dur;
      const fill = document.getElementById('vrScrubFill');
      const thumb = document.getElementById('vrScrubThumb');
      if (fill) {
        const fillTheta = Math.max(SCRUB_FILL_MIN_DEG, ratio * SCRUB_ARC_LENGTH_DEG);
        fill.setAttribute('theta-start', (SCRUB_ARC_END_DEG - fillTheta).toFixed(3));
        fill.setAttribute('theta-length', fillTheta.toFixed(3));
      }
      if (thumb) {
        projectScrubChild(thumb, SCRUB_BAR_LEFT + ratio * SCRUB_BAR_W, SCRUB_THUMB_Z);
      }
    }

    let scrubActive = false;
    let scrubLastWriteMs = 0;
    const SCRUB_THROTTLE_MS = 80;

    function cursorToScrubT(intersection) {
      const bar = document.getElementById('vrScrubBar');
      if (!bar || !bar.object3D || !intersection || !intersection.point) return null;
      const local = bar.object3D.worldToLocal(intersection.point.clone());
      const ratio = Math.max(0, Math.min(1, (local.x - SCRUB_BAR_LEFT) / SCRUB_BAR_W));
      const dur = isFinite(video.duration) && video.duration > 0
        ? video.duration
        : sceneDurationSec;
      if (!dur) return null;
      return ratio * dur;
    }

    function setVideoTime(t, throttle) {
      const now = performance.now();
      if (throttle && now - scrubLastWriteMs < SCRUB_THROTTLE_MS) return;
      scrubLastWriteMs = now;
      video.currentTime = t;
    }

    // Marker tooltip: a single floating <a-text> reused across all markers.
    // Built lazily inside an IIFE so the bar element exists at attach time.
    const markerTip = (function() {
      const t = document.createElement('a-text');
      t.setAttribute('id', 'vrScrubMarkerTip');
      t.setAttribute('color', '#fff');
      t.setAttribute('width', '3');
      t.setAttribute('align', 'center');
      t.setAttribute('value', '');
      t.setAttribute('visible', 'false');
      t.setAttribute('position', '0 0.10 0.01');
      const bar = document.getElementById('vrScrubBar');
      if (bar) bar.appendChild(t);
      return t;
    })();

    function bindScrubElement(el) {
      el.addEventListener('mousedown', function(evt) {
        const intersection = evt.detail && evt.detail.intersection;
        // Marker click: jump to the marker's seconds and finish (no drag).
        if (el.classList.contains('vr-scrub-marker')) {
          const secs = parseFloat(el.dataset.markerSeconds);
          if (!isNaN(secs)) setVideoTime(secs, false);
          scrubActive = false;
          return;
        }
        scrubActive = true;
        if (intersection) {
          const t = cursorToScrubT(intersection);
          if (t !== null) setVideoTime(t, false);
        }
      });
      el.addEventListener('mouseup', function() { scrubActive = false; });
    }

    function bindMarkerTooltip(el) {
      el.addEventListener('raycaster-intersected', function() {
        markerTip.setAttribute('text', 'value', el.dataset.markerTitle || '');
        const pos = el.getAttribute('position');
        const x = (pos && typeof pos === 'object') ? pos.x : 0;
        markerTip.setAttribute('position', x.toFixed(3) + ' 0.10 0.01');
        markerTip.setAttribute('visible', 'true');
      });
      el.addEventListener('raycaster-intersected-cleared', function() {
        markerTip.setAttribute('visible', 'false');
      });
    }

    // Bind bar+thumb at script-start (they exist in the static markup).
    document.querySelectorAll('.vr-scrub, .vr-scrub-bg').forEach(bindScrubElement);

    function buildSceneMarkerDots() {
      const root = document.getElementById('vrScrubMarkers');
      if (!root) return;
      while (root.firstChild) root.removeChild(root.firstChild);
      if (!sceneDurationSec || !sceneMarkers || !sceneMarkers.length) return;
      sceneMarkers.forEach(m => {
        const x = tForMarkerX(m.seconds);
        const dot = document.createElement('a-entity');
        dot.classList.add('vr-btn', 'vr-scrub-marker');
        dot.setAttribute('data-marker-seconds', m.seconds);
        dot.setAttribute('data-marker-title', m.title || '');
        dot.setAttribute('geometry', 'primitive:circle;radius:0.03');
        dot.setAttribute('material', 'color:#f7b500;opacity:0.95');
        dot.setAttribute('position', x.toFixed(3) + ' 0 ' + SCRUB_MARKER_Z.toFixed(3));
        projectScrubChild(dot, x, SCRUB_MARKER_Z);
        root.appendChild(dot);
        bindScrubElement(dot);
        bindMarkerTooltip(dot);
      });
    }
    scene.addEventListener('loaded', buildSceneMarkerDots);

    // M4c Task 8 Step 4: refresh M4b state for the newly-loaded scene.
    // Declared here (above swapToScene's definition) so swapToScene can
    // close over the binding and call it after the new <video>'s canplay.
    let refreshSceneMeta = async function(id) {
      if (!id) return;
      let meta = null;
      try {
        const resp = await fetch('/browse/scene/' + encodeURIComponent(id) + '/meta', {
          headers: { 'Accept': 'application/json' }
        });
        if (!resp.ok) {
          console.warn('stash-vr: /meta returned', resp.status);
          return;
        }
        meta = await resp.json();
      } catch (e) {
        console.warn('stash-vr: /meta fetch failed', e);
        return;
      }
      if (!meta) return;

      // Title — applied here in addition to the optimistic tile-snapshot
      // update in swapToScene; the server-side title may differ from the
      // tile's text (truncation, decoration, etc.).
      if (meta.title) setPlaybackTitle(meta.title);

      // Duration — used by tickScrubBar / tForMarkerX as a fallback while
      // video.duration is still NaN. Once the new video reports duration,
      // it takes over.
      if (typeof meta.durationSec === 'number') {
        sceneDurationSec = meta.durationSec;
      }

      // Scene markers — replace contents in place (sceneMarkers is a
      // const reference held by tForMarkerX / buildSceneMarkerDots).
      sceneMarkers.length = 0;
      if (Array.isArray(meta.sceneMarkers)) {
        Array.prototype.push.apply(sceneMarkers, meta.sceneMarkers);
      }
      buildSceneMarkerDots();

      // Captions — reset playback state, swap captionsData in place,
      // rebuild the picker buttons, toggle the CC button.
      currentCues = [];
      currentLang = '';
      const subtitlePlane = document.getElementById('vrSubtitlePlane');
      if (subtitlePlane) subtitlePlane.setAttribute('visible', false);
      captionsData.length = 0;
      if (Array.isArray(meta.captions)) {
        Array.prototype.push.apply(captionsData, meta.captions);
      }
      renderSubtitlePicker();
      const ccBtn = document.getElementById('vrCCBtn');
      if (ccBtn) ccBtn.setAttribute('visible', captionsData.length > 0);
      // Picker just rebuilt its buttons → refresh raycaster targets so
      // the new <a-entity>s under vrSubtitlePickerButtons are pickable.
      if (typeof updateRaycasterTargets === 'function') updateRaycasterTargets();
    };

    // Drag sampling happens in tickScrubBar() inside the panel-tickers
    // component. Keep the cleared listener so a laser that leaves all targets mid-drag ends
    // the scrub cleanly (mouseup may fire on nothing).
    ['vrLaserRight', 'vrLaserLeft'].forEach(id => {
      const laser = document.getElementById(id);
      if (!laser) return;
      laser.addEventListener('raycaster-intersection-cleared', function() {
        scrubActive = false;
      });
    });

    // Backstop: any mouseup ends the scrub drag.
    scene.addEventListener('mouseup', function() { scrubActive = false; });

    // ============================================================
    // Picker state + handlers.
    //
    // Initial state derived from the server-rendered Projection
    // (read off <a-scene>'s data-stereo, vrFisheye's data-fov, and
    // the visibility of the four render entities). The user picks
    // one button per row; on every tap we (a) re-bind the renderer
    // locally, (b) POST the new selection so Stash tags update,
    // (c) update the active-highlight per row.
    // ============================================================

    // M4c Task 8: mutable so seamless scene swap can retarget projection
    // POSTs and caption fetches at the newly-loaded scene.
    let sceneId = (function() {
      const m = location.pathname.match(/\/browse\/scene\/([^\/]+)/);
      return m ? m[1] : '';
    })();
    const pickerState = computeInitialPickerState();

    // computeInitialPickerState reads the server-rendered Projection
    // straight off <a-scene>'s data-* attrs. Reading entity `visible`
    // here would be wrong: at script-execution time A-Frame hasn't
    // parsed it yet, so getAttribute returns the raw HTML string
    // ("true"/"false") — both truthy in JS — which makes every
    // condition fire on the first branch.
    function computeInitialPickerState() {
      const stereoAttr = scene.dataset.stereo || '';
      const geom       = scene.dataset.geometry || '';
      const fov        = parseFloat(scene.dataset.fov || '0');
      let type = 'Normal', degree = '180', stereo = 'SBS';
      if (geom === '') {
        type = 'Normal'; degree = 'Cinema'; stereo = '2D';
      } else if (geom === 'fisheye') {
        type = 'FishEye';
        degree = (fov >= 200 ? '200' : '180');
      } else if (geom === 'equirectangular' && fov === 360) {
        type = 'Normal'; degree = '360';
      } else if (geom === 'equirectangular') {
        type = 'Normal'; degree = '180';
      }
      if (degree === 'Cinema') {
        stereo = '2D';
      } else if (stereoAttr === 'sbs') {
        stereo = 'SBS';
      } else if (stereoAttr === 'tb') {
        stereo = 'TB';
      } else {
        stereo = '2D';
      }
      return { type, degree, stereo, initial: null };
    }
    pickerState.initial = { type: pickerState.type, degree: pickerState.degree, stereo: pickerState.stereo };

    // Pure derivation of the active geometry entity id from the
    // pickerState — no side effects. Used both at startup (to seed
    // scene.dataset.activeGeom for the M5 layer manager) and inside
    // applyPickerState. Distinct from scene.dataset.geometry, which
    // holds Stash's Projection.Geometry string ('equirectangular' /
    // 'fisheye' / ''), not a DOM entity id.
    function pickerStateToActiveId(state) {
      if (state.degree === 'Cinema') return 'vrFlat';
      if (state.type === 'FishEye')  return 'vrFisheye';
      if (state.degree === '360')    return 'vrSphere360';
      return 'vrSphere180';
    }
    scene.dataset.activeGeom = pickerStateToActiveId(pickerState);

    // Apply current pickerState: update data attrs, toggle entity
    // visibility, reset boundVR flags so applyAll rebinds, then
    // recompute the per-row highlights and disabled state.
    function applyPickerState() {
      const isFishEye = pickerState.type === 'FishEye';

      const stereoData = pickerState.stereo === 'SBS' ? 'sbs' :
                         pickerState.stereo === 'TB'  ? 'tb'  : '';
      scene.dataset.stereo = stereoData;

      const activeId = pickerStateToActiveId(pickerState);
      if (isFishEye) {
        const fovEl = document.getElementById('vrFisheye');
        if (fovEl) fovEl.dataset.fov = (pickerState.degree === '200' ? '200' : '180');
        if (fovEl) fovEl.dataset.cant = '0'; // user-picked fisheye is plain fisheye
      }
      scene.dataset.activeGeom = activeId;

      ['vrSphere180', 'vrSphere360', 'vrFisheye', 'vrFlat'].forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        el.setAttribute('visible', id === activeId);
        // Reset bind flag so applyAll re-creates the material with
        // the right offsets (sphere) or re-creates the shader
        // (fisheye) for the new geometry/fov.
        const mesh = el.getObject3D('mesh');
        if (mesh) mesh.userData.boundVR = false;
      });
      applyAll();

      updatePickerHighlights();
      updatePickerDisabled();

      // Notify the XR media-layer manager so it can swap to the
      // matching cached layer. No-op until the manager has activated
      // after enter-vr (or if WebXR Layers aren't supported).
      if (window.syncMediaLayer) window.syncMediaLayer();
    }

    function updatePickerHighlights() {
      document.querySelectorAll('.picker-btn').forEach(b => {
        const row = b.dataset.pickRow;
        const value = b.dataset.pickValue;
        const isActive = (row !== 'auto' && pickerState[row] === value);
        b.setAttribute('material', 'color: ' + (isActive ? '#3776c2' : '#2c5282') + '; opacity: 0.95');
      });
    }

    function isInvalidCombo(row, value) {
      // Cinema is only valid with Type=Normal.
      if (row === 'degree' && value === 'Cinema' && pickerState.type === 'FishEye') return true;
      // 200 is only valid with Type=FishEye.
      if (row === 'degree' && value === '200' && pickerState.type === 'Normal') return true;
      // 360 is only valid with Type=Normal.
      if (row === 'degree' && value === '360' && pickerState.type === 'FishEye') return true;
      // When degree is Cinema, all stereo other than 2D is moot but not "invalid" per se
      // — leave them tappable; tapping a Stereo button while Cinema doesn't change render
      // (Cinema forces 2D in applyPickerState). No styling change for these.
      return false;
    }

    function updatePickerDisabled() {
      document.querySelectorAll('.picker-btn').forEach(b => {
        const row = b.dataset.pickRow;
        const value = b.dataset.pickValue;
        if (row === 'auto') return;
        const disabled = isInvalidCombo(row, value);
        if (disabled) {
          b.setAttribute('material', 'color: #444; opacity: 0.4');
          b.dataset.disabled = '1';
        } else {
          delete b.dataset.disabled;
          // Active-highlight setter in updatePickerHighlights will
          // set the right color; this branch only ensures non-disabled
          // buttons aren't stuck at the disabled color.
        }
      });
    }

    // Single in-flight lock for POST. Rapid taps coalesce — the latest
    // pickerState wins; intermediate POSTs that haven't started yet
    // are skipped.
    let postInFlight = false;
    let postPending  = null;
    function postProjection(body) {
      postPending = body;
      if (postInFlight) return;
      const send = () => {
        const next = postPending;
        if (!next) { postInFlight = false; return; }
        postPending = null;
        postInFlight = true;
        fetch('/browse/scene/' + encodeURIComponent(sceneId) + '/projection', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(next)
        }).then(resp => {
          if (!resp.ok) console.warn('stash-vr: projection POST returned', resp.status);
        }).catch(err => {
          console.warn('stash-vr: projection POST failed', err);
        }).finally(() => {
          postInFlight = false;
          if (postPending) send();
        });
      };
      send();
    }

    function handlePickerTap(row, value) {
      // Auto: revert pickerState to initial, re-apply, POST {auto:true}.
      if (row === 'auto') {
        pickerState.type   = pickerState.initial.type;
        pickerState.degree = pickerState.initial.degree;
        pickerState.stereo = pickerState.initial.stereo;
        applyPickerState();
        postProjection({ auto: true });
        return;
      }
      // Disabled buttons no-op.
      const btnEl = document.querySelector('.picker-btn[data-pick-row="' + row + '"][data-pick-value="' + value + '"]');
      if (btnEl && btnEl.dataset.disabled === '1') return;
      // Update state.
      pickerState[row] = value;
      // Picking Type may invalidate current Degree — auto-correct to a
      // valid neighbor so the resulting Projection is renderable.
      if (row === 'type') {
        if (value === 'FishEye' && (pickerState.degree === 'Cinema' || pickerState.degree === '360')) {
          pickerState.degree = '180';
        }
        if (value === 'Normal' && pickerState.degree === '200') {
          pickerState.degree = '180';
        }
      }
      applyPickerState();
      postProjection({
        type:   pickerState.type,
        degree: pickerState.degree,
        stereo: pickerState.stereo
      });
    }

    // Initial highlight + disabled-state pass once A-Frame is ready.
    scene.addEventListener('loaded', function() {
      updatePickerHighlights();
      updatePickerDisabled();
    });

    // ============================================================
    // M4c Task 8: Seamless scene swap
    //
    // Click a browse tile → cross-fade the audio + visual to black,
    // swap the <video> src + projection, fade back. The XRSession
    // stays alive throughout — no exit/re-enter VR transition. The
    // fade overlay (vrFadeOverlay) is reparented to the camera on
    // first swap so the black plane travels with the headset.
    // ============================================================

    let swapInFlight = false;

    // Fade helpers step on setTimeout, NOT requestAnimationFrame. WebXR
    // immersive sessions pause window.requestAnimationFrame on Quest /
    // Meta Browser — the browser drives frames from XRSession.
    // requestAnimationFrame instead, leaving raw rAF callbacks queued
    // forever. Earlier the fade hung at first step (opacity ~0.0005) and
    // swapInFlight stayed true, blocking every subsequent click.
    // setTimeout fires regardless of XR state. ~30Hz is fine for a 200ms
    // crossfade — we don't need per-frame precision.
    const FADE_STEP_MS = 33;

    function fadeAudio(target, durMs) {
      return new Promise(resolve => {
        const start = video.volume;
        const t0 = performance.now();
        function step() {
          const elapsed = performance.now() - t0;
          const k = Math.min(1, elapsed / durMs);
          video.volume = start + (target - start) * k;
          if (k < 1) setTimeout(step, FADE_STEP_MS);
          else resolve();
        }
        step();
      });
    }

    function fadeVisual(target, durMs) {
      return new Promise(resolve => {
        const plane = document.getElementById('vrFadePlane');
        if (!plane) { resolve(); return; }
        // Read opacity off the live three.js material if available — A-Frame's
        // material attribute string round-trips lossily for animated values.
        const mesh = plane.getObject3D && plane.getObject3D('mesh');
        const startOp = (mesh && mesh.material) ? mesh.material.opacity : 0;
        const t0 = performance.now();
        function step() {
          const elapsed = performance.now() - t0;
          const k = Math.min(1, elapsed / durMs);
          const op = startOp + (target - startOp) * k;
          if (mesh && mesh.material) {
            mesh.material.opacity = op;
            mesh.material.needsUpdate = true;
          } else {
            plane.setAttribute('material', 'opacity:' + op + ';transparent:true;shader:flat;color:#000');
          }
          if (k < 1) setTimeout(step, FADE_STEP_MS);
          else resolve();
        }
        step();
      });
    }

    function reparentFadeToCamera() {
      const fade = document.getElementById('vrFadeOverlay');
      if (!fade || !fade.object3D || !scene.camera) return;
      if (fade.object3D.parent !== scene.camera) {
        if (fade.object3D.parent) fade.object3D.parent.remove(fade.object3D);
        scene.camera.add(fade.object3D);
        fade.object3D.position.set(0, 0, 0);
      }
    }

    // Map a tile's Projection JSON {Geometry, FOV, Stereo, Cant} into
    // pickerState's UI vocabulary so applyPickerState can do the rebind
    // through the same path as a manual Format-picker tap.
    function projectionToPickerState(p) {
      const out = { type: 'Normal', degree: '180', stereo: '2D' };
      const geom = p.Geometry || '';
      const fov  = p.FOV || 0;
      const ster = (p.Stereo || '').toLowerCase();
      if (geom === '') {
        out.type = 'Normal'; out.degree = 'Cinema'; out.stereo = '2D';
      } else if (geom === 'fisheye') {
        out.type = 'FishEye';
        out.degree = (fov >= 200) ? '200' : '180';
      } else if (geom === 'equirectangular' && fov === 360) {
        out.type = 'Normal'; out.degree = '360';
      } else if (geom === 'equirectangular') {
        out.type = 'Normal'; out.degree = '180';
      }
      if (out.degree !== 'Cinema') {
        if      (ster === 'sbs') out.stereo = 'SBS';
        else if (ster === 'tb')  out.stereo = 'TB';
        else                     out.stereo = '2D';
      }
      return out;
    }

    async function swapToScene(tileEl) {
      if (swapInFlight) return;
      swapInFlight = true;

      // Each step is independently try/caught so a failure mid-swap
      // (bad projection JSON, applyPickerState throwing, /meta down,
      // etc.) doesn't strand the user with a black fade overlay and a
      // half-loaded scene. The finally block ALWAYS fades back in and
      // hides the browse panel, even after partial failure.
      const newSceneId = (tileEl && tileEl.dataset && tileEl.dataset.sceneId) || '';
      const newStreamUrl = (tileEl && tileEl.dataset && tileEl.dataset.streamUrl) || '';
      let proj = {};
      try { proj = JSON.parse((tileEl && tileEl.dataset && tileEl.dataset.projection) || '{}'); } catch (_) {}

      try {
        try { reparentFadeToCamera(); } catch (e) { console.warn('stash-vr: reparentFade', e); }

        await Promise.all([fadeAudio(0, 200), fadeVisual(1, 200)])
          .catch(e => console.warn('stash-vr: fadeOut', e));

        // Swap video source.
        try {
          video.pause();
          if (newStreamUrl) {
            video.src = newStreamUrl;
            video.load();
          }
        } catch (e) { console.warn('stash-vr: video src swap', e); }

        // Project rebind. Update scene + vrFisheye data attrs, then
        // route through applyPickerState so the visibility flip /
        // boundVR reset / applyAll path matches a manual Format pick.
        try {
          // Cached XR layers reference the previous scene's <video>
          // state; reusing them across a src swap crashes the Quest 3
          // compositor. Drop the cache so applyPickerState's call to
          // syncMediaLayer creates fresh layers against the new video.
          if (window.invalidateMediaLayerCache) window.invalidateMediaLayerCache();
          scene.dataset.geometry = proj.Geometry || '';
          scene.dataset.fov      = String(proj.FOV || '');
          scene.dataset.stereo   = (proj.Stereo || '').toLowerCase();
          const ps = projectionToPickerState(proj);
          pickerState.type    = ps.type;
          pickerState.degree  = ps.degree;
          pickerState.stereo  = ps.stereo;
          pickerState.initial = { type: ps.type, degree: ps.degree, stereo: ps.stereo };
          applyPickerState();
          // applyPickerState clobbers vrFisheye's data-cant to '0'
          // (it always treats picker-driven fisheye as plain). Restore
          // the tile's cant after, so RF52 scenes keep their canting
          // through a swap.
          const fovEl = document.getElementById('vrFisheye');
          if (fovEl) {
            fovEl.dataset.fov  = String(proj.FOV || 180);
            fovEl.dataset.cant = String(proj.Cant || 0);
          }
        } catch (e) { console.warn('stash-vr: projection rebind', e); }

        try { resetGeometry(); } catch (e) { console.warn('stash-vr: resetGeometry', e); }

        // Retarget all subsequent /scene/{id}/* requests at the new id.
        if (newSceneId) sceneId = newSceneId;

        // Wait for the new video to be ready, with a 5s safety timeout.
        await new Promise(resolve => {
          let done = false;
          const finish = () => { if (done) return; done = true; video.removeEventListener('canplay', onCanPlay); resolve(); };
          const onCanPlay = () => finish();
          video.addEventListener('canplay', onCanPlay);
          setTimeout(finish, 5000);
        });

        try { await video.play(); } catch (e) { console.warn('stash-vr: post-swap play', e); }

        // Refresh M4b state from the new scene's metadata.
        try { await refreshSceneMeta(sceneId); } catch (e) { console.warn('stash-vr: refreshSceneMeta', e); }
      } finally {
        // Always fade back in + hide browse panel + clear in-flight,
        // so a mid-swap exception can't leave the user staring at a
        // black overlay with the browse panel still up.
        await Promise.all([fadeAudio(1, 200), fadeVisual(0, 200)])
          .catch(e => console.warn('stash-vr: fadeIn', e));

        // setSubpanelVisible also rebuilds the raycaster targets so
        // hidden tiles don't keep intercepting clicks.
        try {
          setSubpanelVisible('vrBrowsePanel', false);
        } catch (e) { console.warn('stash-vr: hide browse panel', e); }

        // Optimistic title update from the tile snapshot. refreshSceneMeta
        // overwrites this with the canonical server title if it succeeded.
        try {
          const newTitle = (tileEl && tileEl.dataset && tileEl.dataset.tileTitle) || '';
          if (newTitle) setPlaybackTitle(newTitle);
        } catch (e) { console.warn('stash-vr: title update', e); }

        swapInFlight = false;
      }
    }

    // refreshSceneMeta is declared earlier in the IIFE (alongside
    // buildSceneMarkerDots / renderSubtitlePicker, which it calls) so
    // its implementation has those helpers in scope. swapToScene's body
    // only awaits it on user-triggered click events, by which point the
    // let binding has been initialized.

    // Delegated click handler for tile interactions. Tiles are created
    // dynamically by relayoutTiles, so a single delegate on vrBrowseTiles
    // catches every cover/badge tap without needing per-tile binding.
    (function wireTileClicks() {
      const tilesRoot = document.getElementById('vrBrowseTiles');
      if (!tilesRoot) return;
      tilesRoot.addEventListener('click', function(evt) {
        const tileEl = evt.target && evt.target.closest && evt.target.closest('.vr-tile');
        if (!tileEl) return;
        if (!isBrowseGridIntersectionWithinBand(evt.detail && evt.detail.intersection)) return;
        if (evt.target.closest('.vr-tile-detail')) {
          if (typeof window.openDetailPanel === 'function') {
            window.openDetailPanel(tileEl.dataset.sceneId);
          }
          return;
        }
        if (!evt.target.closest('.vr-tile-cover')) return;
        swapToScene(tileEl);
      });
    })();

    function show2D() {
      scene.style.display = 'none';
      [...wrap.children].forEach(el => {
        if (el !== scene) el.style.display = '';
      });
    }
    function hide2D() {
      applyAll();
      [...wrap.children].forEach(el => {
        if (el !== scene && el !== video) el.style.display = 'none';
      });
      scene.style.display = '';
    }

    btn.addEventListener('click', () => {
      hide2D();
      // The click is a user gesture, so unmuted-with-sound playback is
      // permitted from here. play() is a no-op if already playing.
      const playPromise = video.play();
      if (playPromise && playPromise.catch) {
        playPromise.catch(err => console.warn('stash-vr: video play failed', err));
      }
      if (typeof scene.enterVR !== 'function') {
        console.warn('stash-vr: a-scene not ready');
        show2D();
        return;
      }
      scene.enterVR().catch(err => {
        console.warn('stash-vr: enterVR failed', err);
        show2D();
      });
    });
    scene.addEventListener('exit-vr', show2D);

    // Register the per-frame ticker component now that all four tick*
    // function declarations above are in scope (they're hoisted, but
    // attaching the component after the rest of setup runs keeps the
    // boot order obvious). Attaching to <a-scene> means tick() fires on
    // every render frame — including XR frames, unlike window.rAF which
    // is paused while an XRSession is presenting.
    if (typeof AFRAME !== 'undefined') {
      AFRAME.registerComponent('panel-tickers', {
        tick: function() {
          const now = performance.now();
          try { tickTimeDisplay(now); } catch (e) { console.warn('stash-vr: tickTimeDisplay', e); }
          try { tickSliders(); }       catch (e) { console.warn('stash-vr: tickSliders', e); }
          try { tickScrubBar(); }      catch (e) { console.warn('stash-vr: tickScrubBar', e); }
          try { tickSubtitles(); }     catch (e) { console.warn('stash-vr: tickSubtitles', e); }
        }
      });
      scene.setAttribute('panel-tickers', '');
    }


    // ============================================================
    // XR media-layer manager. Owns the WebXR Layers media layer
    // bound to <video> for sphere180 / sphere360 / cinema modes.
    // Active when:
    //   - XRMediaBinding is defined globally
    //   - The session has 'layers' in enabledFeatures
    //   - renderState.layers is populated (Three.js's WebXRManager
    //     creates the projection layer asynchronously after A-Frame's
    //     enter-vr event, so we poll for up to 2s)
    //
    // When active, hides the corresponding geometry entity so the
    // video isn't double-rendered. Fisheye has no native layer type
    // and keeps its shader path; the manager goes idle for that mode.
    //
    // Quest 3's compositor leaks allocations across destroy + create
    // cycles (toggle lag accumulates after ~7 swaps even at normal
    // pace). To avoid that, layers are cached per (geomId, stereo)
    // combo and reused; only updateRenderState swaps which one is
    // active. At most ~6 layers held simultaneously (3 stereos × 2
    // sphere modes + 1 cinema), all sharing the same <video>.
    //
    // Exposes window.syncMediaLayer so applyPickerState can notify
    // the manager when geometry / stereo changes.
    // ============================================================
    (function () {
      let activeMediaLayer = null;
      let suppressedGeomId = null;
      let mediaBinding     = null;
      let refSpace         = null;
      let supported        = false;
      const layerCache = new Map(); // 'geomId:stereo' -> XRLayer
      // Set of every media layer we've ever created (alive + destroyed).
      // Used to filter media vs projection layers in renderState even
      // across cache invalidations: destroyed layers can linger in
      // renderState.layers for one frame until updateRenderState applies.
      const knownMediaLayers = new Set();

      function getXRSession() {
        const xr = scene.renderer && scene.renderer.xr;
        if (!xr) return null;
        try { return xr.getSession() || null; } catch (_) { return null; }
      }

      function buildOrGetLayer() {
        if (!mediaBinding || !refSpace) return null;
        const stereo = scene.dataset.stereo || '';
        const geomId = scene.dataset.activeGeom || 'vrFlat';
        if (geomId === 'vrFisheye') return null;
        const key = geomId + ':' + (stereo || 'mono');
        const cached = layerCache.get(key);
        if (cached) return cached;
        const layout = stereo === 'sbs' ? 'stereo-left-right' :
                       stereo === 'tb'  ? 'stereo-top-bottom' :
                       'mono';
        let layer = null;
        if (geomId === 'vrSphere180') {
          layer = mediaBinding.createEquirectLayer(video, {
            space: refSpace,
            layout: layout,
            centralHorizontalAngle: Math.PI,
            upperVerticalAngle: Math.PI / 2,
            lowerVerticalAngle: -Math.PI / 2,
            radius: 0
          });
        } else if (geomId === 'vrSphere360') {
          layer = mediaBinding.createEquirectLayer(video, {
            space: refSpace,
            layout: layout,
            centralHorizontalAngle: 2 * Math.PI,
            upperVerticalAngle: Math.PI / 2,
            lowerVerticalAngle: -Math.PI / 2,
            radius: 0
          });
        } else if (geomId === 'vrFlat') {
          layer = mediaBinding.createQuadLayer(video, {
            space: refSpace,
            layout: layout,
            width: 4.0,
            height: 2.25,
            transform: new XRRigidTransform({ x: 0, y: 1.6, z: -3 })
          });
        }
        if (layer) {
          layerCache.set(key, layer);
          knownMediaLayers.add(layer);
        }
        return layer;
      }

      // Destroy all currently-cached layers, remove them from
      // renderState.layers, and restore the previously-suppressed
      // entity. Called on exit-vr and on scene swap (where cached
      // layers reference the old video state and would crash the
      // compositor if reused).
      function dropCache() {
        const session = getXRSession();
        layerCache.forEach(function(layer) {
          try { layer.destroy(); } catch (_) {}
          // Keep in knownMediaLayers so syncLayer's filter still
          // recognises the (now-destroyed) layer if renderState
          // hasn't flushed yet.
        });
        layerCache.clear();
        activeMediaLayer = null;
        if (session) {
          const existing = Array.from(session.renderState.layers || []);
          const nonMedia = existing.filter(function(l) { return !knownMediaLayers.has(l); });
          if (nonMedia.length !== existing.length) {
            try { session.updateRenderState({ layers: nonMedia }); }
            catch (err) { console.warn('media-layer: dropCache updateRenderState failed', err); }
          }
        }
        if (suppressedGeomId) {
          const el = document.getElementById(suppressedGeomId);
          if (el) el.setAttribute('visible', 'true');
          suppressedGeomId = null;
        }
      }
      // Expose for swapToScene to call before applyPickerState on
      // scene swap (the new <video> content needs fresh XR layers).
      window.invalidateMediaLayerCache = dropCache;

      function syncLayer() {
        if (!supported) return;
        const xrSession = getXRSession();
        if (!xrSession) return;
        const newLayer = buildOrGetLayer();
        const existing = Array.from((xrSession.renderState && xrSession.renderState.layers) || []);
        // Drop any media layer from renderState — we'll re-add only
        // the one we want active (or none for fisheye). Filter against
        // knownMediaLayers, not layerCache, so a recently-destroyed
        // layer (after a scene-swap invalidation) is still recognised
        // until updateRenderState applies.
        const nonMedia = existing.filter(function(l) { return !knownMediaLayers.has(l); });
        const merged = newLayer ? [newLayer].concat(nonMedia) : nonMedia;
        try {
          xrSession.updateRenderState({ layers: merged });
        } catch (err) {
          console.warn('media-layer: updateRenderState failed', err);
          return;
        }
        activeMediaLayer = newLayer;
        if (newLayer) {
          const geomId = scene.dataset.activeGeom || 'vrFlat';
          const el = document.getElementById(geomId);
          if (el) {
            el.setAttribute('visible', 'false');
            suppressedGeomId = geomId;
          }
        } else {
          suppressedGeomId = null;
        }
      }
      window.syncMediaLayer = syncLayer;

      // Unified poll for: session attached, 'layers' feature granted,
      // and renderState.layers populated. A-Frame's enter-vr can fire
      // before Three.js's WebXRManager finishes setting up the session
      // OR populating the projection layer, so we poll for up to 2s
      // rather than read-once and silently bail.
      function activateOnceReady() {
        if (typeof XRMediaBinding === 'undefined') {
          console.log('media-layer: XRMediaBinding unavailable; staying on VideoTexture path');
          return;
        }
        const deadline = Date.now() + 2000;
        function tick() {
          const session = getXRSession();
          if (!session) {
            if (Date.now() < deadline) { requestAnimationFrame(tick); return; }
            console.log('media-layer: no session by deadline; staying on VideoTexture path');
            return;
          }
          const ef = session.enabledFeatures ? Array.from(session.enabledFeatures) : [];
          if (!ef.includes('layers')) {
            console.log('media-layer: layers feature not granted; staying on VideoTexture path');
            return;
          }
          const layersArr = session.renderState && session.renderState.layers;
          if (!layersArr || !layersArr.length) {
            if (Date.now() < deadline) { requestAnimationFrame(tick); return; }
            console.log('media-layer: renderState.layers stayed empty after 2s; staying on VideoTexture path');
            return;
          }
          try {
            const xr = scene.renderer.xr;
            mediaBinding = new XRMediaBinding(session);
            refSpace = xr.getReferenceSpace();
            supported = true;
            // The projection layer carries the HUD; make its clear
            // color transparent so the media layer behind it shows
            // through anywhere the HUD doesn't draw. Requires
            // <a-scene renderer="alpha: true"> so the layer has an
            // alpha buffer.
            try { scene.renderer.setClearColor(0x000000, 0); } catch (_) {}
            syncLayer();
            console.log('media-layer: active');
          } catch (err) {
            console.warn('media-layer: setup failed', err);
            mediaBinding = null;
            refSpace = null;
            supported = false;
          }
        }
        tick();
      }
      scene.addEventListener('enter-vr', activateOnceReady);

      scene.addEventListener('exit-vr', function() {
        dropCache();
        mediaBinding = null;
        refSpace = null;
        supported = false;
      });
    })();
  })();
</script>
{{end}}
<h1>{{.Title}}</h1>
<div class="meta">
{{range .Performers}}<a class="chip chip-perf" href="/browse/perf/{{.ID}}">{{.Name}}</a>{{end}}
{{with .Studio}}<a class="chip chip-studio" href="/browse/studio/{{.ID}}">{{.Name}}</a>{{end}}
{{if .Date}}<span class="meta-text">{{.Date}}</span>{{end}}
{{if .Duration}}<span class="meta-text">{{.Duration}}</span>{{end}}
</div>

<div class="section">
<h2>Rating</h2>
<form method="post" action="/browse/scene/{{.ID}}/rating" class="js-mut stars">
<span class="stars-fill">
{{range $i, $_ := .StarSlice}}
{{- $star := sub 5 $i -}}
<button name="value" value="{{$star}}"{{if eq $star $.Rating1to5}} class="on"{{end}}>★</button>
{{end}}
</span>
{{if .Rating1to5}}<button name="value" value="0" class="clear" title="Clear rating">✕</button>{{end}}
</form>
</div>

<div class="section">
<h2>Favorite</h2>
<form method="post" action="/browse/scene/{{.ID}}/favorite" class="js-mut fav" style="display:inline-flex">
<button class="{{if .IsFavorite}}on{{end}}">♥ {{if .IsFavorite}}Favorited{{else}}Favorite{{end}}</button>
</form>
</div>

<div class="section">
<h2>Tags</h2>
<template id="tag-chip-tpl">
<span class="chip"><a></a><form method="post" class="js-mut" style="display:inline"><button name="tag">✕</button></form></span>
</template>
<div class="tags">
{{range .Tags}}
<span class="chip"><a href="/browse/tag/{{.ID}}">{{.Name}}</a><form method="post" action="/browse/scene/{{$.ID}}/tags/remove" class="js-mut" style="display:inline"><button name="tag" value="{{.Name}}">✕</button></form></span>
{{end}}
<form method="post" action="/browse/scene/{{.ID}}/tags/add" class="js-mut addtag">
<input list="all-tags" name="tag" placeholder="Add tag…" autocomplete="off">
<datalist id="all-tags">
{{range .AllTagNames}}<option value="{{.}}">{{end}}
</datalist>
<button>Add</button>
</form>
</div>
</div>

<div class="section">
<h2>O-Counter</h2>
<form method="post" action="/browse/scene/{{.ID}}/o/decrement" style="display:inline-flex" class="js-mut ocount">
<button>−</button>
</form>
<span id="ocount-value" style="display:inline-flex;align-items:center;padding:0 12px">{{.OCounter}}</span>
<form method="post" action="/browse/scene/{{.ID}}/o/increment" style="display:inline-flex" class="js-mut ocount">
<button>+</button>
</form>
</div>

<div class="section">
<h2>Organized</h2>
<form method="post" action="/browse/scene/{{.ID}}/organized" class="js-mut org" style="display:inline-flex">
<button class="{{if .Organized}}on{{end}}">{{if .Organized}}✓ Organized{{else}}Mark organized{{end}}</button>
</form>
</div>

</div>
<script>
(function() {
  const sceneId = (function() {
    const m = location.pathname.match(/\/browse\/scene\/([^\/]+)/);
    return m ? m[1] : '';
  })();
  if (!sceneId) return;

  const errBanner = document.getElementById('errbanner');
  let errTimer = null;
  function showErr(msg) {
    if (!errBanner) return;
    errBanner.textContent = msg;
    errBanner.hidden = false;
    if (errTimer) clearTimeout(errTimer);
    errTimer = setTimeout(() => { errBanner.hidden = true; errBanner.textContent = ''; }, 5000);
  }
  function clearErr() {
    if (!errBanner) return;
    errBanner.hidden = true;
    errBanner.textContent = '';
    if (errTimer) { clearTimeout(errTimer); errTimer = null; }
  }

  // Rebuild the chip list from state.tags. Preserves the add-tag form,
  // which sits as a sibling to the chip spans inside .tags.
  function renderTags(state) {
    const tagsRoot = document.querySelector('.tags');
    if (!tagsRoot) return;
    const tpl = document.getElementById('tag-chip-tpl');
    // Remove existing chip spans only (keep the addtag <form>).
    tagsRoot.querySelectorAll('span.chip').forEach(el => el.remove());
    const addForm = tagsRoot.querySelector('form.addtag');
    (state.tags || []).forEach(t => {
      const node = tpl.content.firstElementChild.cloneNode(true);
      const a = node.querySelector('a');
      a.href = '/browse/tag/' + encodeURIComponent(t.id);
      a.textContent = t.name;
      const form = node.querySelector('form');
      form.action = '/browse/scene/' + encodeURIComponent(sceneId) + '/tags/remove';
      const btn = form.querySelector('button[name="tag"]');
      btn.value = t.name;
      bindForm(form);
      tagsRoot.insertBefore(node, addForm);
    });
  }

  // Rating: clear all .on, set .on on the button matching state.rating1to5;
  // show/hide the ✕ clear button.
  function renderRating(state) {
    const form = document.querySelector('form.stars');
    if (!form) return;
    form.querySelectorAll('.stars-fill button').forEach(b => {
      b.classList.toggle('on', parseInt(b.value, 10) === state.rating1to5);
    });
    let clearBtn = form.querySelector('button.clear');
    if (state.rating1to5 > 0) {
      if (!clearBtn) {
        clearBtn = document.createElement('button');
        clearBtn.name = 'value';
        clearBtn.value = '0';
        clearBtn.className = 'clear';
        clearBtn.title = 'Clear rating';
        clearBtn.textContent = '✕';
        form.appendChild(clearBtn);
      }
    } else if (clearBtn) {
      clearBtn.remove();
    }
  }

  function renderFavorite(state) {
    const form = document.querySelector('form.fav');
    if (!form) return;
    const btn = form.querySelector('button');
    if (!btn) return;
    btn.classList.toggle('on', !!state.isFavorite);
    btn.textContent = state.isFavorite ? '♥ Favorited' : '♥ Favorite';
  }

  function renderOCounter(state) {
    const span = document.getElementById('ocount-value');
    if (span) span.textContent = state.oCounter;
  }

  function renderOrganized(state) {
    const form = document.querySelector('form.org');
    if (!form) return;
    const btn = form.querySelector('button');
    if (!btn) return;
    btn.classList.toggle('on', !!state.organized);
    btn.textContent = state.organized ? '✓ Organized' : 'Mark organized';
  }

  function applyState(state) {
    clearErr();
    if (state.err) { showErr(state.err); return; }
    renderRating(state);
    renderFavorite(state);
    renderTags(state);
    renderOCounter(state);
    renderOrganized(state);
  }

  function bindForm(form) {
    if (form._mutBound) return;
    form._mutBound = true;
    form.addEventListener('submit', function(ev) {
      ev.preventDefault();
      const submitBtn = ev.submitter;
      const fd = new FormData(form);
      // <button name="value" value="N"> in the rating form is not picked up
      // by FormData unless it's the submitter — guard for that:
      if (submitBtn && submitBtn.name && !fd.has(submitBtn.name)) {
        fd.set(submitBtn.name, submitBtn.value);
      }
      fetch(form.action, {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: fd
      }).then(r => r.json().then(j => ({ ok: r.ok, body: j })))
        .then(({ ok, body }) => {
          if (!ok) { showErr(body.err || 'request failed'); return; }
          applyState(body);
          // Clear the add-tag input on success.
          if (form.classList.contains('addtag')) {
            const input = form.querySelector('input[name="tag"]');
            if (input) input.value = '';
          }
        })
        .catch(err => showErr('network error: ' + err.message));
    });
  }

  document.querySelectorAll('form.js-mut').forEach(bindForm);
})();
</script>
</body>
</html>
